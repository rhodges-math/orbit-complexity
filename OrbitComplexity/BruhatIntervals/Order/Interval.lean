import OrbitComplexity.BruhatIntervals.Order.Basic
import Mathlib.Data.Set.Finite.Basic

/-!
# Bruhat intervals and reflection steps

Bruhat intervals are finite in every Coxeter group, including groups of infinite rank. The Bruhat
order may be generated by right reflection steps as well as left reflection steps.

## Main definitions

* `bruhatInterval`: the elements between two endpoints in Bruhat order.
* `RightBruhatStep`: a right reflection multiplication that increases length.

## Main results

* `bruhatInterval_finite`: every Bruhat interval is finite.
* `bruhatLE_iff_right_steps`: right reflection steps generate the Bruhat order.

## Implementation notes

Intervals use `CoxeterSystem.BruhatLE` directly, so no global order instance is needed.

## References

* A. Björner and F. Brenti, *Combinatorics of Coxeter Groups*, Springer GTM 231 (2005),
  Sections 2.1–2.2.
-/

namespace BruhatIntervals

variable {S W : Type*} [Group W] {M : CoxeterMatrix S} (cs : CoxeterSystem M W)

/-- The Bruhat interval between `u` and `v` consists of the elements `w` with `u ≤ w ≤ v`. -/
def bruhatInterval (u v : W) : Set W := {w | cs.BruhatLE u w ∧ cs.BruhatLE w v}

/-- Membership in a Bruhat interval is comparison with both endpoints. -/
theorem mem_bruhatInterval {u v w : W} :
    w ∈ bruhatInterval cs u v ↔ cs.BruhatLE u w ∧ cs.BruhatLE w v := Iff.rfl

/-- Every Bruhat interval is finite, since its elements are products of subwords of a fixed
reduced word for the upper endpoint. -/
theorem bruhatInterval_finite (u v : W) : (bruhatInterval cs u v).Finite := by
  obtain ⟨word, _, hword⟩ := cs.exists_isReduced v
  refine (List.finite_toSet (word.sublists.map cs.wordProd)).subset ?_
  intro w hw
  obtain ⟨subword, hsub, hprod⟩ := hw.2.exists_sublist_wordProd_eq word hword.symm
  exact List.mem_map.mpr ⟨subword, List.mem_sublists.mpr hsub, hprod⟩

/-- A right reflection step multiplies by a reflection and increases the Coxeter length. -/
def RightBruhatStep (u v : W) : Prop :=
  ∃ t : W, cs.IsReflection t ∧ v = u * t ∧ cs.length u < cs.length v

/-- Right and left reflection multiplications give the same directed Bruhat edges. -/
theorem rightBruhatStep_iff {u v : W} : RightBruhatStep cs u v ↔ cs.BruhatStep u v := by
  constructor
  · rintro ⟨t, ht, rfl, hlt⟩
    refine ⟨u * t * u⁻¹, ht.conj u, ?_, hlt⟩
    group
  · rintro ⟨t, ht, rfl, hlt⟩
    refine ⟨u⁻¹ * t * u, by simpa using ht.conj u⁻¹, ?_, hlt⟩
    group

/-- The Bruhat order is generated by right reflection steps that increase length. -/
theorem bruhatLE_iff_right_steps {u v : W} :
    cs.BruhatLE u v ↔ Relation.ReflTransGen (RightBruhatStep cs) u v :=
  ⟨Relation.ReflTransGen.mono (fun a b h => (rightBruhatStep_iff cs (u := a) (v := b)).mpr h) u v,
    Relation.ReflTransGen.mono (fun a b h => (rightBruhatStep_iff cs (u := a) (v := b)).mp h) u v⟩

end BruhatIntervals
