import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Cocycle
import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Length
import Mathlib.Algebra.Group.Subgroup.Map

/-!
# Canonical reflections of subgroups

A subgroup's canonical reflections are its reflections whose only subgroup reflection inversion
is themselves. Their construction uses the ambient inversion cocycle and induction on ambient
reflection length, and applies to arbitrary subgroups and arbitrary Coxeter systems.

## Main results

* `canonical_conjugate`: conjugation by an outside simple reflection transports canonical sets.
* `canonical_reflection_conj`: every subgroup reflection is conjugate to a canonical reflection
  by an element generated by the canonical set.
* `canonical_closure`: canonical reflections generate the same subgroup as all subgroup
  reflections.

## References

* M. Dyer, *Reflection Subgroups of Coxeter Systems*, Journal of Algebra 135 (1990),
  Sections 2 and 3.
-/

namespace BruhatIntervals

variable {Index W : Type*} [Group W] {matrix : CoxeterMatrix Index}
  (cs : CoxeterSystem matrix W)

/-- A subgroup's canonical reflections have exactly themselves as subgroup inversions. -/
def canonicalReflections (H : Subgroup W) : Set W :=
  {t | cs.IsReflection t ∧ {r | cs.IsLeftInversion t r ∧ r ∈ H} = {t}}

private theorem leftInv_simple (i : Index) (r : W) :
    cs.IsLeftInversion (cs.simple i) r ↔ r = cs.simple i := by
  constructor
  · intro h
    have hz : cs.length (r * cs.simple i) = 0 := by
      have := h.2
      rw [cs.length_simple] at this
      omega
    have heq := cs.length_eq_zero_iff.mp hz
    have := congrArg (· * cs.simple i) heq
    simpa only [cs.simple_mul_simple_cancel_right, one_mul] using this
  · rintro rfl
    exact ⟨cs.isReflection_simple i, by simp only [cs.simple_mul_simple_self,
      cs.length_one, cs.length_simple, Nat.zero_lt_succ]⟩

/-- Every canonical reflection belongs to its subgroup. -/
theorem canonical_mem {H : Subgroup W} {t : W}
    (ht : t ∈ canonicalReflections cs H) : t ∈ H := by
  have hself : t ∈ {r | cs.IsLeftInversion t r ∧ r ∈ H} := by
    rw [ht.2]
    exact Set.mem_singleton t
  exact hself.2

/-- An ambient simple reflection is canonical exactly when it belongs to the subgroup. -/
theorem canonical_simple (H : Subgroup W) (i : Index) :
    cs.simple i ∈ canonicalReflections cs H ↔ cs.simple i ∈ H := by
  constructor
  · exact canonical_mem cs
  · intro hi
    refine ⟨cs.isReflection_simple i, ?_⟩
    ext r
    simp only [Set.mem_ofPred_eq, leftInv_simple, Set.mem_singleton_iff]
    constructor
    · exact And.left
    · intro h
      exact ⟨h, h ▸ hi⟩

private def conjugate (i : Index) (H : Subgroup W) : Subgroup W :=
  H.map (MulAut.conj (cs.simple i)).toMonoidHom

private theorem mem_conjugate (i : Index) (H : Subgroup W) (r : W) :
    r ∈ conjugate cs i H ↔ cs.simple i * r * cs.simple i ∈ H := by
  rw [conjugate, Subgroup.mem_map_equiv, MulAut.conj_symm_apply, cs.inv_simple]

private theorem conjugate_twice (i : Index) (H : Subgroup W) :
    conjugate cs i (conjugate cs i H) = H := by
  ext r
  simp only [mem_conjugate, mul_assoc, cs.simple_mul_simple_cancel_left,
    cs.simple_mul_simple_cancel_right]

private theorem restricted_conjugate (i : Index) (H : Subgroup W)
    (hout : cs.simple i ∉ H) {t r : W} (ht : t ∈ H) (hr : r ∈ conjugate cs i H) :
    cs.IsLeftInversion (cs.simple i * t * cs.simple i) r ↔
      cs.IsLeftInversion t (cs.simple i * r * cs.simple i) := by
  have hr' := (mem_conjugate cs i H r).mp hr
  have hne : r ≠ cs.simple i := by
    intro heq
    subst r
    simp only [cs.simple_mul_simple_self, one_mul] at hr'
    exact hout hr'
  have hne' : t⁻¹ * (cs.simple i * r * cs.simple i) * t ≠ cs.simple i := by
    intro heq
    exact hout (heq ▸ H.mul_mem (H.mul_mem (H.inv_mem ht) hr') ht)
  simp only [mul_assoc] at hne'
  rw [leftInversion_mul_iff, leftInversion_mul_iff]
  simp only [mul_inv_rev, cs.inv_simple, mul_assoc, leftInv_simple, hne, hne', Xor,
    not_false_eq_true, false_and, false_or, and_true, or_false]

private theorem canonical_conjugate_forward (i : Index) (H : Subgroup W)
    (hout : cs.simple i ∉ H) {t : W} (ht : t ∈ canonicalReflections cs H) :
    cs.simple i * t * cs.simple i ∈ canonicalReflections cs (conjugate cs i H) := by
  have htH := canonical_mem cs ht
  have htH' : cs.simple i * t * cs.simple i ∈ conjugate cs i H := by
    rw [mem_conjugate]
    simpa only [mul_assoc, cs.simple_mul_simple_cancel_left,
      cs.simple_mul_simple_cancel_right] using htH
  refine ⟨?_, ?_⟩
  · simpa only [cs.inv_simple] using
      (cs.isReflection_conj_iff (cs.simple i) t).mpr ht.1
  · ext r
    simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff]
    constructor
    · intro hr
      have hinv := (restricted_conjugate cs i H hout htH hr.2).mp hr.1
      have heq : cs.simple i * r * cs.simple i = t := by
        have hmem : cs.simple i * r * cs.simple i ∈
            {r | cs.IsLeftInversion t r ∧ r ∈ H} :=
          ⟨hinv, (mem_conjugate cs i H r).mp hr.2⟩
        rwa [ht.2, Set.mem_singleton_iff] at hmem
      have := congrArg (fun x => cs.simple i * x * cs.simple i) heq
      simpa only [mul_assoc, cs.simple_mul_simple_cancel_left,
        cs.simple_mul_simple_cancel_right] using this
    · rintro rfl
      refine ⟨?_, htH'⟩
      apply (restricted_conjugate cs i H hout htH htH').mpr
      have hself : cs.IsLeftInversion t t ∧ t ∈ H := by
        change t ∈ {r | cs.IsLeftInversion t r ∧ r ∈ H}
        rw [ht.2]
        exact Set.mem_singleton t
      simpa only [mul_assoc, cs.simple_mul_simple_cancel_left,
        cs.simple_mul_simple_cancel_right] using hself.1

/-- Conjugation by a simple reflection outside a subgroup transports its canonical set. -/
theorem canonical_conjugate (i : Index) (H : Subgroup W) (hout : cs.simple i ∉ H) :
    canonicalReflections cs (H.map (MulAut.conj (cs.simple i)).toMonoidHom) =
      (fun t => cs.simple i * t * cs.simple i) '' canonicalReflections cs H := by
  ext t
  constructor
  · intro ht
    have hout' : cs.simple i ∉ conjugate cs i H := by
      simpa only [mem_conjugate, cs.simple_mul_simple_self, one_mul] using hout
    have hc := canonical_conjugate_forward cs i (conjugate cs i H) hout' ht
    rw [conjugate_twice] at hc
    refine ⟨cs.simple i * t * cs.simple i, hc, ?_⟩
    simp only [mul_assoc, cs.simple_mul_simple_cancel_left,
      cs.simple_mul_simple_cancel_right]
  · rintro ⟨r, hr, rfl⟩
    exact canonical_conjugate_forward cs i H hout hr

private theorem conjugate_canonicalClosure (i : Index) (H : Subgroup W)
    (hout : cs.simple i ∉ H) :
    conjugate cs i (Subgroup.closure (canonicalReflections cs H)) =
      Subgroup.closure (canonicalReflections cs (conjugate cs i H)) := by
  change (Subgroup.closure (canonicalReflections cs H)).map
      (MulAut.conj (cs.simple i)).toMonoidHom =
    Subgroup.closure
      (canonicalReflections cs (H.map (MulAut.conj (cs.simple i)).toMonoidHom))
  rw [canonical_conjugate cs i H hout]
  rw [MonoidHom.map_closure]
  change Subgroup.closure ((fun t => cs.simple i * t * (cs.simple i)⁻¹) '' _) = _
  rw [cs.inv_simple]

/-- Every subgroup reflection is conjugate to a canonical reflection by a canonical word. -/
theorem canonical_reflection_conj {H : Subgroup W} {t : W}
    (htH : t ∈ H) (ht : cs.IsReflection t) :
    ∃ (w r : W), w ∈ Subgroup.closure (canonicalReflections cs H) ∧
      r ∈ canonicalReflections cs H ∧ t = w * r * w⁻¹ := by
  suffices aux : ∀ n : ℕ, ∀ (H : Subgroup W) (t : W),
      cs.length t = n → t ∈ H → cs.IsReflection t →
      ∃ (w r : W), w ∈ Subgroup.closure (canonicalReflections cs H) ∧
        r ∈ canonicalReflections cs H ∧ t = w * r * w⁻¹ by
    exact aux (cs.length t) H t rfl htH ht
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro H t hlength htH ht
    rcases reflection_simple_or_shorter cs ht with ⟨i, rfl⟩ | ⟨i, hshort⟩
    · exact ⟨1, cs.simple i, Subgroup.one_mem _, (canonical_simple cs H i).mpr htH,
        by simp only [one_mul, inv_one, mul_one]⟩
    · let smaller := cs.simple i * t * cs.simple i
      have hlt : cs.length smaller < n := by dsimp only [smaller]; omega
      have hsmall : cs.IsReflection smaller := by
        simpa only [smaller, cs.inv_simple] using
          (cs.isReflection_conj_iff (cs.simple i) t).mpr ht
      by_cases hi : cs.simple i ∈ H
      · have hsmallH : smaller ∈ H := H.mul_mem (H.mul_mem hi htH) hi
        obtain ⟨w, r, hw, hr, heq⟩ := ih (cs.length smaller) hlt H smaller rfl hsmallH hsmall
        have hican := (canonical_simple cs H i).mpr hi
        refine ⟨cs.simple i * w, r,
          Subgroup.mul_mem _ (Subgroup.subset_closure hican) hw, hr, ?_⟩
        have hback := congrArg (fun x => cs.simple i * x * cs.simple i) heq
        dsimp only [smaller] at hback
        simp only [mul_assoc, cs.simple_mul_simple_cancel_left,
          cs.simple_mul_simple_cancel_right] at hback
        rw [mul_inv_rev, cs.inv_simple]
        simpa only [mul_assoc] using hback
      · have hsmallH : smaller ∈ conjugate cs i H := by
          rw [mem_conjugate]
          simpa only [smaller, mul_assoc, cs.simple_mul_simple_cancel_left,
            cs.simple_mul_simple_cancel_right] using htH
        obtain ⟨w, r, hw, hr, heq⟩ :=
          ih (cs.length smaller) hlt (conjugate cs i H) smaller rfl hsmallH hsmall
        have hi' : cs.simple i ∉ conjugate cs i H := by
          simpa only [mem_conjugate, cs.simple_mul_simple_self, one_mul] using hi
        have hr' := canonical_conjugate_forward cs i (conjugate cs i H) hi' hr
        rw [conjugate_twice] at hr'
        have hw' : cs.simple i * w * cs.simple i ∈
            Subgroup.closure (canonicalReflections cs H) := by
          apply (mem_conjugate cs i _ w).mp
          rwa [conjugate_canonicalClosure cs i H hi]
        refine ⟨cs.simple i * w * cs.simple i, cs.simple i * r * cs.simple i,
          hw', hr', ?_⟩
        have hback := congrArg (fun x => cs.simple i * x * cs.simple i) heq
        dsimp only [smaller] at hback
        simp only [mul_assoc, cs.simple_mul_simple_cancel_left,
          cs.simple_mul_simple_cancel_right] at hback
        rw [hback]
        simp only [mul_inv_rev, cs.inv_simple, mul_assoc,
          cs.simple_mul_simple_cancel_left]

/-- Canonical reflections generate the subgroup generated by all subgroup reflections. -/
theorem canonical_closure (H : Subgroup W) :
    Subgroup.closure (canonicalReflections cs H) =
      Subgroup.closure {t | cs.IsReflection t ∧ t ∈ H} := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro t ht
    exact Subgroup.subset_closure ⟨ht.1, canonical_mem cs ht⟩
  · apply (Subgroup.closure_le _).mpr
    intro t ht
    obtain ⟨w, r, hw, hr, heq⟩ := canonical_reflection_conj cs ht.2 ht.1
    rw [heq]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ hw (Subgroup.subset_closure hr)) (Subgroup.inv_mem _ hw)

end BruhatIntervals
