import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Generation
import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Plane
import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Span
import TauCeti.GroupTheory.SpecificGroups.Dihedral.Basic

/-!
# Dihedral reflection subgroups in a plane

Reflections with roots in a plane generate a subgroup with at most two canonical generators.
When the original roots contain a distinct pair, both generators are nonidentity involutions and
the subgroup is a dihedral group. Degree zero includes the infinite dihedral group.

## Main results

* `Realization.reflection_closure_pair`: a planar reflection subgroup is generated by a canonical
  pair, with identity fallback for empty slots.
* `Realization.reflection_closure_dihedral`: two distinct planar reflection roots generate a
  dihedral subgroup.

## Implementation notes

Canonical generation and the inherited root-plane bound construct the generator pair. The proved
recognition theorem for two nonidentity involutions then constructs the group equivalence.

## References

* M. Dyer, *Reflection Subgroups of Coxeter Systems*, Journal of Algebra 135 (1990), Sections 3
  and 4.
* M. Dyer, *On the Bruhat Graph of a Coxeter System*, Compositio Mathematica 78 (1991), Section 3.
-/

namespace BruhatIntervals

variable {Index W V : Type*} [Group W] {matrix : CoxeterMatrix Index}
  {cs : CoxeterSystem matrix W} [AddCommGroup V] [Module ℝ V]

private theorem reflection_ne_one {t : W} (ht : cs.IsReflection t) : t ≠ 1 := by
  intro heq
  have hpos := ht.odd_length.pos
  rw [heq, cs.length_one] at hpos
  omega

private theorem reflection_singleton {r t : W} (hr : cs.IsReflection r)
    (ht : cs.IsReflection t) (hmem : t ∈ Subgroup.closure ({r} : Set W)) : t = r := by
  rw [← Subgroup.zpowers_eq_closure] at hmem
  have horder : orderOf r = 2 := orderOf_eq_prime hr.pow_two (reflection_ne_one hr)
  rcases (Subgroup.mem_zpowers_iff_of_orderOf_eq_two horder).mp hmem with hone | heq
  · exact (reflection_ne_one ht hone).elim
  · exact heq

private theorem pair_left_ne_one (H : Subgroup W) {r s a b : W}
    (hpair : H = Subgroup.closure ({r, s} : Set W))
    (hs : s = 1 ∨ cs.IsReflection s) (ha : a ∈ H) (hb : b ∈ H)
    (haref : cs.IsReflection a) (hbref : cs.IsReflection b) (hne : a ≠ b) : r ≠ 1 := by
  intro hr
  rw [hr, Subgroup.closure_insert_one] at hpair
  rcases hs with hone | href
  · rw [hone, Subgroup.closure_singleton_one] at hpair
    have haone : a = 1 := by simpa only [hpair, Subgroup.mem_bot] using ha
    exact reflection_ne_one haref haone
  · have ha' : a = s := reflection_singleton href haref (hpair ▸ ha)
    have hb' : b = s := reflection_singleton href hbref (hpair ▸ hb)
    exact hne (ha'.trans hb'.symm)

namespace Realization

variable (realization : Realization cs (V := V))

/-- A reflection subgroup generated by roots in a plane has at most two canonical generators. -/
theorem reflection_closure_pair (plane : Submodule ℝ V) [FiniteDimensional ℝ plane]
    (hdim : Module.finrank ℝ plane ≤ 2)
    (generators : Set {x : V // x ∈ realization.positiveRoots})
    (hplane : ∀ root ∈ generators, root.val ∈ plane) :
    let H := Subgroup.closure
      ((fun root => (realization.rootReflection root).val) '' generators)
    ∃ r s : W, r ∈ insert 1 (canonicalReflections cs H) ∧
      s ∈ insert 1 (canonicalReflections cs H) ∧ H = Subgroup.closure {r, s} := by
  classical
  dsimp only
  let image := (fun root => (realization.rootReflection root).val) '' generators
  let H := Subgroup.closure image
  have hreflection : ∀ t ∈ image, cs.IsReflection t := by
    rintro t ⟨root, _, rfl⟩
    exact (realization.rootReflection root).property
  have hcanonical : Subgroup.closure (canonicalReflections cs H) = H :=
    canonical_generate cs image hreflection
  have hall : ∀ root : {x : V // x ∈ realization.positiveRoots},
      (realization.rootReflection root).val ∈ canonicalReflections cs H →
      root.val ∈ plane := by
    intro root hroot
    exact realization.root_mem_of_reflection_closure plane generators hplane root
      (canonical_mem cs hroot)
  obtain ⟨r, s, hr, hs, hsubset⟩ := realization.canonical_subset_pair H plane hdim hall
  refine ⟨r, s, hr, hs, ?_⟩
  change H = Subgroup.closure {r, s}
  apply le_antisymm
  · rw [← hcanonical]
    exact Subgroup.closure_mono hsubset
  · apply (Subgroup.closure_le _).mpr
    apply Set.pair_subset
    · rcases hr with hr | hr
      · exact hr ▸ H.one_mem
      · exact canonical_mem cs hr
    · rcases hs with hs | hs
      · exact hs ▸ H.one_mem
      · exact canonical_mem cs hs

/-- A planar reflection subgroup containing two distinct generating roots is dihedral. -/
theorem reflection_closure_dihedral (plane : Submodule ℝ V) [FiniteDimensional ℝ plane]
    (hdim : Module.finrank ℝ plane ≤ 2)
    (generators : Set {x : V // x ∈ realization.positiveRoots})
    (hplane : ∀ root ∈ generators, root.val ∈ plane) (hnontrivial : generators.Nontrivial) :
    ∃ n : ℕ, Nonempty (DihedralGroup n ≃* Subgroup.closure
      ((fun root => (realization.rootReflection root).val) '' generators)) := by
  classical
  let image := (fun root => (realization.rootReflection root).val) '' generators
  let H := Subgroup.closure image
  obtain ⟨r, s, hr, hs, hpair⟩ :=
    realization.reflection_closure_pair plane hdim generators hplane
  change H = Subgroup.closure {r, s} at hpair
  obtain ⟨α, hα, β, hβ, hαβ⟩ := hnontrivial
  have hαH : (realization.rootReflection α).val ∈ H :=
    Subgroup.subset_closure ⟨α, hα, rfl⟩
  have hβH : (realization.rootReflection β).val ∈ H :=
    Subgroup.subset_closure ⟨β, hβ, rfl⟩
  have hrefne : (realization.rootReflection α).val ≠ (realization.rootReflection β).val := by
    intro heq
    exact hαβ (realization.rootReflection_injective (Subtype.ext heq))
  have hrkind : r = 1 ∨ cs.IsReflection r := hr.imp_right And.left
  have hskind : s = 1 ∨ cs.IsReflection s := hs.imp_right And.left
  have hrne : r ≠ 1 := pair_left_ne_one H hpair hskind hαH hβH
    (realization.rootReflection α).property (realization.rootReflection β).property hrefne
  have hsne : s ≠ 1 := by
    have hpair' : H = Subgroup.closure ({s, r} : Set W) := by
      rwa [Set.pair_comm]
    exact pair_left_ne_one H hpair' hrkind hαH hβH
      (realization.rootReflection α).property (realization.rootReflection β).property hrefne
  have hrcan := hr.resolve_left hrne
  have hscan := hs.resolve_left hsne
  let rH : H := ⟨r, canonical_mem cs hrcan⟩
  let sH : H := ⟨s, canonical_mem cs hscan⟩
  have hrH : rH * rH = 1 := Subtype.ext hrcan.1.mul_self
  have hsH : sH * sH = 1 := Subtype.ext hscan.1.mul_self
  have hrHne : rH ≠ 1 := fun heq => hrne (congrArg Subtype.val heq)
  have hsHne : sH ≠ 1 := fun heq => hsne (congrArg Subtype.val heq)
  have hgen : Subgroup.closure ({rH, sH} : Set H) = ⊤ := by
    let K : Subgroup H := Subgroup.closure {rH, sH}
    have hle : H ≤ K.map H.subtype := by
      conv_lhs => rw [hpair]
      apply (Subgroup.closure_le _).mpr
      apply Set.pair_subset
      · exact ⟨rH, Subgroup.subset_closure (Or.inl rfl), rfl⟩
      · exact ⟨sH, Subgroup.subset_closure (Or.inr rfl), rfl⟩
    apply eq_top_iff.mpr
    intro g _
    obtain ⟨h, hh, heq⟩ := hle g.property
    exact (Subtype.ext heq : h = g) ▸ hh
  exact ⟨orderOf (rH * sH), ⟨TauCeti.dihedralGroupMulEquiv hrH hsH hrHne hsHne rfl hgen⟩⟩

end Realization
end BruhatIntervals
