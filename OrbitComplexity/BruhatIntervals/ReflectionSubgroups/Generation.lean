import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Canonical

/-!
# Generating reflection subgroups canonically

Canonical reflections generate every reflection-generated subgroup. The concrete generating set
is arbitrary and can be infinite.

## Main results

* `canonical_generate`: canonical reflections generate a given reflection-generated subgroup.

## References

* M. Dyer, *Reflection Subgroups of Coxeter Systems*, Journal of Algebra 135 (1990), Section 3.
-/

namespace BruhatIntervals

variable {Index W : Type*} [Group W] {matrix : CoxeterMatrix Index}
  (cs : CoxeterSystem matrix W)

/-- Canonical reflections generate every subgroup generated by ambient reflections. -/
theorem canonical_generate (generators : Set W)
    (hreflection : ∀ t ∈ generators, cs.IsReflection t) :
    Subgroup.closure (canonicalReflections cs (Subgroup.closure generators)) =
      Subgroup.closure generators := by
  rw [canonical_closure]
  apply le_antisymm
  · exact (Subgroup.closure_le _).mpr fun _ ht => ht.2
  · apply Subgroup.closure_mono
    intro t ht
    exact ⟨hreflection t ht, Subgroup.subset_closure ht⟩

end BruhatIntervals
