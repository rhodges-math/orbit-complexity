import OrbitComplexity.BruhatIntervals.ReflectionSubgroups.Canonical

/-!
# Spans of reflection subgroup roots

A group generated by root reflections acts as the identity modulo the span of its generating
roots. Consequently every ambient reflection belonging to that subgroup has its positive root
in the same span. This argument works for degenerate geometric forms.

## Main results

* `Realization.root_mem_of_reflection_closure`: reflection roots stay in the generating span.

## Implementation notes

The elements acting trivially on the quotient form an explicitly constructed subgroup. A
reflection's displacement of its own unit root recovers that root from the displacement space.

## References

* M. Dyer, *On the Bruhat Graph of a Coxeter System*, Compositio Mathematica 78 (1991),
  Section 3.
-/

namespace BruhatIntervals.Realization

variable {Index W V : Type*} [Group W] {matrix : CoxeterMatrix Index}
  {cs : CoxeterSystem matrix W} [AddCommGroup V] [Module ℝ V]
  (realization : Realization cs (V := V))

private def quotientStabilizer (plane : Submodule ℝ V) : Subgroup W where
  carrier := {w | ∀ x : V, realization.action w x - x ∈ plane}
  one_mem' := by
    intro x
    rw [map_one]
    change x - x ∈ plane
    simpa only [sub_self] using plane.zero_mem
  mul_mem' := by
    intro u v hu hv x
    have h := plane.add_mem (hu (realization.action v x)) (hv x)
    rw [map_mul, LinearEquiv.mul_apply]
    convert h using 1
    abel
  inv_mem' := by
    intro w hw x
    have h := plane.neg_mem (hw (realization.action (w⁻¹) x))
    rw [realization.action_action_inv] at h
    convert h using 1
    abel

/-- Every root reflection in a reflection-generated subgroup has its root in the generating
root subspace. -/
theorem root_mem_of_reflection_closure (plane : Submodule ℝ V)
    (generators : Set {x : V // x ∈ realization.positiveRoots})
    (hplane : ∀ root ∈ generators, root.val ∈ plane)
    (root : {x : V // x ∈ realization.positiveRoots})
    (hroot : (realization.rootReflection root).val ∈
      Subgroup.closure ((fun α => (realization.rootReflection α).val) '' generators)) :
    root.val ∈ plane := by
  have hle : Subgroup.closure
      ((fun α => (realization.rootReflection α).val) '' generators) ≤
      quotientStabilizer realization plane := by
    apply (Subgroup.closure_le _).mpr
    rintro g ⟨α, hα, rfl⟩ x
    rw [realization.rootReflection_apply]
    convert plane.neg_mem
      (plane.smul_mem (2 * realization.form α.val x) (hplane α hα)) using 1
    abel
  have h := hle hroot root.val
  rw [realization.rootReflection_apply, realization.form_root_eq_one root.property.1,
    mul_one] at h
  have htwice : (-2 : ℝ) • root.val ∈ plane := by
    convert h using 1
    simp only [neg_smul, two_smul]
    abel
  have hhalf := plane.smul_mem (-(1 / 2 : ℝ)) htwice
  norm_num [smul_smul] at hhalf
  exact hhalf

end BruhatIntervals.Realization
