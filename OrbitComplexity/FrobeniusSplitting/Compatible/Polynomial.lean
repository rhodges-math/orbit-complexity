import OrbitComplexity.FrobeniusSplitting.Splittings.Polynomial
import OrbitComplexity.FrobeniusSplitting.Compatible.Ideals
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Coordinate ideals and polynomial splittings

The canonical polynomial splitting preserves the ideals generated by any set of
variables and the ideals generated by squarefree monomials. These are the
coordinate subspaces and coordinate normal-crossing divisors.

## References

* Brion and Kumar, *Frobenius splitting methods in geometry and representation
  theory*, Section 1.1.
-/

namespace FrobeniusSplitting.RingSplitting

open MvPolynomial

variable {R σ : Type*} [CommSemiring R] {p : ℕ} [ExpChar R p]

/-- Ideals generated by variables are compatible with the polynomial splitting. -/
theorem polynomial_compatible_variables (base : RingSplitting R p) (hp : 0 < p)
    (s : Set σ) : (base.polynomial hp).IsCompatible
      (Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R))) := by
  intro f hf
  apply mem_ideal_span_X_image.2
  intro d hd
  have hnonzero := MvPolynomial.mem_support_iff.1 hd
  rw [polynomial_coeff] at hnonzero
  have hcoeff : f.coeff (p • d) ≠ 0 := by
    intro hzero
    rw [hzero, base.map_zero] at hnonzero
    exact hnonzero rfl
  obtain ⟨i, hi, hpositive⟩ := (mem_ideal_span_X_image.1 hf) (p • d)
    (MvPolynomial.mem_support_iff.2 hcoeff)
  refine ⟨i, hi, ?_⟩
  intro hzero
  exact hpositive (by simp only [Finsupp.smul_apply, hzero, smul_zero])

/-- Ideals generated by squarefree monomials are compatible with the polynomial splitting. -/
theorem polynomial_compatible_monomial (base : RingSplitting R p) (hp : 0 < p)
    (a : σ →₀ ℕ) (hsquarefree : ∀ i, a i ≤ 1) :
    (base.polynomial hp).IsCompatible (Ideal.span {monomial a (1 : R)}) := by
  intro f hf
  have hmem : f ∈ Ideal.span ((fun d ↦ monomial d (1 : R)) '' {a}) := by
    simpa only [Set.image_singleton] using hf
  have hgoal : (base.polynomial hp) f ∈
      Ideal.span ((fun d ↦ monomial d (1 : R)) '' {a}) := by
    apply mem_ideal_span_monomial_image.2
    intro d hd
    have hnonzero := MvPolynomial.mem_support_iff.1 hd
    rw [polynomial_coeff] at hnonzero
    have hcoeff : f.coeff (p • d) ≠ 0 := by
      intro hzero
      rw [hzero, base.map_zero] at hnonzero
      exact hnonzero rfl
    obtain ⟨b, hb, hle⟩ := (mem_ideal_span_monomial_image.1 hmem) (p • d)
      (MvPolynomial.mem_support_iff.2 hcoeff)
    have heq : b = a := Set.mem_singleton_iff.1 hb
    subst b
    refine ⟨a, Set.mem_singleton _, ?_⟩
    intro i
    by_cases hzero : d i = 0
    · simpa only [Finsupp.smul_apply, hzero, smul_zero] using hle i
    · exact (hsquarefree i).trans (Nat.one_le_iff_ne_zero.2 hzero)
  simpa only [Set.image_singleton] using hgoal

end FrobeniusSplitting.RingSplitting
