import Batteries.Tactic.Lint
import OrbitComplexity.FrobeniusSplitting.Normality.ScalarImages
import Mathlib.LinearAlgebra.TensorProduct.Finiteness

/-!
# Image Generators

Chosen generator images detect generation of coefficient-model images.
-/

open scoped TensorProduct

namespace FrobeniusSplitting

variable {S R K M A ι : Type*} [CommRing S] [CommRing R] [CommRing K]
    [CommRing M] [CommRing A] [Algebra S R] [Algebra R K] [Algebra S K]
    [IsScalarTower S R K] [Algebra S M] [Algebra K A] [Algebra R A]
    [IsScalarTower R K A]

/-- Scalar-extension images are generated by the images of any chosen algebra generators. -/
theorem scalarImage_range_eq_adjoin (P : Algebra.Generators S M ι)
    (e : K ⊗[S] M ≃ₐ[K] A) :
    (scalarImageHom (R := R) e).range =
      Algebra.adjoin R (Set.range (fun i ↦ e ((1 : K) ⊗ₜ[S] P.val i))) := by
  let Q := P.baseChange R
  let q := scalarImageHom (R := R) e
  have hgen : Algebra.adjoin R (Set.range Q.val) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact (AlgHom.range_eq_top _).mpr Q.aeval_val_surjective
  calc
    q.range = (⊤ : Subalgebra R (R ⊗[S] M)).map q := (Algebra.map_top q).symm
    _ = (Algebra.adjoin R (Set.range Q.val)).map q := by rw [hgen]
    _ = Algebra.adjoin R (q '' Set.range Q.val) := AlgHom.map_adjoin q _
    _ = Algebra.adjoin R (Set.range (fun i ↦ e ((1 : K) ⊗ₜ[S] P.val i))) := by
      congr 1
      rw [← Set.range_comp]
      congr 1
      funext i
      change e.toAlgHom ((algebraMap R K 1) ⊗ₜ[S] P.val i) = _
      rw [map_one]
      rfl

/-- Containment of generator images implies containment of the entire coefficient-model image. -/
theorem scalarImage_le_of_generators (P : Algebra.Generators S M ι)
    (e : K ⊗[S] M ≃ₐ[K] A) (B : Subalgebra R A)
    (h : ∀ i, e ((1 : K) ⊗ₜ[S] P.val i) ∈ B) :
    (scalarImageHom (R := R) e).range ≤ B := by
  rw [scalarImage_range_eq_adjoin P e]
  exact Algebra.adjoin_le (Set.range_subset_iff.mpr h)

/-- Finite product expressions for generator images make two model images generate the target. -/
theorem scalarImage_images_eq_top (P : Algebra.Generators S M ι)
    (e : K ⊗[S] M ≃ₐ[K] A) {X Y : Type*} [CommRing X] [CommRing Y]
    [Algebra R X] [Algebra R Y]
    (p : X →ₐ[R] (scalarImageHom (R := R) e).range)
    (q : Y →ₐ[R] (scalarImageHom (R := R) e).range)
    (h : ∀ i, ∃ (n : ℕ) (x : Fin n → X) (y : Fin n → Y),
      e ((1 : K) ⊗ₜ[S] P.val i) = ∑ j, (p (x j)).val * (q (y j)).val) :
    p.range ⊔ q.range = ⊤ := by
  let Z := (scalarImageHom (R := R) e).range
  let T := p.range ⊔ q.range
  have hZ : Z ≤ T.map Z.val := scalarImage_le_of_generators P e _ fun i ↦ by
    obtain ⟨n, x, y, hxy⟩ := h i
    have hw : (∑ j, p (x j) * q (y j)) ∈ T := by
      apply Subalgebra.sum_mem
      intro j _
      exact T.mul_mem (Algebra.mem_sup_left (AlgHom.mem_range_self p (x j)))
        (Algebra.mem_sup_right (AlgHom.mem_range_self q (y j)))
    refine Subalgebra.mem_map.mpr ⟨∑ j, p (x j) * q (y j), hw, ?_⟩
    rw [map_sum]
    change (∑ j, (p (x j)).val * (q (y j)).val) = _
    exact hxy.symm
  apply le_antisymm le_top
  intro z _
  obtain ⟨w, hw, hwz⟩ := Subalgebra.mem_map.mp (hZ z.property)
  exact (Subtype.ext hwz : w = z) ▸ hw

/-- Finite product witnesses give generation in any model identified with a scalar image. -/
theorem model_images_eq_top (P : Algebra.Generators S M ι)
    (e : K ⊗[S] M ≃ₐ[K] A) (Z : Subalgebra R A)
    (hZ : Z = (scalarImageHom (R := R) e).range)
    {X Y : Type*} [CommRing X] [CommRing Y] [Algebra R X] [Algebra R Y]
    (p : X →ₐ[R] Z) (q : Y →ₐ[R] Z)
    (h : ∀ i, ∃ (n : ℕ) (x : Fin n → X) (y : Fin n → Y),
      e ((1 : K) ⊗ₜ[S] P.val i) = ∑ j, (p (x j)).val * (q (y j)).val) :
    p.range ⊔ q.range = ⊤ := by
  cases hZ
  exact scalarImage_images_eq_top P e p q h

end FrobeniusSplitting
