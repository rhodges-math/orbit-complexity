import OrbitComplexity.FrobeniusSplitting.Normality.ModelImages
import Mathlib.RingTheory.Smooth.Flat

/-!
# Flat arithmetic models and their images

Flat models embed in their scalar extensions when the coefficient ring embeds. Replacing
a smooth model by this image therefore preserves smoothness and its generating families.
-/

open scoped TensorProduct

namespace FrobeniusSplitting

variable {R K M A : Type*} [CommRing R] [CommRing K] [CommRing M] [CommRing A]
    [Algebra R K] [Algebra R M] [Algebra K A] [Algebra R A] [IsScalarTower R K A]

/-- A flat model embeds in its scalar extension when the coefficient ring does. -/
theorem tensorImageHom_injective [Module.Flat R M] (e : K ⊗[R] M ≃ₐ[K] A)
    (hi : Function.Injective (algebraMap R K)) : Function.Injective (tensorImageHom e) := by
  change Function.Injective (fun m ↦ e ((1 : K) ⊗ₜ[R] m))
  exact e.injective.comp (Algebra.TensorProduct.includeRight_injective hi)

/-- A flat model is isomorphic to its image in the scalar-extension algebra. -/
noncomputable def tensorImageModelEquiv [Module.Flat R M] (e : K ⊗[R] M ≃ₐ[K] A)
    (hi : Function.Injective (algebraMap R K)) : M ≃ₐ[R] (tensorImageHom e).range :=
  AlgEquiv.ofBijective (tensorImageHom e).rangeRestrict
    ⟨fun _ _ h ↦ tensorImageHom_injective e hi (congrArg Subtype.val h),
      (tensorImageHom e).rangeRestrict_surjective⟩

/-- A smooth model remains smooth when replaced by its image. -/
theorem tensorImage_smooth [Algebra.Smooth R M] (e : K ⊗[R] M ≃ₐ[K] A)
    (hi : Function.Injective (algebraMap R K)) : Algebra.Smooth R (tensorImageHom e).range :=
  Algebra.Smooth.of_equiv (tensorImageModelEquiv e hi)

/-- The image of a model is generated by the images of any generating family. -/
theorem tensorImage_range_of_generators {ι : Type*} (P : Algebra.Generators R M ι)
    (e : K ⊗[R] M ≃ₐ[K] A) : (tensorImageHom e).range =
      Algebra.adjoin R (Set.range fun i ↦ tensorImageHom e (P.val i)) := by
  have hgen : (MvPolynomial.aeval P.val : MvPolynomial ι R →ₐ[R] M).range = ⊤ :=
    (AlgHom.range_eq_top _).mpr P.aeval_val_surjective
  calc
    (tensorImageHom e).range =
        ((tensorImageHom e).comp (MvPolynomial.aeval P.val)).range := by
      rw [AlgHom.range_comp, hgen, Algebra.map_top]
    _ = _ := by rw [MvPolynomial.comp_aeval, MvPolynomial.aeval_range]

end FrobeniusSplitting
