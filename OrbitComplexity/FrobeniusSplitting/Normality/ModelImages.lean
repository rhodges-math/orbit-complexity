import OrbitComplexity.FrobeniusSplitting.Normality.ModelMaps
import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# Arithmetic models as subalgebras

The image of a presentation model inside the original algebra remains a model after scalar
extension. Over a Noetherian coefficient ring the image is finitely presented. A finite graph
can therefore be modeled by subalgebras of its original objects, each preserved by the graph's
morphisms. The comparison isomorphisms evaluate elementary tensors by scalar multiplication.
-/

open scoped TensorProduct

namespace FrobeniusSplitting

variable {R K M A : Type*} [CommRing R] [CommRing K] [CommRing M] [CommRing A]
    [Algebra R K] [Algebra R M] [Algebra K A] [Algebra R A] [IsScalarTower R K A]

/-- The coordinate map from a model to the algebra recovered by scalar extension. -/
def tensorImageHom (e : K ⊗[R] M ≃ₐ[K] A) : M →ₐ[R] A :=
  (e.toAlgHom.restrictScalars R).comp Algebra.TensorProduct.includeRight

/-- The image coordinate map evaluates the model in the scalar-extension comparison. -/
theorem tensorImageHom_apply (e : K ⊗[R] M ≃ₐ[K] A) (m : M) :
    tensorImageHom e m = e ((1 : K) ⊗ₜ[R] m) := rfl

/-- The image of a model in its scalar extension has the same scalar extension. -/
noncomputable def tensorImageEquiv (e : K ⊗[R] M ≃ₐ[K] A) :
    K ⊗[R] (tensorImageHom e).range ≃ₐ[K] A := by
  let q := tensorImageHom e
  let h := Algebra.TensorProduct.lTensor (S := K) K q.rangeRestrict
  let g : K ⊗[R] q.range →ₐ[K] A := Algebra.TensorProduct.lift
    (Algebra.ofId K A) (Subalgebra.val q.range) fun _ _ ↦ Commute.all _ _
  have hh : Function.Surjective h := Algebra.TensorProduct.map_surjective
    (AlgHom.id K K) q.rangeRestrict Function.surjective_id q.rangeRestrict_surjective
  have heq : g.comp h = e.toAlgHom := by
    ext m
    change algebraMap K A 1 * q m = e ((1 : K) ⊗ₜ[R] m)
    rw [map_one, one_mul]
    rfl
  apply AlgEquiv.ofBijective g
  constructor
  · intro x y hxy
    obtain ⟨a, rfl⟩ := hh x
    obtain ⟨b, rfl⟩ := hh y
    apply congrArg h
    apply e.injective
    change (g.comp h) a = (g.comp h) b at hxy
    simpa only [heq, AlgEquiv.toAlgHom_apply] using hxy
  · intro a
    obtain ⟨m, hm⟩ := e.surjective a
    refine ⟨h m, ?_⟩
    change (g.comp h) m = a
    simpa only [heq, AlgEquiv.toAlgHom_apply] using hm

/-- The image comparison evaluates elementary tensors by scalar multiplication. -/
theorem tensorImageEquiv_tmul (e : K ⊗[R] M ≃ₐ[K] A) (k : K)
    (a : (tensorImageHom e).range) :
    tensorImageEquiv e (k ⊗ₜ[R] a) = algebraMap K A k * (a : A) := rfl

/-- Images of finite-type models over a Noetherian ring are finitely presented. -/
theorem tensorImage_finitePresentation [IsNoetherianRing R] [Algebra.FiniteType R M]
    (e : K ⊗[R] M ≃ₐ[K] A) :
    Algebra.FinitePresentation R (tensorImageHom e).range := by
  have hft : Algebra.FiniteType R (tensorImageHom e).range :=
    Algebra.FiniteType.of_surjective (tensorImageHom e).rangeRestrict
      (tensorImageHom e).rangeRestrict_surjective
  exact Algebra.FinitePresentation.of_finiteType.mp hft

/-- A presentation model maps a polynomial class to evaluation at the chosen generators. -/
theorem tensorImageHom_mk {ι σ : Type*} (P : Algebra.Presentation K A ι σ)
    [P.HasCoeffs R] (a : MvPolynomial ι R) :
    tensorImageHom (P.tensorModelOfHasCoeffsEquiv R) (Ideal.Quotient.mk _ a) =
      MvPolynomial.aeval P.val a := by
  rw [tensorImageHom_apply, P.tensorModelOfHasCoeffsEquiv_tmul]
  simp only [map_one, one_mul]

/-- The image of a presentation model is generated by its presentation generators. -/
theorem tensorImageHom_range {ι σ : Type*} (P : Algebra.Presentation K A ι σ)
    [P.HasCoeffs R] :
    (tensorImageHom (P.tensorModelOfHasCoeffsEquiv R)).range =
      Algebra.adjoin R (Set.range P.val) := by
  rw [← MvPolynomial.aeval_range]
  ext a
  constructor
  · rintro ⟨m, hm⟩
    obtain ⟨m, rfl⟩ := Ideal.Quotient.mk_surjective m
    refine ⟨m, ?_⟩
    change MvPolynomial.aeval P.val m = a
    change tensorImageHom (P.tensorModelOfHasCoeffsEquiv R) (Ideal.Quotient.mk _ m) = a at hm
    simpa only [tensorImageHom_mk] using hm
  · rintro ⟨m, hm⟩
    refine ⟨Ideal.Quotient.mk _ m, ?_⟩
    change MvPolynomial.aeval P.val m = a at hm
    change tensorImageHom (P.tensorModelOfHasCoeffsEquiv R) (Ideal.Quotient.mk _ m) = a
    rw [tensorImageHom_mk]
    exact hm

universe u

end FrobeniusSplitting
