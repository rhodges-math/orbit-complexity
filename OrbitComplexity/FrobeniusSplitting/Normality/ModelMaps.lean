import OrbitComplexity.FrobeniusSplitting.Normality.ArithmeticFibres
import Mathlib.RingTheory.Extension.Presentation.Core
import Mathlib.RingTheory.TensorProduct.Maps

/-!
# Arithmetic models of algebra morphisms

Polynomial representatives of the generator images and finite witnesses for the relation
identities contain only finitely many coefficients. Over the integer algebra generated by
those coefficients they define a morphism between the two presentation models. Scalar extension
recovers the morphism through the comparison isomorphisms.
-/

open scoped TensorProduct

namespace FrobeniusSplitting

open MvPolynomial

private theorem presentation_hom_lifts {K A B ι σ κ τ : Type*}
    [CommRing K] [CommRing A] [CommRing B] [Algebra K A] [Algebra K B] [Fintype τ]
    (P : Algebra.Presentation K A ι σ) (Q : Algebra.Presentation K B κ τ)
    (f : A →ₐ[K] B) :
    ∃ g : ι → MvPolynomial κ K, (∀ i, aeval Q.val (g i) = f (P.val i)) ∧
      ∃ c : σ → τ → MvPolynomial κ K,
        ∀ r, ∑ j, c r j * Q.relation j = aeval g (P.relation r) := by
  classical
  choose g hg using fun i ↦ Q.aeval_val_surjective (f (P.val i))
  refine ⟨g, hg, ?_⟩
  have heq : (aeval Q.val).comp (aeval g) = f.comp (aeval P.val) := by
    ext i
    simpa using hg i
  have hmem (r : σ) : aeval g (P.relation r) ∈ Ideal.span (Set.range Q.relation) := by
    rw [Q.span_range_relation_eq_ker, Q.ker_eq_ker_aeval_val, RingHom.mem_ker]
    change ((aeval Q.val).comp (aeval g)) (P.relation r) = 0
    rw [heq, AlgHom.comp_apply, P.aeval_val_relation, map_zero]
  choose c hc using fun r ↦ Ideal.mem_span_range_iff_exists_fun.mp (hmem r)
  exact ⟨c, hc⟩

private noncomputable def presentationModelHom {K A B R ι σ κ τ : Type*}
    [CommRing K] [CommRing A] [CommRing B] [Algebra K A] [Algebra K B]
    [CommRing R] [Algebra R K] [Algebra R A] [Algebra R B]
    [IsScalarTower R K A] [IsScalarTower R K B] [Fintype τ]
    (P : Algebra.Presentation K A ι σ) (Q : Algebra.Presentation K B κ τ)
    [P.HasCoeffs R] [Q.HasCoeffs R]
    (g : ι → MvPolynomial κ R) (c : σ → τ → MvPolynomial κ R)
    (hc : ∀ r, ∑ j, c r j * Q.relationOfHasCoeffs R j =
      aeval g (P.relationOfHasCoeffs R r)) :
    P.ModelOfHasCoeffs R →ₐ[R] Q.ModelOfHasCoeffs R := by
  let q : MvPolynomial κ R →ₐ[R] Q.ModelOfHasCoeffs R := Ideal.Quotient.mkₐ R _
  refine Ideal.Quotient.liftₐ _ (q.comp (aeval g)) ?_
  change Ideal.span (Set.range (P.relationOfHasCoeffs R)) ≤
    RingHom.ker (q.comp (aeval g)).toRingHom
  rw [Ideal.span_le]
  rintro _ ⟨r, rfl⟩
  change q (aeval g (P.relationOfHasCoeffs R r)) = 0
  rw [← hc, map_sum]
  apply Finset.sum_eq_zero
  intro j _
  change Ideal.Quotient.mk _ (c r j * Q.relationOfHasCoeffs R j) = 0
  rw [map_mul, Ideal.Quotient.mk_span_range, mul_zero]

/-- A finite graph of finitely presented algebras and morphisms admits arithmetic models
over a coefficient ring containing a prescribed finitely generated integer subalgebra. -/
theorem exists_arithmetic_graph_over {I J : Type*} [Finite I] [Finite J]
    {K : Type*} [CommRing K] (A : I → Type*) [∀ i, CommRing (A i)]
    [∀ i, Algebra K (A i)] (vars rels : I → Type*)
    [∀ i, Finite (vars i)] [∀ i, Finite (rels i)]
    (P : ∀ i, Algebra.Presentation K (A i) (vars i) (rels i))
    (src tgt : J → I) (f : ∀ a, A (src a) →ₐ[K] A (tgt a))
    (S : Subalgebra ℤ K) (hS : S.FG) :
    ∃ (R : Subalgebra ℤ K) (_ : ∀ i, (P i).HasCoeffs R)
      (f₀ : ∀ a, (P (src a)).ModelOfHasCoeffs R →ₐ[R] (P (tgt a)).ModelOfHasCoeffs R),
      S ≤ R ∧ R.FG ∧ (∀ i, Algebra.FinitePresentation R ((P i).ModelOfHasCoeffs R)) ∧
      ∀ a, ((P (tgt a)).tensorModelOfHasCoeffsEquiv R).toAlgHom.comp
          (Algebra.TensorProduct.lTensor (S := K) K (f₀ a)) =
        (f a).comp ((P (src a)).tensorModelOfHasCoeffsEquiv R).toAlgHom := by
  classical
  obtain ⟨extra, hextra, hSgen⟩ := Subalgebra.fg_def.mp hS
  let (i : I) : Fintype (rels i) := Fintype.ofFinite (rels i)
  choose g hg c hc using fun a ↦ presentation_hom_lifts (P (src a)) (P (tgt a)) (f a)
  let coeffs : Set K := extra ∪
    (((⋃ i, (P i).coeffs) ∪ (⋃ a, ⋃ i, (g a i).coeffs)) ∪
      (⋃ a, ⋃ r, ⋃ j, (c a r j).coeffs))
  have hC : coeffs.Finite := hextra.union
    (((Set.finite_iUnion fun i ↦ (P i).finite_coeffs).union
      (Set.finite_iUnion fun a ↦ Set.finite_iUnion fun i ↦ (g a i).coeffs.finite_toSet)).union
      (Set.finite_iUnion fun a ↦ Set.finite_iUnion fun r ↦
        Set.finite_iUnion fun j ↦ (c a r j).coeffs.finite_toSet))
  let R : Subalgebra ℤ K := Algebra.adjoin ℤ coeffs
  have hP (i : I) : (P i).HasCoeffs R := by
    constructor
    rw [Subalgebra.setRange_algebraMap]
    intro x hx
    change x ∈ Algebra.adjoin ℤ coeffs
    exact Algebra.subset_adjoin (Or.inr (Or.inl (Or.inl (Set.mem_iUnion.mpr ⟨i, hx⟩))))
  have lift (a : J) (v : MvPolynomial (vars (tgt a)) K) (hv : (v.coeffs : Set K) ⊆ coeffs) :
      ∃ v₀ : MvPolynomial (vars (tgt a)) R, MvPolynomial.map (algebraMap R K) v₀ = v := by
    apply MvPolynomial.mem_range_map_iff_coeffs_subset.mpr
    intro x hx
    exact ⟨⟨x, Algebra.subset_adjoin (hv hx)⟩, rfl⟩
  choose g₀ hg₀ using fun a i ↦ lift a (g a i) (fun _ hx ↦
    Or.inr (Or.inl (Or.inr (Set.mem_iUnion.mpr ⟨a, Set.mem_iUnion.mpr ⟨i, hx⟩⟩))))
  choose c₀ hc₀ using fun a r j ↦ lift a (c a r j) (fun _ hx ↦
    Or.inr (Or.inr (Set.mem_iUnion.mpr ⟨a, Set.mem_iUnion.mpr
      ⟨r, Set.mem_iUnion.mpr ⟨j, hx⟩⟩⟩)))
  have hrel (a : J) (r : rels (src a)) :
      ∑ j, c₀ a r j * (P (tgt a)).relationOfHasCoeffs R j =
        aeval (g₀ a) ((P (src a)).relationOfHasCoeffs R r) := by
    apply MvPolynomial.map_injective _ (FaithfulSMul.algebraMap_injective R K)
    simp only [map_sum, map_mul, hc₀, Algebra.Presentation.map_relationOfHasCoeffs]
    change ∑ j, c a r j * (P (tgt a)).relation j = MvPolynomial.map (algebraMap R K)
      (eval₂ C (g₀ a) ((P (src a)).relationOfHasCoeffs R r))
    rw [MvPolynomial.map_eval₂, Algebra.Presentation.map_relationOfHasCoeffs]
    change ∑ j, c a r j * (P (tgt a)).relation j = aeval
      (fun i ↦ MvPolynomial.map (algebraMap R K) (g₀ a i)) ((P (src a)).relation r)
    simpa only [hg₀] using hc a r
  let f₀ (a : J) := presentationModelHom (P (src a)) (P (tgt a)) (g₀ a) (c₀ a) (hrel a)
  have hle : S ≤ R := by
    rw [← hSgen]
    exact Algebra.adjoin_mono Set.subset_union_left
  refine ⟨R, hP, f₀, hle, Subalgebra.fg_def.mpr ⟨coeffs, hC, rfl⟩,
    (fun _ ↦ inferInstance), fun a ↦ ?_⟩
  have heval : (aeval (P (tgt a)).val : MvPolynomial (vars (tgt a)) R →ₐ[R] A (tgt a)).comp
      (aeval (g₀ a)) = ((f a).restrictScalars R).comp (aeval (P (src a)).val) := by
    ext i
    simp only [AlgHom.comp_apply, aeval_X]
    rw [← MvPolynomial.aeval_map_algebraMap K, hg₀, hg]
    rfl
  ext x
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  change (P (tgt a)).tensorModelOfHasCoeffsEquiv R
      ((1 : K) ⊗ₜ[R] Ideal.Quotient.mk _ (aeval (g₀ a) x)) =
    f a ((P (src a)).tensorModelOfHasCoeffsEquiv R
      ((1 : K) ⊗ₜ[R] Ideal.Quotient.mk _ x))
  rw [Algebra.Presentation.tensorModelOfHasCoeffsEquiv_tmul,
    Algebra.Presentation.tensorModelOfHasCoeffsEquiv_tmul]
  simp only [map_one, one_mul]
  exact AlgHom.congr_fun heval x

end FrobeniusSplitting
