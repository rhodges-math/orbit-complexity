import Batteries.Tactic.Lint
import OrbitComplexity.FrobeniusSplitting.Normality.ImageGenerators

/-!
# ScalarImageRanges

Arithmetic coefficient models and compatible chart comparisons.
-/

open scoped TensorProduct

namespace FrobeniusSplitting

/-- The intrinsic coefficient image is generated by all images of initial-model elements. -/
theorem scalarImage_range {S R K B A : Type*}
    [CommRing S] [CommRing R] [CommRing K] [CommRing B] [CommRing A]
    [Algebra S R] [Algebra R K] [Algebra S K] [IsScalarTower S R K]
    [Algebra S B] [Algebra K A] [Algebra R A] [IsScalarTower R K A]
    (e : K ⊗[S] B ≃ₐ[K] A) :
    (scalarImageHom (R := R) e).range =
      Algebra.adjoin R (Set.range fun b : B ↦ e ((1 : K) ⊗ₜ[S] b)) := by
  let P : Algebra.Generators S B B :=
    { val := id
      σ' := MvPolynomial.X
      aeval_val_σ' := fun b ↦ by simp }
  exact scalarImage_range_eq_adjoin P e

end FrobeniusSplitting
