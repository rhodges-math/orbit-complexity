import OrbitComplexity.GroupActions.Rosenlicht.InvariantDescent
import OrbitComplexity.GroupActions.Rosenlicht.ActionRelations
import Mathlib.RingTheory.TensorProduct.MvPolynomial
import Mathlib.RingTheory.TensorProduct.Quotient
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Scalar extensions of relation algebras

Polynomial presentations commute with tensor scalar extension. For invariant
coefficient fields, the generic orbit ideal gives the resulting presentation.
-/

open CategoryTheory AlgebraicGeometry

namespace GroupActions

noncomputable section

open scoped TensorProduct

universe u v w z

section Presentation

variable (R : Type u) [CommRing R] (S : Type v) [CommRing S] [Algebra R S]
variable {T : Type w} [CommRing T] [Algebra R T] {ι : Type z}

set_option maxHeartbeats 400000 in
/-- Scalar extension of an algebra generated by a tuple is presented by the
scalar extension of its polynomial relation ideal. -/
def adjoinTensorEquiv (x : ι → T) :
    S ⊗[R] (Algebra.adjoin R (Set.range x)) ≃ₐ[S]
      MvPolynomial ι S ⧸ (RingHom.ker
        (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] T)).map
        (MvPolynomial.map (algebraMap R S)) := by
  let J := RingHom.ker (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] T)
  let e : (MvPolynomial ι R ⧸ J) ≃ₐ[R] Algebra.adjoin R (Set.range x) :=
    (Ideal.quotientKerEquivRange
      (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] T)).trans
      (Subalgebra.equivOfEq _ _ (Algebra.adjoin_range_eq_range_aeval R x).symm)
  let I := J.map
    (Algebra.TensorProduct.includeRight : MvPolynomial ι R →ₐ[R] S ⊗[R] MvPolynomial ι R)
  let eP := MvPolynomial.algebraTensorAlgEquiv (σ := ι) R S
  have hm : eP.toRingHom.comp
      (Algebra.TensorProduct.includeRight :
        MvPolynomial ι R →ₐ[R] S ⊗[R] MvPolynomial ι R).toRingHom =
      MvPolynomial.map (algebraMap R S) := by
    apply RingHom.ext
    intro p
    change eP (1 ⊗ₜ[R] p) = MvPolynomial.map (algebraMap R S) p
    simp [eP]
  have hI : J.map (MvPolynomial.map (algebraMap R S)) = I.map eP.toRingHom := by
    change J.map (MvPolynomial.map (algebraMap R S)) =
      (J.map (Algebra.TensorProduct.includeRight :
        MvPolynomial ι R →ₐ[R] S ⊗[R] MvPolynomial ι R).toRingHom).map eP.toRingHom
    rw [Ideal.map_map, hm]
  exact (Algebra.TensorProduct.congr (AlgEquiv.refl : S ≃ₐ[S] S) e.symm).trans
    ((Algebra.TensorProduct.tensorQuotientEquiv S (MvPolynomial ι R) S J).trans
      (Ideal.quotientEquivAlg I _ eP hI))

end Presentation

section Orbit

variable {K : Type u} [Field K] {F : Type v} [Field F] [Algebra K F]
variable {G : Type w} [Group G] [MulSemiringAction G F] [SMulCommClass G K F]
variable {ι : Type z}

/-- The relation algebra over invariant coefficients presents the generic orbit
relations after scalar extension to the ambient field. -/
def orbitRelationTensorEquiv (E : IntermediateField K F)
    (hE : E ≤ (FixedPoints.intermediateField (F := K) G : IntermediateField K F))
    (x : ι → F) (s : Set (MvPolynomial ι F))
    (hs : Ideal.span s = orbitIdeal (G := G) x) (hc : ∀ p ∈ s, ∀ m, p.coeff m ∈ E) :
    F ⊗[E] (Algebra.adjoin E (Set.range x)) ≃ₐ[F]
      MvPolynomial ι F ⧸ orbitIdeal (G := G) x := by
  have hI : (RingHom.ker (MvPolynomial.aeval x : MvPolynomial ι E →ₐ[E] F)).map
      (MvPolynomial.map (algebraMap E F)) = orbitIdeal (G := G) x := by
    change (RingHom.ker (MvPolynomial.aeval x : MvPolynomial ι E →ₐ[E] F)).map
      (MvPolynomial.map E.subtype) = orbitIdeal (G := G) x
    rw [← orbitIdeal_comap_eq E hE x]
    exact orbitIdeal_map_comap_eq E x s hs hc
  exact (adjoinTensorEquiv E F x).trans (Ideal.quotientEquivAlgOfEq F hI)

/-- Tensoring the algebra generated by a tuple over the invariant field gives
the polynomial quotient by the generic orbit relation ideal. -/
theorem exists_fixedFieldTensorEquiv [Finite ι] (x : ι → F) :
    Nonempty
      (F ⊗[(FixedPoints.intermediateField (F := K) G : IntermediateField K F)]
        (Algebra.adjoin (FixedPoints.intermediateField (F := K) G : IntermediateField K F)
          (Set.range x)) ≃ₐ[F] MvPolynomial ι F ⧸ orbitIdeal (G := G) x) := by
  obtain ⟨s, hs, hc⟩ := exists_fixed_orbitIdeal_generators (G := G) x
  exact ⟨orbitRelationTensorEquiv
    (FixedPoints.intermediateField (F := K) G : IntermediateField K F) le_rfl x
    (s : Set (MvPolynomial ι F)) hs (fun p hp m g ↦ hc p hp g m)⟩

end Orbit

namespace Variety

variable {K : Type u} [Field K] [IsAlgClosed K] (H X : GroupActions.Variety K)
variable [GrpObj H.toOver] [ModObj H.toOver X.toOver]
variable [IrreducibleSpace H.scheme] [IrreducibleSpace X.scheme]
variable {ι : Type z} [Finite ι]

/-- The relation algebra over invariant functions remains integral after scalar
extension to the ambient function field. -/
theorem genericOrbitTensor_isDomain (x : ι → X.scheme.functionField) :
    letI : X.scheme.Over (Spec (.of K)) := ⟨X.toSpec⟩
    letI : IsIntegral X.scheme := isIntegral_of_irreducibleSpace_of_isReduced X.scheme
    IsDomain (X.scheme.functionField ⊗[invariantField H X]
      (Algebra.adjoin (invariantField H X) (Set.range x))) := by
  let _ : X.scheme.Over (Spec (.of K)) := ⟨X.toSpec⟩
  have : IsIntegral X.scheme := isIntegral_of_irreducibleSpace_of_isReduced X.scheme
  let _ := functionFieldAction (schemeTranslationHom H X)
  have : SMulCommClass H.points K X.scheme.functionField :=
    functionFieldAction_smulComm K (translationHom H X)
  obtain ⟨e⟩ := exists_fixedFieldTensorEquiv (K := K) (G := H.points) x
  have : (orbitIdeal (G := H.points) x).IsPrime := genericOrbitIdeal_isPrime H X x
  exact Function.Injective.isDomain e e.injective

end Variety

end

end GroupActions
