import OrbitComplexity.GroupActions.Rosenlicht.RelationDimension

/-!
# Function-field generators of tensor quotients

The fraction field of a quotient of a tensor product is generated by the images
of its two factors. This describes the coordinate fields of affine closed
correspondences.
-/

open scoped TensorProduct

namespace GroupActions

noncomputable section

universe u v w z t

/-- A tensor-product quotient's fraction field is generated by the two factor images. -/
theorem adjoin_tensorFactors_eq_top (K : Type u) [Field K]
    (A : Type v) [CommRing A] [Algebra K A]
    (B : Type w) [CommRing B] [Algebra K B]
    (C : Type z) [CommRing C]
    (L : Type t) [Field L] [Algebra K L] [Algebra C L] [IsFractionRing C L]
    (f : A ⊗[K] B →+* C) (hf : Function.Surjective f) :
    IntermediateField.adjoin K
      (Set.range (fun a : A ↦ algebraMap C L (f (a ⊗ₜ[K] 1))) ∪
        Set.range (fun b : B ↦ algebraMap C L (f (1 ⊗ₜ[K] b)))) = ⊤ := by
  let E := IntermediateField.adjoin K
    (Set.range (fun a : A ↦ algebraMap C L (f (a ⊗ₜ[K] 1))) ∪
      Set.range (fun b : B ↦ algebraMap C L (f (1 ⊗ₜ[K] b))))
  have ht (s : A ⊗[K] B) : algebraMap C L (f s) ∈ E := by
    induction s using TensorProduct.inductionOn with
    | tmul a b =>
      have he : a ⊗ₜ[K] b = (a ⊗ₜ[K] (1 : B)) * ((1 : A) ⊗ₜ[K] b) := by simp
      rw [he, map_mul, map_mul]
      exact E.mul_mem
        (IntermediateField.subset_adjoin K _ (Or.inl ⟨a, rfl⟩))
        (IntermediateField.subset_adjoin K _ (Or.inr ⟨b, rfl⟩))
    | add s t hs ht => simpa only [map_add] using E.add_mem hs ht
  apply top_le_iff.mp
  intro z _
  obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective C z
  obtain ⟨a, rfl⟩ := hf a
  obtain ⟨b, rfl⟩ := hf b
  exact E.div_mem (ht a) (ht b)

end

end GroupActions
