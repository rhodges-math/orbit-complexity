import OrbitComplexity.GroupActions.Tori.MonomialDimension
import Mathlib.Algebra.MvPolynomial.Eval
import OrbitComplexity.GroupActions.Tori.RealSpanRank
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Batteries.Tactic.Lint

/-! # Polynomial maps defined by weights

A family of lattice weights defines a polynomial coordinate map into the lattice group
algebra. Its kernel is generated by binomials of equal weight. Its image has Krull dimension
equal to the rank of the integral span of the weights.

## Main definitions

* `GroupActions.weightPolynomialMap`: the coordinate map sending variables to weight monomials.

## Main results

* `GroupActions.weightPolynomialMap_X`: the coordinate formula.
* `GroupActions.weightPolynomialMap_monomial`: the monomial coordinate formula.
* `GroupActions.weightPolynomialMap_ker`: the binomial generators of the kernel.
* `GroupActions.ringKrullDim_weightImage`: image dimension equals the generated lattice rank.
-/

namespace GroupActions

noncomputable section

open Multiplicative

universe u

variable {K ι M : Type u} [Field K] [Fintype ι] [AddCommGroup M]

private def polynomialMonoidEquiv : MvPolynomial ι K ≃ₐ[K]
    MonoidAlgebra K (Multiplicative (ι → ℕ)) :=
  (AddMonoidAlgebra.toMultiplicativeAlgEquiv K K (ι →₀ ℕ)).trans
    (MonoidAlgebra.domCongr K K
      (Finsupp.linearEquivFunOnFinite ℕ ℕ ι).toAddEquiv.toMultiplicative)

private theorem mapDomain_surjective {P Q : Type u} [Monoid P] [Monoid Q]
    (f : P →* Q) (hf : Function.Surjective f) :
    Function.Surjective (MonoidAlgebra.mapDomainAlgHom K K f) := by
  intro z
  induction z using MonoidAlgebra.induction_on with
  | of q =>
    obtain ⟨p, rfl⟩ := hf q
    exact ⟨MonoidAlgebra.single p 1, by simp⟩
  | add a b ha hb =>
    obtain ⟨a', rfl⟩ := ha
    obtain ⟨b', rfl⟩ := hb
    exact ⟨a' + b', map_add _ _ _⟩
  | smul r z hz =>
    obtain ⟨z', rfl⟩ := hz
    exact ⟨r • z', map_smul _ _ _⟩

/-- The coordinate map sends each polynomial variable to its lattice weight monomial. -/
def weightPolynomialMap (w : ι → M) :
    MvPolynomial ι K →ₐ[K] MonoidAlgebra K (Multiplicative M) :=
  (MonoidAlgebra.mapDomainAlgHom K K (weightMonoidHom w)).comp
    polynomialMonoidEquiv.toAlgHom

/-- Each variable maps to the monomial of its weight with coefficient one. -/
theorem weightPolynomialMap_X (w : ι → M) (i : ι) :
    weightPolynomialMap (K := K) w (MvPolynomial.X i) =
      MonoidAlgebra.single (ofAdd (w i)) 1 := by
  classical
  change MonoidAlgebra.mapDomain (weightMonoidHom w)
    (polynomialMonoidEquiv (AddMonoidAlgebra.single (Finsupp.single i 1) 1)) = _
  simp [polynomialMonoidEquiv, MonoidAlgebra.domCongr_single,
    AddMonoidAlgebra.toMultiplicativeAlgEquiv_single, weightMonoidHom,
    Fintype.linearCombination_apply_single]

/-- A polynomial monomial maps to its exponent weight with the same coefficient. -/
theorem weightPolynomialMap_monomial (w : ι → M) (d : ι →₀ ℕ) (c : K) :
    weightPolynomialMap (K := K) w (MvPolynomial.monomial d c) =
      MonoidAlgebra.single (weightMonoidHom w (ofAdd (d : ι → ℕ))) c := by
  classical
  change MonoidAlgebra.mapDomain (weightMonoidHom w)
    (polynomialMonoidEquiv (AddMonoidAlgebra.single d c)) = _
  simp only [polynomialMonoidEquiv, AlgEquiv.trans_apply,
    MonoidAlgebra.domCongr_single, AddMonoidAlgebra.toMultiplicativeAlgEquiv_single,
    MonoidAlgebra.mapDomain_single]
  rfl

/-- The weight-polynomial kernel is generated by monomial differences having
identical exponent weights. -/
theorem weightPolynomialMap_ker (w : ι → M) :
    RingHom.ker (weightPolynomialMap (K := K) w).toRingHom =
      Ideal.span {p : MvPolynomial ι K | ∃ d e : ι →₀ ℕ,
        weightMonoidHom w (ofAdd (d : ι → ℕ)) =
          weightMonoidHom w (ofAdd (e : ι → ℕ)) ∧
        p = MvPolynomial.monomial d 1 - MvPolynomial.monomial e 1} := by
  classical
  let I : Ideal (MvPolynomial ι K) :=
    Ideal.span {p : MvPolynomial ι K | ∃ d e : ι →₀ ℕ,
      weightMonoidHom w (ofAdd (d : ι → ℕ)) =
        weightMonoidHom w (ofAdd (e : ι → ℕ)) ∧
      p = MvPolynomial.monomial d 1 - MvPolynomial.monomial e 1}
  change RingHom.ker (weightPolynomialMap (K := K) w).toRingHom = I
  let q : MvPolynomial ι K →ₐ[K] MvPolynomial ι K ⧸ I := Ideal.Quotient.mkₐ K I
  let c (m : Multiplicative M) : MvPolynomial ι K ⧸ I :=
    if h : ∃ d : ι →₀ ℕ, weightMonoidHom w (ofAdd (d : ι → ℕ)) = m then
      q (MvPolynomial.monomial h.choose 1) else 0
  have hc (d : ι →₀ ℕ) :
      c (weightMonoidHom w (ofAdd (d : ι → ℕ))) = q (MvPolynomial.monomial d 1) := by
    have hd : ∃ e : ι →₀ ℕ,
        weightMonoidHom w (ofAdd (e : ι → ℕ)) =
          weightMonoidHom w (ofAdd (d : ι → ℕ)) := ⟨d, rfl⟩
    dsimp only [c]
    rw [dite_eq_left hd]
    change Ideal.Quotient.mk I _ = Ideal.Quotient.mk I _
    apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
    exact Ideal.subset_span ⟨hd.choose, d, hd.choose_spec, rfl⟩
  let L : MonoidAlgebra K (Multiplicative M) →ₗ[K] MvPolynomial ι K ⧸ I :=
    (Finsupp.linearCombination K c).comp (MonoidAlgebra.coeffLinearEquiv K).toLinearMap
  have hq (p : MvPolynomial ι K) : L (weightPolynomialMap (K := K) w p) = q p := by
    induction p using MvPolynomial.induction_on' with
    | monomial d a =>
      rw [weightPolynomialMap_monomial]
      change Finsupp.linearCombination K c (Finsupp.single _ a) = _
      rw [Finsupp.linearCombination_single, hc]
      rw [← map_smul q]
      congr 1
      simp only [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    | add p r hp hr => simp only [map_add, hp, hr]
  apply le_antisymm
  · intro p hp
    change weightPolynomialMap (K := K) w p = 0 at hp
    apply (Ideal.Quotient.eq_zero_iff_mem).mp
    change q p = 0
    rw [← hq p, hp, map_zero]
  · refine Ideal.span_le.mpr ?_
    rintro p ⟨d, e, hde, rfl⟩
    change weightPolynomialMap (K := K) w
      (MvPolynomial.monomial d 1 - MvPolynomial.monomial e 1) = 0
    rw [map_sub, weightPolynomialMap_monomial, weightPolynomialMap_monomial, hde, sub_self]


private theorem weightPolynomialMap_dim_of_span [Module.Free ℤ M] [Module.Finite ℤ M] (w : ι → M)
    (hw : Submodule.span ℤ (Set.range w) = ⊤) :
    ringKrullDim (weightPolynomialMap (K := K) w).range =
      (Module.finrank ℤ M : WithBot ℕ∞) := by
  let f := weightMonoidHom w
  let P := MonoidHom.mrange f
  let q := (MonoidAlgebra.mapDomainAlgHom K K f.mrangeRestrict).comp
    (polynomialMonoidEquiv (K := K) (ι := ι)).toAlgHom
  let j := MonoidAlgebra.mapDomainAlgHom K K P.subtype
  have hq : Function.Surjective q :=
    (mapDomain_surjective f.mrangeRestrict f.mrangeRestrict_surjective).comp
      polynomialMonoidEquiv.surjective
  have hj : Function.Injective j := MonoidAlgebra.mapDomain_injective Subtype.val_injective
  have hf : P.subtype.comp f.mrangeRestrict = f := by ext x; rfl
  have heq : weightPolynomialMap (K := K) w = j.comp q := by
    change (MonoidAlgebra.mapDomainAlgHom K K f).comp polynomialMonoidEquiv.toAlgHom = _
    have h := congrArg (fun g ↦ g.comp (polynomialMonoidEquiv (K := K) (ι := ι)).toAlgHom)
      (MonoidAlgebra.mapDomainAlgHom_comp (R := K) (A := K) f.mrangeRestrict P.subtype)
    simpa only [hf, AlgHom.comp_assoc, q, j] using h
  have hr : (weightPolynomialMap (K := K) w).range = j.range := by
    rw [heq]
    ext z
    constructor
    · rintro ⟨p, rfl⟩
      exact ⟨q p, rfl⟩
    · rintro ⟨a, rfl⟩
      obtain ⟨p, rfl⟩ := hq a
      exact ⟨p, rfl⟩
  rw [hr, ← ringKrullDim_eq_of_ringEquiv (AlgEquiv.ofInjective j hj).toRingEquiv]
  exact ringKrullDim_weightMonoid K w hw

/-- A weight-monomial coordinate image has the rank of its integral character span as dimension. -/
theorem ringKrullDim_weightImage [Module.Free ℤ M] [Module.Finite ℤ M] (w : ι → M) :
    ringKrullDim (weightPolynomialMap (K := K) w).range =
      (Module.finrank ℤ (Submodule.span ℤ (Set.range w)) : WithBot ℕ∞) := by
  let N := Submodule.span ℤ (Set.range w)
  let v : ι → N := fun i ↦ ⟨w i, Submodule.subset_span ⟨i, rfl⟩⟩
  have hv : Submodule.span ℤ (Set.range v) = ⊤ := by
    apply Submodule.map_injective_of_injective (f := N.subtype) Subtype.val_injective
    rw [Submodule.map_top, Submodule.range_subtype, Submodule.map_span, ← Set.range_comp]
    rfl
  let j := MonoidAlgebra.mapDomainAlgHom K K N.subtype.toAddMonoidHom.toMultiplicative
  have hj : Function.Injective j := MonoidAlgebra.mapDomain_injective Subtype.val_injective
  have hfactor : j.comp (weightPolynomialMap (K := K) v) = weightPolynomialMap w := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, weightPolynomialMap_X]
    change MonoidAlgebra.mapDomain N.subtype.toAddMonoidHom.toMultiplicative
      (MonoidAlgebra.single (ofAdd (v i)) 1) = _
    rw [MonoidAlgebra.mapDomain_single]
    rfl
  have hr : (weightPolynomialMap (K := K) w).range =
      (weightPolynomialMap (K := K) v).range.map j := by
    rw [← hfactor, AlgHom.range_comp]
  rw [hr, ← ringKrullDim_eq_of_ringEquiv
    ((weightPolynomialMap (K := K) v).range.equivMapOfInjective j hj).toRingEquiv]
  exact weightPolynomialMap_dim_of_span v hv

end

end GroupActions
