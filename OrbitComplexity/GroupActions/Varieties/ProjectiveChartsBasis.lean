import OrbitComplexity.GroupActions.Varieties.ProjectiveSpace
import Mathlib.RingTheory.MvPolynomial.Ideal

open MvPolynomial
noncomputable section
universe u
attribute [local instance] MvPolynomial.gradedAlgebra
/-! # The coordinate ideal of projective space

The irrelevant ideal for the total polynomial grading is generated by the variables.
This identifies the standard coordinate opens as a cover of projective space.
-/

namespace GroupActions
variable (R ι : Type u) [CommRing R]

/-- The irrelevant ideal of the total polynomial grading is generated by its variables. -/
theorem projective_irrelevant_eq_span :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule ι R)).toIdeal =
      Ideal.span (Set.range (X : ι → MvPolynomial ι R)) := by
  classical
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr
    intro n hn p hp
    change p.IsHomogeneous n at hp
    change p ∈ idealOfVars ι R
    rw [← pow_one (idealOfVars ι R), mem_pow_idealOfVars_iff]
    intro d hd
    have he : n = Finsupp.degree d := by
      simpa only [Finsupp.degree_apply] using hp.degree_eq_sum_deg_support hd
    rw [← he]
    exact hn
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.zero_lt_one (isHomogeneous_X R i)

end GroupActions
