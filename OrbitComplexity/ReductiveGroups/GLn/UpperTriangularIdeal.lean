import OrbitComplexity.ReductiveGroups.GLn.Basic
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Basic
import Mathlib.LinearAlgebra.Matrix.Block

/-!
# The Hopf ideal of the upper-triangular subgroup of `GL_n`

The upper-triangular subgroup of `GL_n` is cut out by the vanishing of the generic entries
`X_ij` with `j < i`. The ideal they generate is a Hopf ideal: the comultiplication
`Δ X_ij = Σ_k X_ik ⊗ X_kj` has, for `j < i`, in every term a factor below the diagonal; the counit
vanishes off the diagonal; and the antipode sends `X_ij` to the corresponding entry of the inverse
generic matrix, which is upper triangular modulo the ideal because the inverse of an invertible
upper-triangular matrix is upper triangular.

A point of `GL_n` kills this ideal exactly when its matrix is upper triangular, and the ideal is
contained in the ideal of the diagonal torus.

## Main declarations

* `ReductiveGroups.GLn.upperTriangularIdeal`: the Hopf ideal of the upper-triangular subgroup.
* `ReductiveGroups.GLn.upperTriangularIdeal_le_torusIdeal`: the diagonal torus lies in it.
* `ReductiveGroups.GLn.UpperTriangularIdeal.mem_upperTriangularIdeal_iff`: its points are the
  invertible upper-triangular matrices.

## References

* A. Borel, *Linear Algebraic Groups*, 2nd ed. (1991), §1.6 and §10.
* J. E. Humphreys, *Linear Algebraic Groups* (1975), §7.4.
* J. S. Milne, *Algebraic Groups* (2017), §1.c and Example 17.3.
-/

noncomputable section
namespace ReductiveGroups.GLn

open TauCeti TauCeti.GeneralLinear CategoryTheory WithConv
open scoped TensorProduct

universe u w

section Ring

variable (R : Type u) [CommRing R] (n : ℕ)

/-- The generic entries strictly below the diagonal. -/
def lowerEntries : Set (coordinateHopfAlgebra R n) :=
  {x | ∃ i j : Fin n, j < i ∧ genericMatrix R n i j = x}

variable {R n} in
/-- For these parameters,

```lean
genericMatrix R n i j ∈ lowerEntries R n
```
-/
theorem genericMatrix_mem_lowerEntries {i j : Fin n} (h : j < i) :
    genericMatrix R n i j ∈ lowerEntries R n :=
  ⟨i, j, h, rfl⟩

/-- Comultiplication on a generic entry is matrix multiplication. -/
theorem comul_genericMatrix (i j : Fin n) :
    Coalgebra.comul (R := R) (genericMatrix R n i j) =
      ∑ k : Fin n, genericMatrix R n i k ⊗ₜ[R] genericMatrix R n k j := by
  simp only [genericMatrix_apply]
  exact coordinateHopfAlgebra_comul_X R n i j

/-- The counit evaluates a generic entry at the identity matrix. -/
theorem counit_genericMatrix (i j : Fin n) :
    Coalgebra.counit (R := R) (genericMatrix R n i j) = if i = j then 1 else 0 := by
  rw [genericMatrix_apply]
  exact coordinateHopfAlgebra_counit_X R n i j

/-- The antipode sends a generic entry to the corresponding entry of the inverse matrix. -/
theorem antipode_genericMatrix (i j : Fin n) :
    HopfAlgebra.antipode R (genericMatrix R n i j) = (genericMatrix R n)⁻¹ i j := by
  rw [genericMatrix_apply, coordinateHopfAlgebra_antipode_X, genericMatrix_inv_apply]

/-- A ring homomorphism commutes with inversion of a matrix with invertible determinant. -/
theorem map_nonsing_inv {A C : Type*} [CommRing A] [CommRing C] (f : A →+* C)
    (M : Matrix (Fin n) (Fin n) A) (hM : IsUnit M.det) :
    (M.map f)⁻¹ = M⁻¹.map f := by
  apply Matrix.inv_eq_left_inv
  rw [← Matrix.map_mul, Matrix.nonsing_inv_mul _ hM]
  exact Matrix.map_one _ (map_zero f) (map_one f)

/-- Below the diagonal, the entries of the inverse generic matrix lie in the ideal generated by
the lower generic entries. -/
theorem inv_genericMatrix_mem_span {i j : Fin n} (h : j < i) :
    (genericMatrix R n)⁻¹ i j ∈ Ideal.span (lowerEntries R n) := by
  let S := Ideal.span (lowerEntries R n)
  let q : coordinateHopfAlgebra R n →+* coordinateHopfAlgebra R n ⧸ S := Ideal.Quotient.mk S
  let M := (genericMatrix R n).map q
  have hM : M.IsUpperTriangular := by
    intro a b hab
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (genericMatrix_mem_lowerEntries hab))
  have hdet : IsUnit M.det := by
    have h1 := (isUnit_det_genericMatrix R n).map q
    rwa [RingHom.map_det] at h1
  have hinv : M⁻¹ = ((genericMatrix R n)⁻¹).map q :=
    map_nonsing_inv n q (genericMatrix R n) (isUnit_det_genericMatrix R n)
  let _ : Invertible M := M.invertibleOfIsUnitDet hdet
  have hMinv : M⁻¹.IsUpperTriangular := Matrix.blockTriangular_inv_of_blockTriangular hM
  have hzero : M⁻¹ i j = 0 := hMinv h
  rw [hinv, Matrix.map_apply] at hzero
  exact Ideal.Quotient.eq_zero_iff_mem.mp hzero

/-- The equality is

```lean
∀ x ∈ lowerEntries R n,
    Coalgebra.comul (R := R) x ∈
      HopfIdeal.leftTensorIdeal (R := R) (H := coordinateHopfAlgebra R n)
          (Ideal.span (lowerEntries R n)) ⊔
        HopfIdeal.rightTensorIdeal (R := R) (H := coordinateHopfAlgebra R n)
          (Ideal.span (lowerEntries R n))
```
-/
theorem lowerEntries_comul_mem : ∀ x ∈ lowerEntries R n,
    Coalgebra.comul (R := R) x ∈
      HopfIdeal.leftTensorIdeal (R := R) (H := coordinateHopfAlgebra R n)
          (Ideal.span (lowerEntries R n)) ⊔
        HopfIdeal.rightTensorIdeal (R := R) (H := coordinateHopfAlgebra R n)
          (Ideal.span (lowerEntries R n)) := by
  rintro x ⟨i, j, hij, rfl⟩
  rw [comul_genericMatrix]
  refine Ideal.sum_mem _ fun k _ => ?_
  by_cases hk : k < i
  · exact Ideal.mem_sup_left (HopfIdeal.tmul_mem_leftTensorIdeal (R := R)
      (H := coordinateHopfAlgebra R n)
      (Ideal.subset_span (genericMatrix_mem_lowerEntries hk)) _)
  · have hjk : j < k := lt_of_lt_of_le hij (not_lt.mp hk)
    exact Ideal.mem_sup_right (HopfIdeal.tmul_mem_rightTensorIdeal (R := R)
      (H := coordinateHopfAlgebra R n) _
      (Ideal.subset_span (genericMatrix_mem_lowerEntries hjk)))

/-- The equality is

```lean
∀ x ∈ lowerEntries R n,
    Coalgebra.counit (R := R) x = 0
```
-/
theorem lowerEntries_counit_eq_zero : ∀ x ∈ lowerEntries R n,
    Coalgebra.counit (R := R) x = 0 := by
  rintro x ⟨i, j, hij, rfl⟩
  rw [counit_genericMatrix, ite_eq_right (ne_of_gt hij)]

/-- For these parameters,

```lean
∀ x ∈ lowerEntries R n,
    HopfAlgebra.antipode R x ∈ Ideal.span (lowerEntries R n)
```
-/
theorem lowerEntries_antipode_mem : ∀ x ∈ lowerEntries R n,
    HopfAlgebra.antipode R x ∈ Ideal.span (lowerEntries R n) := by
  rintro x ⟨i, j, hij, rfl⟩
  rw [antipode_genericMatrix]
  exact inv_genericMatrix_mem_span R n hij

/-- The Hopf ideal of the upper-triangular subgroup of `GL_n`: it is generated by the generic
entries below the diagonal. -/
def upperTriangularIdeal : HopfIdeal R (coordinateHopfAlgebra R n) :=
  HopfIdeal.ofSpan (lowerEntries R n) (lowerEntries_comul_mem R n)
    (lowerEntries_counit_eq_zero R n) (lowerEntries_antipode_mem R n)

/-- The equality is

```lean
(upperTriangularIdeal R n).toIdeal = Ideal.span (lowerEntries R n)
```
-/
theorem upperTriangularIdeal_toIdeal :
    (upperTriangularIdeal R n).toIdeal = Ideal.span (lowerEntries R n) :=
  HopfIdeal.ofSpan_toIdeal _ _ _ _

variable {R n} in
/-- For these parameters,

```lean
genericMatrix R n i j ∈ upperTriangularIdeal R n
```
-/
theorem genericMatrix_mem_upperTriangularIdeal {i j : Fin n} (h : j < i) :
    genericMatrix R n i j ∈ upperTriangularIdeal R n := by
  rw [← HopfIdeal.mem_toIdeal, upperTriangularIdeal_toIdeal]
  exact Ideal.subset_span (genericMatrix_mem_lowerEntries h)

/-- An algebra homomorphism out of `O(GL_n)` kills the upper-triangular ideal exactly when it
kills every generic entry below the diagonal. -/
theorem upperTriangularIdeal_le_ker_iff {A : Type w} [CommRing A] [Algebra R A]
    (f : coordinateHopfAlgebra R n →ₐ[R] A) :
    (∀ x ∈ upperTriangularIdeal R n, f x = 0) ↔
      ∀ i j : Fin n, j < i → f (genericMatrix R n i j) = 0 := by
  constructor
  · intro hf i j hij
    exact hf _ (genericMatrix_mem_upperTriangularIdeal hij)
  · intro hf x hx
    rw [← HopfIdeal.mem_toIdeal, upperTriangularIdeal_toIdeal] at hx
    have hle : Ideal.span (lowerEntries R n) ≤ RingHom.ker f := by
      rw [Ideal.span_le]
      rintro y ⟨i, j, hij, rfl⟩
      exact hf i j hij
    exact hle hx

/-- The matrix of a point of `GL_n` evaluates the point on the generic entries. -/
theorem pointsMulEquiv_apply_apply {A : Type w} [CommRing A] [Algebra R A]
    (g : WithConv (coordinateHopfAlgebra R n →ₐ[R] A)) (i j : Fin n) :
    (pointsMulEquiv n g : Matrix (Fin n) (Fin n) A) i j = g.ofConv (genericMatrix R n i j) := by
  rw [pointsMulEquiv_apply, genericMatrix_apply]
  exact pointToGeneralLinear_apply n g i j

/-- A point of `GL_n` lies in the upper-triangular subgroup exactly when its matrix is upper
triangular. -/
theorem UpperTriangularIdeal.mem_upperTriangularIdeal_iff (A : CommAlgCat.{w} R)
    (g : HopfAlgebra.points (R := R) (H := coordinateHopfAlgebra R n) A) :
    g ∈ CommHopfAlgCat.quotientPointsSubgroup (coordinateHopfAlgebra R n)
        (upperTriangularIdeal R n) A ↔
      (pointsMulEquiv n g : Matrix (Fin n) (Fin n) A).IsUpperTriangular := by
  rw [CommHopfAlgCat.mem_quotientPointsSubgroup_iff]
  have h := upperTriangularIdeal_le_ker_iff R n g.ofConv
  refine h.trans ?_
  constructor
  · intro hg i j hij
    rw [pointsMulEquiv_apply_apply]
    exact hg i j hij
  · intro hg i j hij
    have := hg hij
    rwa [pointsMulEquiv_apply_apply] at this

end Ring

section Torus

variable (K : Type u) [Field K] (n : ℕ)

/-- The diagonal torus is contained in the upper-triangular subgroup. -/
theorem upperTriangularIdeal_le_torusIdeal : upperTriangularIdeal K n ≤ torusIdeal K n := by
  intro x hx
  rw [← HopfIdeal.mem_toIdeal, ← torusRestriction_eq_zero_iff]
  have h := (upperTriangularIdeal_le_ker_iff K n
    (torusRestriction K n).toAlgHom).mpr
  refine h (fun i j hij => ?_) x hx
  change torusRestriction K n (genericMatrix K n i j) = 0
  rw [torusRestriction_genericMatrix, ite_eq_right (ne_of_gt hij)]

end Torus

end GLn
