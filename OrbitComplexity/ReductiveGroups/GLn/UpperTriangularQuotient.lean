import OrbitComplexity.ReductiveGroups.GLn.UpperTriangularIdeal
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.LinearAlgebra.Matrix.MvPolynomial

/-!
# The coordinate ring of the upper-triangular subgroup is an integral domain

Let `L` be a field. The quotient of `O(GL_n) = L[X_ij][det⁻¹]` by the ideal generated by the
entries below the diagonal is identified with the localization
`L[Y_ij (i ≤ j)][(∏ᵢ Y_ii)⁻¹]` of a polynomial ring. We construct the evaluation
`X_ij ↦ Y_ij` (`i ≤ j`), `X_ij ↦ 0` (`j < i`), which is well defined because the determinant of an
upper-triangular matrix is the product of its diagonal entries, and a left inverse
`Y_ij ↦ X_ij`. Hence the coordinate ring of the upper-triangular subgroup embeds in an integral
domain and is itself an integral domain; geometrically, `B ≅ T × U` is irreducible.

## Main declarations

* `ReductiveGroups.GLn.upperEval`: the evaluation of `O(GL_n)` at the generic upper-triangular
  matrix.
* `ReductiveGroups.GLn.upperQuotientMap_injective`: the induced map on the quotient is injective.
* `ReductiveGroups.GLn.isDomain_upperTriangularQuotient`: the quotient is an integral domain.

## References

* A. Borel, *Linear Algebraic Groups*, 2nd ed. (1991), §10.6.
* J. S. Milne, *Algebraic Groups* (2017), Example 1.14 and §6.a.
-/

noncomputable section
namespace ReductiveGroups.GLn

open TauCeti TauCeti.GeneralLinear

universe u

variable (L : Type u) [Field L] (n : ℕ)

/-- Indices on or above the diagonal. -/
abbrev UpperIndex : Type := {p : Fin n × Fin n // p.1 ≤ p.2}

/-- The product of the diagonal coordinates of the generic upper-triangular matrix. -/
def upperDiagonal : MvPolynomial (UpperIndex n) L :=
  ∏ i : Fin n, MvPolynomial.X ⟨(i, i), le_refl i⟩

/-- The coordinate ring `L[Y_ij (i ≤ j)][(∏ᵢ Y_ii)⁻¹]` of the upper-triangular group. -/
abbrev UpperCoordinateRing := Localization.Away (upperDiagonal L n)

/-- For these parameters,

```lean
upperDiagonal L n ≠ 0
```
-/
theorem upperDiagonal_ne_zero : upperDiagonal L n ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun _ _ => MvPolynomial.X_ne_zero _

/-- For these parameters,

```lean
IsDomain (UpperCoordinateRing L n)
```
-/
theorem isDomain_upperCoordinateRing : IsDomain (UpperCoordinateRing L n) :=
  Localization.Away.isDomain (upperDiagonal_ne_zero L n)

/-- The generic upper-triangular matrix. -/
def upperSpecialization : Matrix (Fin n) (Fin n) (UpperCoordinateRing L n) :=
  Matrix.of fun i j =>
    if h : i ≤ j then
      algebraMap (MvPolynomial (UpperIndex n) L) (UpperCoordinateRing L n)
        (MvPolynomial.X (⟨(i, j), h⟩ : UpperIndex n))
    else 0

/-- For these parameters,

```lean
(upperSpecialization L n).IsUpperTriangular
```
-/
theorem upperSpecialization_isUpperTriangular :
    (upperSpecialization L n).IsUpperTriangular := by
  intro i j hij
  have h : ¬i ≤ j := not_le.mpr hij
  simp [upperSpecialization, h]

/-- The equality is

```lean
(upperSpecialization L n).det =
      algebraMap _ (UpperCoordinateRing L n) (upperDiagonal L n)
```
-/
theorem det_upperSpecialization :
    (upperSpecialization L n).det =
      algebraMap _ (UpperCoordinateRing L n) (upperDiagonal L n) := by
  rw [Matrix.det_of_isUpperTriangular (upperSpecialization_isUpperTriangular L n)]
  simp only [upperDiagonal, map_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  simp [upperSpecialization]

/-- For these parameters,

```lean
IsUnit (upperSpecialization L n).det
```
-/
theorem isUnit_det_upperSpecialization : IsUnit (upperSpecialization L n).det := by
  rw [det_upperSpecialization]
  exact IsLocalization.Away.algebraMap_isUnit _

/-- Evaluation of the polynomial coordinates at the generic upper-triangular matrix. -/
def upperEvalPoly : MatrixMonoid.CoordinateRing L n →ₐ[L] UpperCoordinateRing L n :=
  MvPolynomial.aeval fun ij => upperSpecialization L n ij.1 ij.2

/-- For these parameters,

```lean
IsUnit (upperEvalPoly L n (Matrix.det (Matrix.mvPolynomialX (Fin n) (Fin n) L)))
```
-/
theorem isUnit_upperEvalPoly_det :
    IsUnit (upperEvalPoly L n (Matrix.det (Matrix.mvPolynomialX (Fin n) (Fin n) L))) := by
  rw [upperEvalPoly, AlgHom.map_det, Matrix.mvPolynomialX_mapMatrix_aeval]
  exact isUnit_det_upperSpecialization L n

/-- Evaluation of `O(GL_n)` at the generic upper-triangular matrix. -/
def upperEval : coordinateHopfAlgebra L n →ₐ[L] UpperCoordinateRing L n :=
  (IsLocalization.Away.liftAlgHom _ (isUnit_upperEvalPoly_det L n) :
      CoordinateRing L n →ₐ[L] UpperCoordinateRing L n).comp
    (coordinateHopfAlgebraAlgEquiv L n).symm.toAlgHom

/-- The equality is

```lean
upperEval L n (genericMatrix L n i j) = upperSpecialization L n i j
```
-/
theorem upperEval_genericMatrix (i j : Fin n) :
    upperEval L n (genericMatrix L n i j) = upperSpecialization L n i j := by
  rw [genericMatrix_apply, upperEval, AlgHom.comp_apply]
  have hsymm : (coordinateHopfAlgebraAlgEquiv L n).symm.toAlgHom
      (coordinateHopfAlgebraAlgEquiv L n (coordinateRingMap L n (MvPolynomial.X (i, j)))) =
      coordinateRingMap L n (MvPolynomial.X (i, j)) :=
    (coordinateHopfAlgebraAlgEquiv L n).symm_apply_apply _
  rw [hsymm, coordinateRingMap_apply]
  simp [-coordinateRingMap_apply, upperEvalPoly]

/-- The evaluation kills the upper-triangular ideal. -/
theorem upperEval_eq_zero (x : coordinateHopfAlgebra L n)
    (hx : x ∈ (upperTriangularIdeal L n).toIdeal) : upperEval L n x = 0 := by
  rw [HopfIdeal.mem_toIdeal] at hx
  refine (upperTriangularIdeal_le_ker_iff L n (upperEval L n)).mpr (fun i j hij => ?_) x hx
  rw [upperEval_genericMatrix]
  simp [upperSpecialization, not_le.mpr hij]

/-- The evaluation on the coordinate ring of the upper-triangular subgroup. -/
def upperQuotientMap :
    (coordinateHopfAlgebra L n ⧸ (upperTriangularIdeal L n).toIdeal) →ₐ[L]
      UpperCoordinateRing L n :=
  Ideal.Quotient.liftₐ _ (upperEval L n) (upperEval_eq_zero L n)

/-- The equality is

```lean
upperQuotientMap L n (Ideal.Quotient.mk _ x) = upperEval L n x
```
-/
theorem upperQuotientMap_mk (x : coordinateHopfAlgebra L n) :
    upperQuotientMap L n (Ideal.Quotient.mk _ x) = upperEval L n x :=
  rfl

/-- The images of the generic entries in the upper-triangular quotient. -/
def quotientMatrix :
    Matrix (Fin n) (Fin n) (coordinateHopfAlgebra L n ⧸ (upperTriangularIdeal L n).toIdeal) :=
  (genericMatrix L n).map (Ideal.Quotient.mk (upperTriangularIdeal L n).toIdeal)

/-- For these parameters,

```lean
(quotientMatrix L n).IsUpperTriangular
```
-/
theorem quotientMatrix_isUpperTriangular : (quotientMatrix L n).IsUpperTriangular := by
  intro i j hij
  simp only [quotientMatrix, Matrix.map_apply]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    ((HopfIdeal.mem_toIdeal).mpr (genericMatrix_mem_upperTriangularIdeal hij))

/-- For these parameters,

```lean
IsUnit (quotientMatrix L n).det
```
-/
theorem isUnit_det_quotientMatrix : IsUnit (quotientMatrix L n).det := by
  have h := (isUnit_det_genericMatrix L n).map
    (Ideal.Quotient.mk (upperTriangularIdeal L n).toIdeal)
  rwa [RingHom.map_det] at h

/-- The section `Y_ij ↦ X_ij` on polynomial coordinates. -/
def upperSectionPoly : MvPolynomial (UpperIndex n) L →ₐ[L]
    (coordinateHopfAlgebra L n ⧸ (upperTriangularIdeal L n).toIdeal) :=
  MvPolynomial.aeval fun p => quotientMatrix L n p.1.1 p.1.2

/-- For these parameters,

```lean
IsUnit (upperSectionPoly L n (upperDiagonal L n))
```
-/
theorem isUnit_upperSectionPoly_diagonal :
    IsUnit (upperSectionPoly L n (upperDiagonal L n)) := by
  have hdet := isUnit_det_quotientMatrix L n
  rw [Matrix.det_of_isUpperTriangular (quotientMatrix_isUpperTriangular L n)] at hdet
  simp only [upperDiagonal, map_prod]
  simpa [upperSectionPoly] using hdet

/-- The section `Y_ij ↦ X_ij` on the localized polynomial ring. -/
def upperSection : UpperCoordinateRing L n →ₐ[L]
    (coordinateHopfAlgebra L n ⧸ (upperTriangularIdeal L n).toIdeal) :=
  IsLocalization.Away.liftAlgHom _ (isUnit_upperSectionPoly_diagonal L n)

/-- The equality is

```lean
upperSection L n (upperSpecialization L n i j) = quotientMatrix L n i j
```
-/
theorem upperSection_upperSpecialization (i j : Fin n) :
    upperSection L n (upperSpecialization L n i j) = quotientMatrix L n i j := by
  by_cases h : i ≤ j
  · simp [upperSpecialization, h, upperSection, upperSectionPoly]
  · rw [quotientMatrix_isUpperTriangular L n (not_le.mp h)]
    simp [upperSpecialization, h]

/-- The equality is

```lean
(upperSection L n).comp (upperQuotientMap L n) = AlgHom.id L _
```
-/
theorem upperSection_comp_upperQuotientMap :
    (upperSection L n).comp (upperQuotientMap L n) = AlgHom.id L _ := by
  apply Ideal.Quotient.algHom_ext
  apply coordinateHopfAlgebra_algHom_ext L n
  intro i j
  have hgen := genericMatrix_apply L n i j
  rw [← hgen]
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, upperQuotientMap_mk,
    upperEval_genericMatrix, upperSection_upperSpecialization, AlgHom.id_apply]
  rfl

/-- The map is injective:

```lean
Function.Injective (upperQuotientMap L n)
```
-/
theorem upperQuotientMap_injective : Function.Injective (upperQuotientMap L n) := by
  intro x y h
  have hx := congrArg (upperSection L n) h
  have h1 := AlgHom.congr_fun (upperSection_comp_upperQuotientMap L n) x
  have h2 := AlgHom.congr_fun (upperSection_comp_upperQuotientMap L n) y
  simp only [AlgHom.comp_apply, AlgHom.id_apply] at h1 h2
  rw [← h1, ← h2, hx]

/-- **The coordinate ring of the upper-triangular subgroup of `GL_n` is an integral domain.** -/
theorem isDomain_upperTriangularQuotient :
    IsDomain (coordinateHopfAlgebra L n ⧸ (upperTriangularIdeal L n).toIdeal) := by
  let _ := isDomain_upperCoordinateRing L n
  exact Function.Injective.isDomain (upperQuotientMap L n).toRingHom
    (upperQuotientMap_injective L n)

end GLn
