import OrbitComplexity.ReductiveGroups.Groups.Borel.BorelTorusUnipotentKernel
import OrbitComplexity.ReductiveGroups.Groups.Unipotent.BorelRootUnipotentProductInjectivity
import OrbitComplexity.ReductiveGroups.Groups.Unipotent.BorelRootUnipotentNormality
import Mathlib.GroupTheory.Complement

/-!
# Borel Torus Unipotent

**B = T ⋉ U on ground-field points.**

For the connected reductive group `Spec B` over an algebraically closed
field of characteristic zero, its maximal torus `I` (with split
coordinate `π`, kernel `I`), and a Borel `J ≤ I`, let `U` be the
closed subgroup generated by the Ga maps integrating the nonidentity
character vectors of the Borel tangent (`borelRootUnipotentHopfIdeal`).

Every `K`-point `g` of the Borel factors as `g = t * u` with `t` a `K`-point of
the torus and `u` a `K`-point of `U`, and the factorization is unique. Hence
`B(K) = T(K) · U(K)` as sets and `B(K) = T(K) ⊔ U(K)` as subgroups; `U(K)` is
normal in `B(K)` with complement `T(K)`: `B(K)` is the internal semidirect
product `T(K) ⋉ U(K)`.

Proof of existence: choose a faithful coordinate representation and a common
triangular basis of the solvable Borel tangent. The Borel points are upper
triangular with diagonals satisfying all monomial relations of the diagonal
torus characters (`TorusUnipotent.borelPoint_upper_and_diagonal_relations`).
Divisibility of `Kˣ` provides a torus point `t` with the same diagonal, so
`t⁻¹ g` is unipotent upper triangular, hence a point of `U`
(`ReductiveGroups.TorusUnipotent.BorelPoint.borelRootUnipotent_of_matrix_unipotent`).
Uniqueness is the scheme-theoretic trivial intersection
`ReductiveGroups.BorelRootUnipotent.torus_product_injective`. -/

noncomputable section
namespace ReductiveGroups

open TauCeti WithConv Module TorusUnipotent Pointwise

universe u
variable {K B ι : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

local notation "M" => Multiplicative (ι →₀ ℤ)

omit [IsAlgClosed K] [CharZero K] [Algebra.FiniteType K B] in
/-- A larger Hopf ideal cuts out fewer points. -/
theorem TorusUnipotent.quotientPointsSubgroup_le_of_le {I₁ I₂ : HopfIdeal K B}
    (h : I₁ ≤ I₂) :
    CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I₂ (CommAlgCat.of K K) ≤
      CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I₁
        (CommAlgCat.of K K) := by
  intro g hg
  apply (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mpr
  intro a ha
  exact (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mp hg a (h ha)

omit [IsAlgClosed K] [CharZero K] [Algebra.FiniteType K B] in
/-- The torus points are Borel points. -/
theorem torusPoints_le_borelPoints (I J : HopfIdeal K B) (hJI : J ≤ I) :
    CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I (CommAlgCat.of K K) ≤
      CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
        (CommAlgCat.of K K) :=
  quotientPointsSubgroup_le_of_le hJI

/-- The points of the Ga-only subgroup are Borel points. -/
theorem borelRootUnipotentPoints_le_borelPoints
    (J : HopfIdeal K B) (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π) :
    CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) ≤
      CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
        (CommAlgCat.of K K) :=
  quotientPointsSubgroup_le_of_le (borel_le_borelRootUnipotentHopfIdeal J π hπ)

variable [Finite ι]

/-- **Existence of the torus–unipotent factorization of Borel points.**
Every `K`-point of the Borel is `t * u` with `t` a `K`-point of the
maximal torus and `u` a `K`-point of the Ga-only Borel subgroup. -/
theorem BorelPoint.exists_torus_mul_borelRootUnipotent
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B))
    (g : WithConv (B →ₐ[K] K))
    (hg : g ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K)) :
    ∃ t ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
        (CommAlgCat.of K K),
      ∃ u ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K), t * u = g := by
  obtain ⟨V, n, bV, hρ⟩ := Comodule.exists_coordinateBialgHom_surjective (k := K) (H := B)
  let ρ : GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B :=
    Comodule.coordinateBialgHom (H := B) bV
  obtain ⟨b, hb⟩ := TorusUnipotent.BorelTorusUnipotentFlag.exists_upperTriangular_basis J hJ n ρ
  obtain ⟨χ, hχ⟩ :=
    TorusUnipotent.BorelTorusUnipotentFlag.exists_pointBasisMatrix_diag_characters I J hJI π hker n
      ρ b hb
  obtain ⟨hup, hup', hrel⟩ := borelPoint_upper_and_diagonal_relations I J hJI hI hJ π hπ
    hker hB n ρ b hb χ hχ g hg
  have hne : ∀ k, pointBasisMatrix n ρ b g k k ≠ 0 := by
    intro k h0
    have h1 := upperMatrix_diag_mul_eq_one hup hup' (pointBasisMatrix_mul_inv n ρ b g) k
    rw [h0, zero_mul] at h1
    exact zero_ne_one h1
  let c : Fin n → Kˣ := fun k => Units.mk0 _ (hne k)
  obtain ⟨t₀, ht₀⟩ :=
    TorusUnipotent.BorelTorusUnipotentCharacters.exists_character_values_of_relations χ c (by
      intro m hm
      apply Units.ext
      simp only [Units.coe_prod, Units.val_zpow_eq_zpow_val, Units.val_mk0, Units.val_one, c]
      exact hrel m hm)
  let t : WithConv (B →ₐ[K] K) := AlgHom.mapDomain π t₀
  have htI : t ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
      (CommAlgCat.of K K) := mapDomain_mem_torusPoints I π hπ hker t₀
  have htJ := torusPoints_le_borelPoints I J hJI htI
  have hupt := torusPoint_pointBasisMatrix_upper I J hJI π hker n ρ b hb t₀
  have hupt' : matrixUpperGap 0 (pointBasisMatrix n ρ b t⁻¹) := by
    rw [← map_inv]
    exact torusPoint_pointBasisMatrix_upper I J hJI π hker n ρ b hb t₀⁻¹
  have hdt : ∀ k, pointBasisMatrix n ρ b t k k = pointBasisMatrix n ρ b g k k := by
    intro k
    rw [hχ t₀ k, ht₀ k]
    rfl
  let v := t⁻¹ * g
  have hvJ : v ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K) := mul_mem (inv_mem htJ) hg
  have hPv : pointBasisMatrix n ρ b v =
      pointBasisMatrix n ρ b t⁻¹ * pointBasisMatrix n ρ b g :=
    pointBasisMatrix_mul n ρ b _ _
  have hupv : matrixUpperGap 0 (pointBasisMatrix n ρ b v) := by
    rw [hPv]
    exact matrixUpperGap_mul hupt' hup
  have hdv : ∀ k, pointBasisMatrix n ρ b v k k = 1 := by
    intro k
    rw [hPv, upperMatrix_mul_diag hupt' hup, mul_comm, ← hdt k]
    exact upperMatrix_diag_mul_eq_one hupt hupt' (pointBasisMatrix_mul_inv n ρ b t) k
  have hnil : ((GeneralLinear.pointsMulEquiv n (AlgHom.mapDomain ρ v) :
      Matrix (Fin n) (Fin n) K) - 1) ^ n = 0 :=
    (pointBasisMatrix_sub_one_pow_eq_zero_iff n ρ b v n).mp
      (pow_card_eq_zero_of_matrixUpperGap_one (matrixUpperGap_one_sub_one hupv hdv))
  have hvU := TorusUnipotent.BorelPoint.borelRootUnipotent_of_matrix_unipotent I J hJI hI hJ π hπ
    hker
    hB n ρ hρ v hvJ ⟨n, hnil⟩
  exact ⟨t, htI, v, hvU, mul_inv_cancel_left t g⟩

/-- **`B(K) = T(K) ⋉ U(K)`: unique factorization.** Every `K`-point of the
Borel is uniquely a product `t * u` of a `K`-point `t` of the original
maximal torus and a `K`-point `u` of the Ga-only Borel subgroup. -/
theorem BorelPoint.torus_mul_borelRootUnipotent
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B))
    (g : WithConv (B →ₐ[K] K))
    (hg : g ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K)) :
    ∃! p : CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
        (CommAlgCat.of K K) ×
      CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K),
      (p.1 : WithConv (B →ₐ[K] K)) * p.2 = g := by
  obtain ⟨t, ht, v, hv, htv⟩ :=
    BorelPoint.exists_torus_mul_borelRootUnipotent I J hJI hI hJ π hπ hker hB g hg
  refine ⟨(⟨t, ht⟩, ⟨v, hv⟩), htv, fun p hp => ?_⟩
  apply BorelRootUnipotent.torus_product_injective I J hJ π hπ hker (CommAlgCat.of K K)
  change (p.1 : WithConv (B →ₐ[K] K)) * p.2 = t * v
  rw [hp, htv]

/-- The multiplication map `T(K) × U(K) → B(K)` is a bijection. -/
theorem BorelPoints.torus_mul_borelRootUnipotent_bijective
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    Function.Bijective
      (fun p : CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
          (CommAlgCat.of K K) ×
        CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
          (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) =>
        (⟨(p.1 : WithConv (B →ₐ[K] K)) * p.2,
          mul_mem (torusPoints_le_borelPoints I J hJI p.1.property)
            (borelRootUnipotentPoints_le_borelPoints J π hπ p.2.property)⟩ :
          CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
            (CommAlgCat.of K K))) := by
  refine ⟨fun p q hpq => ?_, fun g => ?_⟩
  · apply BorelRootUnipotent.torus_product_injective I J hJ π hπ hker (CommAlgCat.of K K)
    exact congrArg Subtype.val hpq
  · obtain ⟨t, ht, v, hv, htv⟩ :=
      BorelPoint.exists_torus_mul_borelRootUnipotent I J hJI hI hJ π hπ hker hB g g.property
    exact ⟨(⟨t, ht⟩, ⟨v, hv⟩), Subtype.ext htv⟩

/-- `B(K) = T(K) · U(K)` as sets of `K`-points. -/
theorem BorelPoints.eq_torus_mul_borelRootUnipotent
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
        (CommAlgCat.of K K) : Subgroup (WithConv (B →ₐ[K] K))) :
        Set (WithConv (B →ₐ[K] K))) =
      ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
          (CommAlgCat.of K K) : Subgroup (WithConv (B →ₐ[K] K))) :
          Set (WithConv (B →ₐ[K] K))) *
        ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
          (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) :
            Subgroup (WithConv (B →ₐ[K] K))) : Set (WithConv (B →ₐ[K] K))) := by
  ext g
  constructor
  · intro hg
    obtain ⟨t, ht, v, hv, htv⟩ :=
      BorelPoint.exists_torus_mul_borelRootUnipotent I J hJI hI hJ π hπ hker hB g hg
    exact ⟨t, ht, v, hv, htv⟩
  · rintro ⟨t, ht, v, hv, rfl⟩
    exact mul_mem (torusPoints_le_borelPoints I J hJI ht)
      (borelRootUnipotentPoints_le_borelPoints J π hπ hv)

/-- `B(K)` is the subgroup generated by `T(K)` and `U(K)`. -/
theorem BorelPoints.eq_torus_sup_borelRootUnipotent
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J (CommAlgCat.of K K) =
      CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I (CommAlgCat.of K K) ⊔
        CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
          (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) := by
  apply le_antisymm
  · intro g hg
    obtain ⟨t, ht, v, hv, rfl⟩ :=
      BorelPoint.exists_torus_mul_borelRootUnipotent I J hJI hI hJ π hπ hker hB g hg
    exact mul_mem (Subgroup.mem_sup_left ht) (Subgroup.mem_sup_right hv)
  · exact sup_le (torusPoints_le_borelPoints I J hJI)
      (borelRootUnipotentPoints_le_borelPoints J π hπ)

/-- `U(K)` is normalized by every `K`-point of the Borel. -/
theorem BorelPoint.conj_mem_borelRootUnipotentPoints
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B))
    (p : WithConv (B →ₐ[K] K))
    (hp : p ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K))
    (z : WithConv (B →ₐ[K] K))
    (hz : z ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
      (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K)) :
    p * z * p⁻¹ ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
      (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) := by
  apply (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mpr
  intro a ha
  have hpoint := affineGroupConjugationAlgHom_point p z
  have hzero := (CommHopfAlgCat.mem_quotientPointsSubgroup_iff (CommHopfAlgCat.of K B)
    (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) z).mp hz _
    (BorelRootUnipotentHopfIdeal.borel_point_conjugation I J hJI hI hJ π hπ hker hB p hp a ha)
  have hval := congrArg (fun y : WithConv (B →ₐ[K] K) => y.ofConv a) hpoint
  exact hval.symm.trans hzero

/-- The torus points normalize `U(K)`. -/
theorem TorusPoints.le_normalizer_borelRootUnipotentPoints
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I (CommAlgCat.of K K) ≤
      Subgroup.normalizer ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) :
          Subgroup (WithConv (B →ₐ[K] K))) : Set (WithConv (B →ₐ[K] K))) := by
  intro t ht
  rw [Subgroup.mem_normalizer_iff]
  have htJ := torusPoints_le_borelPoints I J hJI ht
  intro z
  constructor
  · intro hz
    exact BorelPoint.conj_mem_borelRootUnipotentPoints I J hJI hI hJ π hπ hker hB t htJ z hz
  · intro hz
    have h := BorelPoint.conj_mem_borelRootUnipotentPoints I J hJI hI hJ π hπ hker hB
      t⁻¹ (inv_mem htJ) _ hz
    simpa [mul_assoc] using h

/-- `U(K)` is a normal subgroup of `B(K)`. -/
theorem BorelRootUnipotentPoints.subgroupOf_normal
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K)).subgroupOf
      (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
        (CommAlgCat.of K K))).Normal := by
  constructor
  intro z hz p
  rw [Subgroup.mem_subgroupOf] at hz ⊢
  exact BorelPoint.conj_mem_borelRootUnipotentPoints I J hJI hI hJ π hπ hker hB
    p p.property z hz

/-- Inside `B(K)`, the torus points `T(K)` and the unipotent points `U(K)` are
complementary subgroups (`T(K) × U(K) → B(K)` is bijective). -/
theorem TorusPoints.isComplement'_borelRootUnipotentPoints
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
        (CommAlgCat.of K K)).subgroupOf
      (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
        (CommAlgCat.of K K))).IsComplement'
    ((CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K)).subgroupOf
      (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
        (CommAlgCat.of K K))) := by
  apply Subgroup.isComplement'_of_disjoint_and_mul_eq_univ
  · rw [Subgroup.disjoint_def]
    intro x hxT hxU
    rw [Subgroup.mem_subgroupOf] at hxT hxU
    apply Subtype.ext
    exact BorelRootUnipotent.torus_point_intersection_eq_one I J hJ π hπ hker x hxT hxU
  · apply Set.eq_univ_iff_forall.mpr
    intro g
    obtain ⟨t, ht, v, hv, htv⟩ :=
      BorelPoint.exists_torus_mul_borelRootUnipotent I J hJI hI hJ π hπ hker hB g g.property
    refine ⟨⟨t, torusPoints_le_borelPoints I J hJI ht⟩, ?_,
      ⟨v, borelRootUnipotentPoints_le_borelPoints J π hπ hv⟩, ?_, ?_⟩
    · exact Subgroup.mem_subgroupOf.mpr ht
    · exact Subgroup.mem_subgroupOf.mpr hv
    · exact Subtype.ext htv

/-- **`B(K)ᵤ = U(K)`.** In any faithful coordinate representation, a `K`-point
of the Borel lies in the Ga-only subgroup exactly when its matrix is
unipotent. -/
theorem BorelPoint.borelRootUnipotent_iff_matrix_unipotent
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B))
    (n : ℕ) (ρ : GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (hρ : Function.Surjective ρ)
    (g : WithConv (B →ₐ[K] K))
    (hg : g ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K)) :
    g ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K) ↔
      IsNilpotent ((GeneralLinear.pointsMulEquiv n (AlgHom.mapDomain ρ g) :
        Matrix (Fin n) (Fin n) K) - 1) := by
  constructor
  · intro hgU
    exact ⟨n, BorelRootUnipotentPoint.matrix_pow_sub_one_eq_zero J hJ π hπ n ρ g hgU⟩
  · exact TorusUnipotent.BorelPoint.borelRootUnipotent_of_matrix_unipotent
      I J hJI hI hJ π hπ hker hB n ρ hρ g hg

/-- **`B(K) / U(K) ≅ T(K)`.** The quotient of the Borel points by the normal
subgroup of unipotent points is isomorphic to the torus points. -/
noncomputable def borelPointsQuotientTorusEquiv
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    letI := BorelRootUnipotentPoints.subgroupOf_normal I J hJI hI hJ π hπ hker hB
    (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J (CommAlgCat.of K K) ⧸
      (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ) (CommAlgCat.of K K)).subgroupOf
        (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
          (CommAlgCat.of K K))) ≃*
      (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) I
        (CommAlgCat.of K K)).subgroupOf
        (CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
          (CommAlgCat.of K K)) :=
  letI := BorelRootUnipotentPoints.subgroupOf_normal I J hJI hI hJ π hπ hker hB
  (TorusPoints.isComplement'_borelRootUnipotentPoints I J hJI hI hJ π hπ hker hB).QuotientMulEquiv

end ReductiveGroups
