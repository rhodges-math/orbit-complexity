section FlagSubgroup

variable {K' B' ι' : Type*} [Field K'] [CommRing B'] [HopfAlgebra K' B']

/-- The point subgroup of the original group consisting of the points which,
together with their inverses, are upper triangular in the basis `b`, and whose
diagonal satisfies every integral monomial relation among the characters `χ`. -/
def triangularRelationSubgroup (n : ℕ)
    (ρ : GeneralLinear.coordinateHopfAlgebra K' n →ₐc[K'] B')
    (b : Basis (Fin n) K' (Fin n → K'))
    (χ : Fin n → Multiplicative (ι' →₀ ℤ)) :
    Subgroup (WithConv (B' →ₐ[K'] K')) where
  carrier := {g | matrixUpperGap 0 (pointBasisMatrix n ρ b g) ∧
    matrixUpperGap 0 (pointBasisMatrix n ρ b g⁻¹) ∧
    ∀ m : Fin n → ℤ, ∏ k, χ k ^ m k = 1 →
      ∏ k, pointBasisMatrix n ρ b g k k ^ m k = 1}
  one_mem' := by
    refine ⟨?_, ?_, ?_⟩
    · rw [pointBasisMatrix_one]
      exact matrixUpperGap_zero_one
    · rw [inv_one, pointBasisMatrix_one]
      exact matrixUpperGap_zero_one
    · intro m _
      simp [pointBasisMatrix_one]
  mul_mem' := by
    rintro g h ⟨hg, hg', hgr⟩ ⟨hh, hh', hhr⟩
    refine ⟨?_, ?_, ?_⟩
    · rw [pointBasisMatrix_mul]
      exact matrixUpperGap_mul hg hh
    · rw [mul_inv_rev, pointBasisMatrix_mul]
      exact matrixUpperGap_mul hh' hg'
    · intro m hm
      simp only [pointBasisMatrix_mul, upperMatrix_mul_diag hg hh, mul_zpow,
        Finset.prod_mul_distrib, hgr m hm, hhr m hm, mul_one]
  inv_mem' := by
    rintro g ⟨hg, hg', hgr⟩
    refine ⟨hg', by simpa only [inv_inv] using hg, ?_⟩
    intro m hm
    have hdiag (k : Fin n) : pointBasisMatrix n ρ b g⁻¹ k k =
        (pointBasisMatrix n ρ b g k k)⁻¹ :=
      (eq_inv_of_mul_eq_one_right (upperMatrix_diag_mul_eq_one hg hg'
        (pointBasisMatrix_mul_inv n ρ b g) k))
    simp only [hdiag, inv_zpow', zpow_neg, Finset.prod_inv_distrib, hgr m hm, inv_one]

end FlagSubgroup

/-- The subgroup of `K`-points generated by the torus and
the Borel root Ga maps is contained in the triangular relation subgroup. -/
theorem BorelGeneratedPointSubgroup.le_triangularRelationSubgroup
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (n : ℕ) (ρ : GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (b : Basis (Fin n) K (Fin n → K))
    (hb : ∀ d ∈ (derivationCompLieHom (B := K)
        (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B) J).hom).range,
      matrixUpperGap 0 (matrixBasisConj b (affineGroupMatrixDifferential n ρ d)))
    (χ : Fin n → M)
    (hχ : ∀ (t : WithConv (MonoidAlgebra K M →ₐ[K] K)) (k : Fin n),
      pointBasisMatrix n ρ b (AlgHom.mapDomain π t) k k =
        t.ofConv (MonoidAlgebra.single (χ k) 1)) :
    connectedGeneratedPointSubgroup (CommHopfAlgCat.of K B)
        (borelRootGeneratorCodomain J π) (borelRootGeneratorFamily J π hπ) ≤
      triangularRelationSubgroup n ρ b χ := by
  let _ := fun j => borelRootGeneratorCodomain_finiteType J π hπ j
  let _ := fun j => borelRootGeneratorCodomain_isDomain J π j
  let _ : ∀ j, IsReduced (borelRootGeneratorCodomain J π j) := fun _ => inferInstance
  rw [connectedGeneratedPointSubgroup, Subgroup.closure_le]
  intro x hx
  obtain ⟨j, p, rfl⟩ := Set.mem_iUnion.mp hx
  cases j with
  | none =>
      change WithConv (MonoidAlgebra K M →ₐ[K] K) at p
      change AlgHom.mapDomain π p ∈ triangularRelationSubgroup n ρ b χ
      refine ⟨torusPoint_pointBasisMatrix_upper I J hJI π hker n ρ b hb p, ?_, ?_⟩
      · rw [← map_inv]
        exact torusPoint_pointBasisMatrix_upper I J hJI π hker n ρ b hb p⁻¹
      · intro m hm
        simp only [hχ]
        rw [← torusPoint_apply_prod_zpow, hm, ← MonoidAlgebra.one_def, map_one]
  | some r =>
      obtain ⟨t, rfl⟩ :=
        (AdditiveGroup.gaPointsMulEquiv (R := K) (A := K)).symm.surjective p
      change gaAffineGroupPoints (borelRootVectorGa J π hπ r)
        (Multiplicative.ofAdd (Multiplicative.toAdd t)) ∈ triangularRelationSubgroup n ρ b χ
      have hup := rootGaPoint_pointBasisMatrix_upper J π hπ n ρ b hb r (Multiplicative.toAdd t)
      refine ⟨hup, ?_, ?_⟩
      · rw [← map_inv, ← ofAdd_neg]
        exact rootGaPoint_pointBasisMatrix_upper J π hπ n ρ b hb r _
      · intro m _
        have hdiag (k : Fin n) := TorusUnipotent.BorelRootUnipotentPoint.pointBasisMatrix_diag J hJ
          π hπ n ρ b
          _ (rootGaPoint_mem_borelRootUnipotent J π hπ r (Multiplicative.toAdd t)) hup k
        simp only [hdiag, one_zpow, Finset.prod_const_one]

/-- The polynomial expression of one monomial relation in the diagonal
coordinate functions. -/
def diagonalRelationFunction {K' B' : Type*} [Field K'] [CommRing B'] [HopfAlgebra K' B']
    (n : ℕ) (ρ : GeneralLinear.coordinateHopfAlgebra K' n →ₐc[K'] B')
    (b : Basis (Fin n) K' (Fin n → K')) (m : Fin n → ℤ) : B' :=
  ∏ k, pointBasisEntry n ρ b k k ^ (m k).toNat -
    ∏ k, pointBasisEntry n ρ b k k ^ (-m k).toNat

/-- The equality is

```lean
g.ofConv (diagonalRelationFunction n ρ b m) =
      ∏ k, pointBasisMatrix n ρ b g k k ^ (m k).toNat -
        ∏ k, pointBasisMatrix n ρ b g k k ^ (-m k).toNat
```
-/
theorem diagonalRelationFunction_apply {K' B' : Type*} [Field K'] [CommRing B']
    [HopfAlgebra K' B']
    (n : ℕ) (ρ : GeneralLinear.coordinateHopfAlgebra K' n →ₐc[K'] B')
    (b : Basis (Fin n) K' (Fin n → K')) (m : Fin n → ℤ) (g : WithConv (B' →ₐ[K'] K')) :
    g.ofConv (diagonalRelationFunction n ρ b m) =
      ∏ k, pointBasisMatrix n ρ b g k k ^ (m k).toNat -
        ∏ k, pointBasisMatrix n ρ b g k k ^ (-m k).toNat := by
  simp only [diagonalRelationFunction, map_sub, map_prod, map_pow, pointBasisEntry_apply]

/-- **Triangularization of the Borel `K`-points.** In a triangular
basis of the Borel tangent, every `K`-point of the Borel is
upper triangular, and its diagonal satisfies every integral monomial relation
among the diagonal torus characters. -/
theorem borelPoint_upper_and_diagonal_relations
    [Finite ι]
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B))
    (n : ℕ) (ρ : GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (b : Basis (Fin n) K (Fin n → K))
    (hb : ∀ d ∈ (derivationCompLieHom (B := K)
        (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B) J).hom).range,
      matrixUpperGap 0 (matrixBasisConj b (affineGroupMatrixDifferential n ρ d)))
    (χ : Fin n → M)
    (hχ : ∀ (t : WithConv (MonoidAlgebra K M →ₐ[K] K)) (k : Fin n),
      pointBasisMatrix n ρ b (AlgHom.mapDomain π t) k k =
        t.ofConv (MonoidAlgebra.single (χ k) 1))
    (g : WithConv (B →ₐ[K] K))
    (hg : g ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K)) :
    g ∈ triangularRelationSubgroup n ρ b χ := by
  let _ := fun j => borelRootGeneratorCodomain_finiteType J π hπ j
  let _ := fun j => borelRootGeneratorCodomain_isDomain J π j
  let _ : ∀ j, IsReduced (borelRootGeneratorCodomain J π j) := fun _ => inferInstance
  let Γ := connectedGeneratedPointSubgroup (CommHopfAlgCat.of K B)
    (borelRootGeneratorCodomain J π) (borelRootGeneratorFamily J π hπ)
  have hJΓ : J = HopfIdeal.vanishingIdeal Γ := by
    rw [← borel_commonKernelRootGenerators_eq I J hJI hI hJ π hπ hker hB]
    exact CommonKernelHopfIdeal.eq_generated_vanishingIdeal _ _ _
  have hΓ := TorusUnipotent.BorelGeneratedPointSubgroup.le_triangularRelationSubgroup I J hJI hJ π
    hπ hker
    n ρ b hb χ hχ
  have hmemJ : ∀ x : B, (∀ γ ∈ triangularRelationSubgroup n ρ b χ, γ.ofConv x = 0) →
      g.ofConv x = 0 := by
    intro x hx
    have hxJ : x ∈ J := by
      rw [hJΓ, HopfIdeal.mem_vanishingIdeal]
      intro γ
      exact hx γ.val (hΓ γ.property)
    exact (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mp hg x hxJ
  have hginv : g⁻¹ ∈ CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K B) J
      (CommAlgCat.of K K) := inv_mem hg
  have hmemJ' : ∀ x : B, (∀ γ ∈ triangularRelationSubgroup n ρ b χ, γ.ofConv x = 0) →
      g⁻¹.ofConv x = 0 := by
    intro x hx
    have hxJ : x ∈ J := by
      rw [hJΓ, HopfIdeal.mem_vanishingIdeal]
      intro γ
      exact hx γ.val (hΓ γ.property)
    exact (CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _).mp hginv x hxJ
  have hupper : ∀ h : WithConv (B →ₐ[K] K),
      (∀ x : B, (∀ γ ∈ triangularRelationSubgroup n ρ b χ, γ.ofConv x = 0) →
        h.ofConv x = 0) → matrixUpperGap 0 (pointBasisMatrix n ρ b h) := by
    intro h hh i j hij
    rw [← pointBasisEntry_apply]
    apply hh
    intro γ hγ
    rw [pointBasisEntry_apply]
    exact hγ.1 i j hij
  have hup := hupper g hmemJ
  have hup' := hupper g⁻¹ hmemJ'
  refine ⟨hup, hup', ?_⟩
  intro m hm
  have hne : ∀ k, pointBasisMatrix n ρ b g k k ≠ 0 := by
    intro k h0
    have h1 := upperMatrix_diag_mul_eq_one hup hup' (pointBasisMatrix_mul_inv n ρ b g) k
    rw [h0, zero_mul] at h1
    exact zero_ne_one h1
  rw [prod_zpow_eq_one_iff _ hne]
  have hrel := hmemJ (diagonalRelationFunction n ρ b m) (by
    intro γ hγ
    rw [diagonalRelationFunction_apply, sub_eq_zero]
    have hneγ : ∀ k, pointBasisMatrix n ρ b γ k k ≠ 0 := by
      intro k h0
      have h1 := upperMatrix_diag_mul_eq_one hγ.1 hγ.2.1 (pointBasisMatrix_mul_inv n ρ b γ) k
      rw [h0, zero_mul] at h1
      exact zero_ne_one h1
    exact (prod_zpow_eq_one_iff _ hneγ m).mp (hγ.2.2 m hm))
  rw [diagonalRelationFunction_apply] at hrel
  exact sub_eq_zero.mp hrel

end TorusUnipotent
