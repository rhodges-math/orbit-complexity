import OrbitComplexity.ReductiveGroups.Groups.Additive.GaAffineGroupPoints
import OrbitComplexity.ReductiveGroups.Groups.GaCoordinates.GaPolynomialCoordinate
import TauCeti.Algebra.AlgebraicGroup.Connected.AlgebraicallyClosed

/-!
# Ga Translation Idempotents

Translation by a point on an additive one-parameter subgroup fixes
idempotent functions. This is the connectedness input for the subgroup
generated by such curves; it does not assume connectedness of that subgroup. -/

noncomputable section
namespace ReductiveGroups
open WithConv

universe u
variable {K B : Type u} [Field K] [CommRing B] [HopfAlgebra K B]

/-- Evaluation of the polynomial-valued Ga path recovers its point. -/
theorem gaPolynomialPath_eval
    (φ : B →ₐc[K] SymmetricAlgebra K K) (t : K) :
    TauCeti.AlgHom.mapValue (H := B) (Polynomial.aeval t)
      (toConv ((gaPolynomialEquiv K).toAlgHom.comp φ.toAlgHom)) =
        gaAffineGroupPoints φ (Multiplicative.ofAdd t) := by
  apply WithConv.ofConv_injective
  ext b
  change (gaPolynomialEquiv K (φ b)).eval t = _
  exact gaPolynomialEquiv_eval_point K t (φ b)

/-- An idempotent is unchanged under translation along a Ga curve. -/
theorem GaPoint.rightTranslation_fixes_idempotent
    [IsAlgClosed K] [Algebra.FiniteType K B]
    (φ : B →ₐc[K] SymmetricAlgebra K K) (t : K)
    (e : B) (he : IsIdempotentElem e) :
    TauCeti.HopfAlgebra.rightTranslationAlgHom
      (gaAffineGroupPoints φ (Multiplicative.ofAdd t)) e = e := by
  apply TauCeti.HopfAlgebra.rightTranslationAlgHom_eq_self_of_path e he
    (gaAffineGroupPoints φ (Multiplicative.ofAdd t))
    (toConv ((gaPolynomialEquiv K).toAlgHom.comp φ.toAlgHom))
    (Polynomial.aeval t) (Polynomial.aeval (0 : K))
  · exact gaPolynomialPath_eval φ t
  · rw [gaPolynomialPath_eval]
    exact map_one (gaAffineGroupPoints φ)

end ReductiveGroups
