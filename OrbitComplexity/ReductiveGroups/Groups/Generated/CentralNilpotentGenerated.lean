import OrbitComplexity.ReductiveGroups.Groups.Reductive.CentralNilpotentAdjoint
import OrbitComplexity.ReductiveGroups.Groups.Representations.AffineGroupRootIntegration
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedTangentCriterion
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedConjugation
import OrbitComplexity.ReductiveGroups.Groups.Representations.AffineGroupConjugationMorphism
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedConnected
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedSmooth
import OrbitComplexity.ReductiveGroups.Groups.Hopf.ReducedPointNormality

/-!
# Central Nilpotent Generated

The subgroup generated by all central nilpotent tangents in a
fixed faithful matrix representation. Its unipotence is
`Groups/CentralNilpotentUnipotence.lean`. -/

noncomputable section
namespace ReductiveGroups

universe u
variable {K B : Type u} [Field K] [CharZero K] [CommRing B] [HopfAlgebra K B]
variable (n : ℕ) (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
  (hρ : Function.Surjective ρ)

local notation "𝔤" => Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

/-- Integrate a member of the whole central-nilpotent ideal inside the
original affine group. -/
def centralNilpotentGaMorphism
    (d : centralNilpotentIdeal (affineGroupMatrixDifferential n ρ)) :
    B →ₐc[K] SymmetricAlgebra K K :=
  Classical.choose (AffineGroupRootIntegration.existsUnique_of_matrix_tangent_nilpotent
    n ρ hρ (d : 𝔤) d.property.2)

/-- The equality is

```lean
gaAffineGroupTangent (centralNilpotentGaMorphism n ρ hρ d) = (d : 𝔤)
```
-/
@[simp] theorem centralNilpotentGaMorphism_tangent
    (d : centralNilpotentIdeal (affineGroupMatrixDifferential n ρ)) :
    gaAffineGroupTangent (centralNilpotentGaMorphism n ρ hρ d) = (d : 𝔤) :=
  (Classical.choose_spec (AffineGroupRootIntegration.existsUnique_of_matrix_tangent_nilpotent
    n ρ hρ (d : 𝔤) d.property.2)).1

/-- The defining Hopf ideal of the subgroup generated by this family. -/
def centralNilpotentGeneratedHopfIdeal : TauCeti.HopfIdeal K B :=
  gaGeneratedHopfIdeal (centralNilpotentGaMorphism n ρ hρ)

/-- The equivalence is

```lean
centralNilpotentGeneratedHopfIdeal n ρ hρ = TauCeti.HopfIdeal.augmentation K B ↔
      centralNilpotentIdeal (affineGroupMatrixDifferential n ρ) = ⊥
```
-/
theorem CentralNilpotentGenerated.eq_augmentation_iff :
    centralNilpotentGeneratedHopfIdeal n ρ hρ = TauCeti.HopfIdeal.augmentation K B ↔
      centralNilpotentIdeal (affineGroupMatrixDifferential n ρ) = ⊥ := by
  have h := gaGeneratedHopfIdeal_eq_augmentation_iff (centralNilpotentGaMorphism n ρ hρ)
  constructor
  · intro hJ
    apply le_antisymm _ bot_le
    intro d hd
    change d = 0
    simpa only [centralNilpotentGaMorphism_tangent] using h.mp hJ ⟨d, hd⟩
  · intro hI
    apply h.mpr
    intro d
    have hd : (d : 𝔤) = 0 := by
      simpa only [hI, LieSubmodule.mem_bot] using d.property
    simpa only [centralNilpotentGaMorphism_tangent] using hd

/-- Point conjugation preserves the defining ideal because it permutes
the entire family of generating tangents. -/
theorem CentralNilpotentGenerated.point_conjugation
    (g : WithConv (B →ₐ[K] K)) (b : B)
    (hb : b ∈ centralNilpotentGeneratedHopfIdeal n ρ hρ) :
    affineGroupConjugationBialgHom g b ∈ centralNilpotentGeneratedHopfIdeal n ρ hρ := by
  apply GaGeneratedHopfIdeal.stable_of_tangent_closed (centralNilpotentGaMorphism n ρ hρ)
    (affineGroupConjugationBialgHom g)
    (affineGroupConjugationBialgEquiv g).surjective ?_ b hb
  intro d
  refine ⟨⟨affineGroupAdjointRepresentation g d,
    affineGroupAdjoint_centralNilpotentIdeal n ρ g d d.property⟩, ?_⟩
  simp only [centralNilpotentGaMorphism_tangent]
  exact DerivationComp.conjugation g d

variable [IsAlgClosed K] [Algebra.FiniteType K B]

/-- For these parameters,

```lean
TauCeti.geometricallyConnectedCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ))
```
-/
theorem CentralNilpotentGenerated.geometrically_connected :
    TauCeti.geometricallyConnectedCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ)) :=
  GaGeneratedQuotient.geometrically_connected _

/-- For these parameters,

```lean
TauCeti.smoothCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ))
```
-/
theorem centralNilpotentGenerated_smooth :
    TauCeti.smoothCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ)) :=
  gaGeneratedQuotient_smooth _

/-- Reduced point separation upgrades point conjugation stability to
scheme-level normality of this closed subgroup. -/
theorem centralNilpotentGenerated_isNormal [IsReduced B] :
    (centralNilpotentGeneratedHopfIdeal n ρ hρ).IsNormal := by
  have hred : IsReduced (B ⧸ (centralNilpotentGeneratedHopfIdeal n ρ hρ).toIdeal) := by
    change IsReduced (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
      (gaGeneratedHopfIdeal (centralNilpotentGaMorphism n ρ hρ)))
    infer_instance
  apply isNormal_of_point_conjugation_stable
  intro g b hb
  exact CentralNilpotentGenerated.point_conjugation n ρ hρ g b hb

end ReductiveGroups
