import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedPointClosure
import OrbitComplexity.ReductiveGroups.Groups.GaCoordinates.GaTranslationIdempotents

/-!
# Ga Generated Connected

The closed subgroup generated by any family of additive
one-parameter groups is connected. The proof uses translation stabilizers
of idempotents and the already proved point-closure dictionary. -/

noncomputable section
namespace ReductiveGroups
open WithConv

universe u v
variable {K B : Type u} [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B] {ι : Type v}

omit [CharZero K] [IsAlgClosed K] [Algebra.FiniteType K B] in
private theorem gaGeneratedLift_points
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) (i : ι) (t : Multiplicative K) :
    TauCeti.AlgHom.mapDomain
      (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal f)).hom
      (gaAffineGroupPoints (gaGeneratedLift f i) t) = gaAffineGroupPoints (f i) t := by
  simp only [gaAffineGroupPoints, MonoidHom.comp_apply]
  rw [← MonoidHom.comp_apply, ← TauCeti.AlgHom.mapDomain_comp, gaGeneratedLift_comp]

/-- The Ga-generated Hopf quotient has connected prime spectrum. This
includes an empty family, whose quotient is the identity subgroup. -/
theorem gaGeneratedQuotient_connected
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    ConnectedSpace (PrimeSpectrum (TauCeti.CommHopfAlgCat.quotient
      (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f))) := by
  let Q := TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
    (gaGeneratedHopfIdeal f)
  let q : B →ₐc[K] Q := (TauCeti.CommHopfAlgCat.mkQuotient
    (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f)).hom
  let _ : Nontrivial Q := Bialgebra.nontrivial (A := Q) K
  apply TauCeti.connectedSpace_primeSpectrum_iff_idempotent_eq_zero_or_one.mpr
  intro e he
  have hS : gaGeneratedPointSubgroup f ≤
      (TauCeti.HopfAlgebra.rightTranslationStabilizer e).map
        (TauCeti.AlgHom.mapDomain q) := by
    rw [gaGeneratedPointSubgroup, Subgroup.closure_le]
    intro g hg
    obtain ⟨i, t, rfl⟩ := Set.mem_iUnion.mp hg
    refine ⟨gaAffineGroupPoints (gaGeneratedLift f i) t, ?_, ?_⟩
    · apply TauCeti.HopfAlgebra.mem_rightTranslationStabilizer.mpr
      exact GaPoint.rightTranslation_fixes_idempotent (gaGeneratedLift f i) t.toAdd e he
    · exact gaGeneratedLift_points f i t
  obtain ⟨b, hb⟩ := TauCeti.CommHopfAlgCat.mkQuotient_surjective
    (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f) e
  have hval (s : gaGeneratedPointSubgroup f) :
      s.val.ofConv b = Coalgebra.counit (R := K) e := by
    obtain ⟨x, hx, hs⟩ := hS s.property
    have hfix := TauCeti.HopfAlgebra.mem_rightTranslationStabilizer.mp hx
    have hxval := congrArg (fun a : Q →ₐ[K] K => a e)
      (TauCeti.HopfAlgebra.counitAlgHom_comp_rightTranslationAlgHom x)
    simp only [AlgHom.comp_apply, hfix, Bialgebra.counitAlgHom_apply] at hxval
    have hsval := congrArg (fun p : WithConv (B →ₐ[K] K) => p.ofConv b) hs
    change x.ofConv (q b) = s.val.ofConv b at hsval
    rw [hb] at hsval
    exact hsval.symm.trans hxval.symm
  have hvan : b - algebraMap K B (Coalgebra.counit (R := K) e) ∈
      gaGeneratedHopfIdeal f := by
    apply (gaGeneratedHopfIdeal_eq_vanishingIdeal f).symm.le
    rw [TauCeti.HopfIdeal.mem_vanishingIdeal]
    intro s
    rw [map_sub, AlgHom.commutes, hval]
    simp
  have hz : q (b - algebraMap K B (Coalgebra.counit (R := K) e)) = 0 :=
    (TauCeti.CommHopfAlgCat.mkQuotient_eq_zero_iff
      (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f) _).mpr hvan
  have heq : e = algebraMap K Q (Coalgebra.counit (R := K) e) := by
    have hb' : q b = e := hb
    have hcomm : q (algebraMap K B (Coalgebra.counit (R := K) e)) =
        algebraMap K Q (Coalgebra.counit (R := K) e) := q.toAlgHom.commutes _
    rw [map_sub, hcomm, hb'] at hz
    exact sub_eq_zero.mp hz
  rcases IsIdempotentElem.iff_eq_zero_or_one.mp
    (he.map (Bialgebra.counitAlgHom K Q)) with hzero | hone
  · left
    exact heq.trans (by rw [show Coalgebra.counit (R := K) e = 0 from hzero, map_zero])
  · right
    exact heq.trans (by rw [show Coalgebra.counit (R := K) e = 1 from hone, map_one])

/-- Over the algebraically closed ground field this connectedness is
geometric connectedness of the same original Hopf quotient. -/
theorem GaGeneratedQuotient.geometrically_connected
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    TauCeti.geometricallyConnectedCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal f)) :=
  (TauCeti.geometricallyConnectedCommHopfAlgProperty_iff_connectedSpace K _).mpr
    (gaGeneratedQuotient_connected f)

end ReductiveGroups
