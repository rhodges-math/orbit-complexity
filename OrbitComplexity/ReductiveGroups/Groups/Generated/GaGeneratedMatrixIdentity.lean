import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedPointClosure
import OrbitComplexity.ReductiveGroups.Groups.Additive.GaAffineGroupPoints

/-!
# Ga Generated Matrix Identity

Uniform matrix identities extend from the subgroup generated by the
Ga points to every algebra-valued point of its closed subgroup. -/

noncomputable section
namespace ReductiveGroups
open WithConv

universe u v w
variable {K B : Type u} [Field K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] {ι : Type v}

omit [CharZero K] in
private theorem genericMatrix_map_point (n : ℕ)
    (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    {A : Type w} [CommRing A] [Algebra K A] (g : WithConv (B →ₐ[K] A)) :
    g.ofConv.mapMatrix (ρ.toAlgHom.mapMatrix
      (TauCeti.GeneralLinear.genericMatrix K n)) =
      (TauCeti.GeneralLinear.pointsMulEquiv n (TauCeti.AlgHom.mapDomain ρ g) :
        Matrix (Fin n) (Fin n) A) := by
  exact TauCeti.GeneralLinear.map_genericMatrix_eq_coe_pointToGeneralLinear n
    (g.ofConv.comp ρ.toAlgHom)

/-- A uniform power identity on all generated ground-field points holds
on every algebra-valued point of the generated Hopf quotient. In particular,
this extends unipotence identities without interchanging an unbounded
nilpotence exponent with closure. -/
theorem GaGeneratedQuotient.matrix_pow_sub_one_eq_zero
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) (n : ℕ)
    (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B) (N : ℕ)
    (hN : ∀ g : gaGeneratedPointSubgroup f,
      ((TauCeti.GeneralLinear.pointsMulEquiv n
        (TauCeti.AlgHom.mapDomain ρ g.val) : Matrix (Fin n) (Fin n) K) - 1) ^ N = 0)
    {A : Type w} [CommRing A] [Algebra K A]
    (g : WithConv ((TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
      (gaGeneratedHopfIdeal f)) →ₐ[K] A)) :
    ((TauCeti.GeneralLinear.pointsMulEquiv n (TauCeti.AlgHom.mapDomain
      ((TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal f)).hom.comp ρ) g) :
          Matrix (Fin n) (Fin n) A) - 1) ^ N = 0 := by
  let U : Matrix (Fin n) (Fin n) B :=
    ρ.toAlgHom.mapMatrix (TauCeti.GeneralLinear.genericMatrix K n)
  let q := (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
    (gaGeneratedHopfIdeal f)).hom
  have hentry (i j : Fin n) : ((U - 1) ^ N) i j ∈ gaGeneratedHopfIdeal f := by
    apply (gaGeneratedHopfIdeal_eq_vanishingIdeal f).symm.le
    rw [TauCeti.HopfIdeal.mem_vanishingIdeal]
    intro s
    have h := hN s
    rw [← genericMatrix_map_point n ρ s.val] at h
    have hm : s.val.ofConv.mapMatrix ((U - 1) ^ N) = 0 := by
      simpa only [map_pow, map_sub, map_one, U] using h
    exact congrFun (congrFun hm i) j
  have hq : q.toAlgHom.mapMatrix ((U - 1) ^ N) = 0 := by
    ext i j
    exact (TauCeti.CommHopfAlgCat.mkQuotient_eq_zero_iff
      (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f) _).mpr (hentry i j)
  have hg := congrArg g.ofConv.mapMatrix hq
  rw [← genericMatrix_map_point n (q.comp ρ) g]
  change (g.ofConv.mapMatrix (q.toAlgHom.mapMatrix U) - 1) ^ N = 0
  simpa only [map_zero, map_pow, map_sub, map_one] using hg

end ReductiveGroups
