import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedTangentCriterion
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Vanishing
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.CommonKernel

/-!
# Ga Generated Point Closure

The Ga-generated subgroup is the reduced point closure of the subgroup
generated by its ordinary-point images. -/

noncomputable section
namespace ReductiveGroups
open WithConv

universe u v
variable {K B : Type u} [Field K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] {ι : Type v}

/-- The subgroup of original group points generated by every point of every
member of a family of additive-group morphisms. -/
def gaGeneratedPointSubgroup
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    Subgroup (WithConv (B →ₐ[K] K)) :=
  Subgroup.closure (⋃ i, Set.range (gaAffineGroupPoints (f i)))

/-- The generated Hopf ideal is exactly the ideal of functions vanishing on
the subgroup generated by the images on `K`-points. The polynomial
identity principle is used in the direction from point vanishing to the
coordinate Ga morphisms. -/
theorem gaGeneratedHopfIdeal_eq_vanishingIdeal
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    gaGeneratedHopfIdeal f =
      TauCeti.HopfIdeal.vanishingIdeal (gaGeneratedPointSubgroup f) := by
  apply le_antisymm
  · apply (TauCeti.HopfIdeal.le_vanishingIdeal_iff (gaGeneratedPointSubgroup f)
      (gaGeneratedHopfIdeal f)).mpr
    rw [gaGeneratedPointSubgroup, Subgroup.closure_le]
    intro g hg
    obtain ⟨i, t, rfl⟩ := Set.mem_iUnion.mp hg
    apply (TauCeti.CommHopfAlgCat.mem_quotientPointsSubgroup_iff
      (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f) (CommAlgCat.of K K) _).mpr
    intro b hb
    have hkill : f i b = 0 :=
      (gaMorphism_kills_hopfIdeal_iff (f i) (gaGeneratedHopfIdeal f)).mpr
        (fun c hc => gaGenerated_tangent_eq_zero_on_ideal f i c hc) b hb
    change ((TauCeti.AdditiveGroup.gaPointsMulEquiv (R := K) (A := K)).symm t).ofConv
      (f i b) = 0
    rw [hkill, map_zero]
  · apply (le_gaGeneratedHopfIdeal_iff_tangents f
      (TauCeti.HopfIdeal.vanishingIdeal (gaGeneratedPointSubgroup f))).mpr
    intro i b hb
    have hkill : ∀ c ∈ TauCeti.HopfIdeal.vanishingIdeal (gaGeneratedPointSubgroup f),
        f i c = 0 := by
      intro c hc
      apply (gaPolynomialEquiv K).injective
      have hpoly : gaPolynomialEquiv K (f i c) = 0 := by
        apply Polynomial.zero_of_eval_zero
        intro t
        rw [gaPolynomialEquiv_eval_point]
        have hpoint : gaAffineGroupPoints (f i) (Multiplicative.ofAdd t) ∈
            gaGeneratedPointSubgroup f := by
          apply Subgroup.subset_closure
          exact Set.mem_iUnion.mpr ⟨i, Set.mem_range_self _⟩
        exact (TauCeti.HopfIdeal.mem_vanishingIdeal (gaGeneratedPointSubgroup f) c).mp
          hc ⟨gaAffineGroupPoints (f i) (Multiplicative.ofAdd t), hpoint⟩
      simpa using hpoly
    exact (gaMorphism_kills_hopfIdeal_iff (f i)
      (TauCeti.HopfIdeal.vanishingIdeal (gaGeneratedPointSubgroup f))).mp hkill b hb

/-- The Ga-generated quotient is reduced, including for an empty
index type. -/
instance gaGeneratedQuotient_isReduced
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    IsReduced (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
      (gaGeneratedHopfIdeal f)) := by
  rw [gaGeneratedHopfIdeal_eq_vanishingIdeal]
  infer_instance

end ReductiveGroups
