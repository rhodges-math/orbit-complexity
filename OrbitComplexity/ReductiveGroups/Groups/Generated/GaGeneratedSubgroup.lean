import OrbitComplexity.ReductiveGroups.Groups.GaCoordinates.GaTangentDeterminesMorphism
import OrbitComplexity.ReductiveGroups.Groups.Additive.GaClosedImmersion
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Basic
import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Augmentation

/-!
# Ga Generated Subgroup

The closed subgroup generated by a family of additive-group
morphisms. Its coordinate ideal is the largest Hopf ideal killed by every
member, not the possibly non-Hopf intersection of their ring kernels.
We prove tangent containment and an exact triviality test.  -/

noncomputable section
namespace ReductiveGroups
open CategoryTheory

universe u v
variable {K B : Type u} [Field K] [CommRing B] [HopfAlgebra K B]
  {ι : Type v}

/-- Defining ideal of the closed subgroup generated by the specified Ga maps. -/
def gaGeneratedHopfIdeal (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    TauCeti.HopfIdeal K B :=
  TauCeti.CommHopfAlgCat.commonKernelHopfIdeal
    (fun i => CommHopfAlgCat.ofHom (f i))

/-- Every generator factors through the generated subgroup quotient. -/
def gaGeneratedLift (f : ι → B →ₐc[K] SymmetricAlgebra K K) (i : ι) :
    TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
      (gaGeneratedHopfIdeal f) →ₐc[K] SymmetricAlgebra K K :=
  (TauCeti.CommHopfAlgCat.commonKernelLift
    (fun j => CommHopfAlgCat.ofHom (f j)) i).hom

/-- The equality is

```lean
(gaGeneratedLift f i).comp
      (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal f)).hom = f i
```
-/
theorem gaGeneratedLift_comp (f : ι → B →ₐc[K] SymmetricAlgebra K K) (i : ι) :
    (gaGeneratedLift f i).comp
      (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal f)).hom = f i :=
  congrArg (fun g => g.hom)
    (TauCeti.CommHopfAlgCat.mkQuotient_comp_commonKernelLift
      (fun j => CommHopfAlgCat.ofHom (f j)) i)

/-- The generated subgroup's tangent contains the tangent of each generator. -/
theorem gaGenerated_tangent_mem_range
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) (i : ι) :
    gaAffineGroupTangent (f i) ∈
      (TauCeti.derivationCompLieHom (B := K)
        (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
          (gaGeneratedHopfIdeal f)).hom).range := by
  refine ⟨gaAffineGroupTangent (gaGeneratedLift f i), ?_⟩
  change TauCeti.derivationComp (B := K) _
    (TauCeti.derivationComp (B := K) _ (gaOriginDerivation K)) = _
  rw [← LinearMap.comp_apply, ← TauCeti.derivationComp_comp,
    gaGeneratedLift_comp]
  rfl

/-- Each generating tangent annihilates the generated subgroup's ideal. -/
theorem gaGenerated_tangent_eq_zero_on_ideal
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) (i : ι)
    (b : B) (hb : b ∈ gaGeneratedHopfIdeal f) :
    gaAffineGroupTangent (f i) b = 0 := by
  have hf : f i b = 0 :=
    TauCeti.CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
      (fun j => CommHopfAlgCat.ofHom (f j)) i hb
  apply (TauCeti.Bialgebra.CounitAlgebra.algEquivSelf K B K).injective
  rw [map_zero, gaAffineGroupTangent, gaOriginDerivation_comp_apply, hf,
    map_zero, Polynomial.coeff_zero]

/-- A nonzero tangent makes the corresponding generator a closed immersion
also into the generated subgroup. -/
theorem gaGeneratedLift_surjective [CharZero K]
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) (i : ι)
    (hi : gaAffineGroupTangent (f i) ≠ 0) :
    Function.Surjective (gaGeneratedLift f i) :=
  TauCeti.CommHopfAlgCat.commonKernelLift_surjective_of_surjective
    (fun j => CommHopfAlgCat.ofHom (f j)) i
    (gaMorphism_surjective_of_tangent_ne_zero (f i) hi)

/-- A tangent annihilating the entire augmentation ideal is zero. -/
theorem tangent_eq_zero_of_augmentation
    (d : Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K))
    (hd : ∀ b ∈ TauCeti.HopfIdeal.augmentation K B, d b = 0) : d = 0 := by
  ext b
  have hb : b - algebraMap K B (Coalgebra.counit (R := K) b) ∈
      TauCeti.HopfIdeal.augmentation K B := by
    rw [TauCeti.HopfIdeal.mem_augmentation, map_sub]
    simp
  have h := hd _ hb
  simpa using h

/-- The generated closed subgroup is trivial exactly when every generating
tangent vanishes. Characteristic zero is needed for this converse. -/
theorem gaGeneratedHopfIdeal_eq_augmentation_iff [CharZero K]
    (f : ι → B →ₐc[K] SymmetricAlgebra K K) :
    gaGeneratedHopfIdeal f = TauCeti.HopfIdeal.augmentation K B ↔
      ∀ i, gaAffineGroupTangent (f i) = 0 := by
  constructor
  · intro h i
    apply tangent_eq_zero_of_augmentation
    intro b hb
    apply gaGenerated_tangent_eq_zero_on_ideal f i b
    rwa [h]
  · intro h
    apply le_antisymm (TauCeti.HopfIdeal.le_augmentation K B _)
    apply (TauCeti.CommHopfAlgCat.le_commonKernelHopfIdeal_iff
      (fun j => CommHopfAlgCat.ofHom (f j))
      (TauCeti.HopfIdeal.augmentation K B)).mpr
    intro i b hb
    change f i b = 0
    apply GaMorphism.kills_kernel_of_tangent_factors
      (Bialgebra.counitBialgHom K B) (f i) 0
    · simpa using h i
    · exact (TauCeti.HopfIdeal.mem_augmentation K B).mp hb

end ReductiveGroups
