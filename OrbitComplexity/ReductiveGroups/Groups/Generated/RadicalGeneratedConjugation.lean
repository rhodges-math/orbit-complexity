import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedConjugation
import OrbitComplexity.ReductiveGroups.Groups.Representations.AffineGroupConjugationMorphism
import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedSubgroup

/-!
# Radical Generated Conjugation

Every field-valued point preserves the Hopf ideal generated by
the integrated derived radical. This is pointwise invariance of the ideal;
normality of the generated subgroup is `Groups/RadicalGeneratedNormality.lean`. -/

noncomputable section
namespace ReductiveGroups

universe u
variable (K B : Type u) [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

private abbrev tangent :=
  Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

/-- Fixed-point conjugation carries the defining ideal of the
Ga-generated derived radical into itself. -/
theorem RadicalGeneratedHopfIdeal.point_conjugation
    (g : WithConv (B →ₐ[K] K)) (b : B)
    (hb : b ∈ radicalGeneratedHopfIdeal K B) :
    affineGroupConjugationBialgHom g b ∈ radicalGeneratedHopfIdeal K B := by
  let I : LieIdeal K (tangent K B) :=
    ⁅(⊤ : LieIdeal K (tangent K B)), LieAlgebra.radical K (tangent K B)⁆
  let f : I → B →ₐc[K] SymmetricAlgebra K K :=
    fun d => radicalVectorGaMorphism (d : tangent K B) d.property
  change affineGroupConjugationBialgHom g b ∈ gaGeneratedHopfIdeal f
  apply GaGeneratedHopfIdeal.stable_of_tangent_closed f
    (affineGroupConjugationBialgHom g)
    (affineGroupConjugationBialgEquiv g).surjective ?_ b hb
  intro d
  refine ⟨⟨affineGroupAdjointRepresentation g d,
    affineGroupAdjoint_bracket_radical g d d.property⟩, ?_⟩
  simp only [f, radicalVectorGaMorphism_tangent]
  exact DerivationComp.conjugation g d

end ReductiveGroups
