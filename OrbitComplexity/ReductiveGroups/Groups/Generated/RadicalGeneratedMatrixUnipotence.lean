import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedPointClosure
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedMatrixIdentity
import OrbitComplexity.ReductiveGroups.Groups.Reductive.AffineGroupRadicalIntegration
import OrbitComplexity.ReductiveGroups.Lie.Exponential.RadicalExponentialUnipotence

/-!
# Radical Generated Matrix Unipotence

Uniform matrix unipotence on the point subgroup generated by the
canonical radical-bracket additive subgroups. -/

noncomputable section
namespace ReductiveGroups
open WithConv

universe u w
variable {K B : Type u} [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

private abbrev tangent :=
  Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

private abbrev radicalBracket : LieIdeal K (tangent (K := K) (B := B)) :=
  ⁅(⊤ : LieIdeal K (tangent (K := K) (B := B))),
    LieAlgebra.radical K (tangent (K := K) (B := B))⁆

/-- The family of additive-group morphisms indexed by the Lie ideal `⁅L, rad L⁆` of the tangent Lie
algebra `L` of `B`, sending `d` to `radicalVectorGaMorphism d`. -/
def radicalBracketGaFamily :
    radicalBracket (K := K) (B := B) → B →ₐc[K] SymmetricAlgebra K K :=
  fun d => radicalVectorGaMorphism (d : tangent (K := K) (B := B)) d.property

/-- The group homomorphism sending a rational point of the affine group with coordinate algebra `B`
to its matrix under the representation `ρ`, a Hopf algebra map from the coordinate algebra of `GLₙ`
to `B`. -/
def representedMatrixPoint (n : ℕ)
    (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B) :
    WithConv (B →ₐ[K] K) →* Matrix (Fin n) (Fin n) K :=
  (Units.coeHom (Matrix (Fin n) (Fin n) K)).comp
    ((TauCeti.GeneralLinear.pointsMulEquiv n).toMonoidHom.comp
      (TauCeti.AlgHom.mapDomain ρ))

private theorem radicalPoint_matrix_word (n : ℕ)
    (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (g : gaGeneratedPointSubgroup (radicalBracketGaFamily (K := K) (B := B))) :
    ∃ xs : List (radicalBracket (K := K) (B := B)),
      representedMatrixPoint (K := K) n ρ (g.val : WithConv (B →ₐ[K] K)) =
        (xs.map (fun (d : radicalBracket (K := K) (B := B)) => associativeExponential (K := K)
          (affineGroupMatrixDifferential n ρ (d : tangent (K := K) (B := B))))).prod := by
  let H := radicalBracket (K := K) (B := B)
  let F := representedMatrixPoint (K := K) n ρ
  let D := affineGroupMatrixDifferential n ρ
  have hgen (d : H) (t : Multiplicative K) :
      ∃ xs : List H,
        F (gaAffineGroupPoints (radicalBracketGaFamily (K := K) (B := B) d) t) =
          (xs.map (fun (z : H) => associativeExponential (K := K)
            (D (z : tangent (K := K) (B := B))))).prod := by
    let s : K := Multiplicative.toAdd t
    refine ⟨[s • d], ?_⟩
    have ht := GaAffineGroupPoints.matrix_eq_exponential n
      (radicalBracketGaFamily (K := K) (B := B) d) ρ s
    have hDs : D ((s • d : H) : tangent (K := K) (B := B)) =
        s • D (d : tangent (K := K) (B := B)) := by
      simp [D]
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, hDs]
    simpa [F, representedMatrixPoint, D, s, radicalBracketGaFamily,
      radicalVectorGaMorphism_tangent] using ht
  have hword : ∀ g ∈ gaGeneratedPointSubgroup (radicalBracketGaFamily (K := K) (B := B)),
      ∃ xs : List H, F g =
        (xs.map (fun (z : H) => associativeExponential (K := K)
          (D (z : tangent (K := K) (B := B))))).prod := by
    intro z hz
    change z ∈ Subgroup.closure (⋃ d : H,
       Set.range (gaAffineGroupPoints (radicalBracketGaFamily (K := K) (B := B) d))) at hz
    induction hz using Subgroup.closure_induction'' with
    | mem z hz =>
        obtain ⟨d, hd⟩ := Set.mem_iUnion.mp hz
        obtain ⟨t, rfl⟩ := hd
        exact hgen d t
    | inv_mem z hz =>
        obtain ⟨d, hd⟩ := Set.mem_iUnion.mp hz
        obtain ⟨t, rfl⟩ := hd
        rw [← map_inv (gaAffineGroupPoints (radicalBracketGaFamily (K := K) (B := B) d)) t]
        exact hgen d t⁻¹
    | one => exact ⟨[], by simp [F]⟩
    | mul x y _ _ hx hy =>
        obtain ⟨xs, hxs⟩ := hx
        obtain ⟨ys, hys⟩ := hy
        refine ⟨xs ++ ys, ?_⟩
        simp only [map_mul, hxs, hys, List.map_append, List.prod_append]
  exact hword g.val g.property

/-- One matrix nilpotence exponent works for every ordinary point generated
by all canonical radical-bracket additive subgroups. The matrix coordinate
representation is arbitrary. -/
theorem RadicalGeneratedPoint.matrix_uniform_unipotent (n : ℕ)
    (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B) :
    ∃ N : ℕ, ∀ g : gaGeneratedPointSubgroup (radicalBracketGaFamily (K := K) (B := B)),
      (representedMatrixPoint (K := K) n ρ (g.val : WithConv (B →ₐ[K] K)) - 1) ^ N = 0 := by
  let : Module.Finite K (tangent (K := K) (B := B)) :=
    finiteTypeAffineGroup_tangent_finite (K := K) (B := B)
  obtain ⟨N, hN⟩ := RadicalExponentialUnipotence.exists_exponential_product_unipotence
    (affineGroupMatrixDifferential n ρ)
  refine ⟨N, ?_⟩
  intro g
  obtain ⟨xs, hxs⟩ := radicalPoint_matrix_word n ρ g
  rw [hxs]
  exact hN xs

/-- The same uniform equation holds on every algebra-valued point of the
quotient generated by the radical-bracket additive subgroups. -/
theorem RadicalGeneratedQuotient.matrix_uniform_unipotent (n : ℕ)
    (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B) :
    ∃ N : ℕ, ∀ {A : Type w} [CommRing A] [Algebra K A]
      (g : WithConv ((TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal (radicalBracketGaFamily (K := K) (B := B)))) →ₐ[K] A)),
      ((TauCeti.GeneralLinear.pointsMulEquiv n (TauCeti.AlgHom.mapDomain
        ((TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
          (gaGeneratedHopfIdeal (radicalBracketGaFamily (K := K) (B := B)))).hom.comp ρ) g) :
            Matrix (Fin n) (Fin n) A) - 1) ^ N = 0 := by
  obtain ⟨N, hN⟩ := RadicalGeneratedPoint.matrix_uniform_unipotent n ρ
  refine ⟨N, ?_⟩
  intro A _ _ g
  apply GaGeneratedQuotient.matrix_pow_sub_one_eq_zero
    (radicalBracketGaFamily (K := K) (B := B)) n ρ N
  intro s
  exact hN s

end ReductiveGroups
