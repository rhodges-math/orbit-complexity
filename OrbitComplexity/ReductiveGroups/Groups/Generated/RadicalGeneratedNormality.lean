import OrbitComplexity.ReductiveGroups.Groups.Hopf.ReducedPointNormality
import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedConjugation
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedPointClosure

/-!
# Radical Generated Normality

The subgroup generated by the integrated derived-radical vectors
is normal when its coordinate quotient is reduced. -/

noncomputable section
namespace ReductiveGroups

universe u
variable (K B : Type u) [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B] [IsReduced B]

/-- Pointwise invariance of the constructed ideal upgrades to scheme-level
Hopf normality under the stated reducedness of its coordinate quotient. -/
theorem radicalGeneratedHopfIdeal_isNormal :
    (radicalGeneratedHopfIdeal K B).IsNormal := by
  let f : (⁅(⊤ : LieIdeal K
      (Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K))),
      LieAlgebra.radical K
      (Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K))⁆ :
      LieIdeal K (Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K))) →
      B →ₐc[K] SymmetricAlgebra K K :=
    fun d => radicalVectorGaMorphism d d.property
  have hred : IsReduced (B ⧸ (radicalGeneratedHopfIdeal K B).toIdeal) := by
    change IsReduced (TauCeti.CommHopfAlgCat.quotient
      (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal f))
    infer_instance
  apply isNormal_of_point_conjugation_stable
  intro g b hb
  exact RadicalGeneratedHopfIdeal.point_conjugation K B g b hb

end ReductiveGroups
