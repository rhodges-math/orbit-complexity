import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedSubgroup
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedConnected
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedSmooth

/-!
# Radical Generated Properties

Connectedness and smoothness of the original radical-generated subgroup,
stated using its fixed ideal rather than a separately chosen family. -/

noncomputable section
namespace ReductiveGroups

universe u
variable (K B : Type u) [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

/-- The closed subgroup generated by the radical-bracket tangents
is geometrically connected. -/
theorem RadicalGeneratedQuotient.geometrically_connected :
    TauCeti.geometricallyConnectedCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (radicalGeneratedHopfIdeal K B)) := by
  unfold radicalGeneratedHopfIdeal
  exact GaGeneratedQuotient.geometrically_connected _

/-- The same original radical-generated closed subgroup is smooth. -/
theorem radicalGeneratedQuotient_smooth :
    TauCeti.smoothCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (radicalGeneratedHopfIdeal K B)) := by
  unfold radicalGeneratedHopfIdeal
  exact gaGeneratedQuotient_smooth _

end ReductiveGroups
