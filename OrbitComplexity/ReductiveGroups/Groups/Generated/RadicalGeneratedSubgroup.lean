import OrbitComplexity.ReductiveGroups.Groups.Reductive.AffineGroupRadicalIntegration
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedTangentCriterion
import Mathlib.Algebra.Lie.Semisimple.Defs

/-!
# Radical Generated Subgroup

The closed subgroup generated inside the original affine
group by the uniquely integrated radical-bracket tangents.  Its properties are proved in
`Groups/RadicalGeneratedProperties.lean`, `Groups/RadicalGeneratedNormality.lean`
and `Groups/RadicalGeneratedUnipotence.lean`. -/

noncomputable section
namespace ReductiveGroups

universe u
variable (K B : Type u) [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

local notation "𝔤" => Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

/-- Coordinate ideal of the closed subgroup generated by the Ga morphisms
of all vectors of the tangent ideal `[g, radical g]`. -/
def radicalGeneratedHopfIdeal : TauCeti.HopfIdeal K B :=
  gaGeneratedHopfIdeal (fun d : (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ :
    LieIdeal K 𝔤) => radicalVectorGaMorphism (d : 𝔤) d.property)

/-- All radical-bracket tangents lie in the tangent image of this
closed subgroup of the original affine group. -/
theorem radicalBracket_le_generatedTangent :
    (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ : LieIdeal K 𝔤).toLieSubalgebra ≤
      (TauCeti.derivationCompLieHom (B := K)
        (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
          (radicalGeneratedHopfIdeal K B)).hom).range := by
  intro d hd
  unfold radicalGeneratedHopfIdeal
  have h := gaGenerated_tangent_mem_range
      (fun d : (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ : LieIdeal K 𝔤) =>
        radicalVectorGaMorphism (d : 𝔤) d.property) ⟨d, hd⟩
  rw [radicalVectorGaMorphism_tangent] at h
  exact h

/-- The defining ideal is the largest Hopf ideal annihilated by all
radical-bracket tangent derivations. -/
theorem le_radicalGeneratedHopfIdeal_iff (J : TauCeti.HopfIdeal K B) :
    J ≤ radicalGeneratedHopfIdeal K B ↔
      ∀ d ∈ (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ : LieIdeal K 𝔤),
        ∀ b ∈ J, d b = 0 := by
  have h := le_gaGeneratedHopfIdeal_iff_tangents
    (fun d : (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ : LieIdeal K 𝔤) =>
      radicalVectorGaMorphism (d : 𝔤) d.property) J
  constructor
  · intro hJ d hd b hb
    simpa only [radicalVectorGaMorphism_tangent] using h.mp hJ ⟨d, hd⟩ b hb
  · intro hJ
    apply h.mpr
    intro d b hb
    simpa only [radicalVectorGaMorphism_tangent] using hJ d d.property b hb

/-- The constructed subgroup is trivial exactly when the radical
bracket is zero.  -/
theorem radicalGenerated_eq_augmentation_iff :
    radicalGeneratedHopfIdeal K B = TauCeti.HopfIdeal.augmentation K B ↔
      (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ : LieIdeal K 𝔤) = ⊥ := by
  have h := gaGeneratedHopfIdeal_eq_augmentation_iff
    (fun d : (⁅(⊤ : LieIdeal K 𝔤), LieAlgebra.radical K 𝔤⁆ : LieIdeal K 𝔤) =>
      radicalVectorGaMorphism (d : 𝔤) d.property)
  constructor
  · intro hJ
    apply le_antisymm _ bot_le
    intro d hd
    change d = 0
    simpa only [radicalVectorGaMorphism_tangent] using h.mp hJ ⟨d, hd⟩
  · intro hI
    apply h.mpr
    intro d
    have hd : (d : 𝔤) = 0 := by
      simpa only [hI, LieSubmodule.mem_bot] using d.property
    simpa only [radicalVectorGaMorphism_tangent] using hd

/-- Triviality of the constructed subgroup is exactly the central-radical
property needed for the derived Killing-algebra construction. It is derived
from geometric reductivity in `Groups/ReductiveTangentRadical.lean`, using
the normality, connectedness, smoothness and unipotence of the subgroup
(`Groups/RadicalGeneratedNormality.lean`,
`Groups/RadicalGeneratedProperties.lean`,
`Groups/RadicalGeneratedUnipotence.lean`). -/
theorem RadicalGenerated.eq_augmentation_iff_hasCentralRadical :
    radicalGeneratedHopfIdeal K B = TauCeti.HopfIdeal.augmentation K B ↔
      LieAlgebra.HasCentralRadical K 𝔤 := by
  rw [radicalGenerated_eq_augmentation_iff, LieSubmodule.lie_eq_bot_iff]
  constructor
  · intro h
    apply LieAlgebra.hasCentralRadical_of_radical_le
    intro y hy
    change ∀ x : 𝔤, ⁅x, y⁆ = 0
    exact fun x => h x (LieSubmodule.mem_top x) y hy
  · intro h
    let := h
    intro x _ y hy
    rw [LieAlgebra.radical_eq_center] at hy
    exact hy x

end ReductiveGroups
