import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Basic
import TauCeti.Algebra.HopfAlgebra.Basic

/-!
# Hopf Automorphism Fixed Subgroup

The exact fixed subgroup for an arbitrary family of coordinate Hopf
automorphisms. -/

noncomputable section
namespace ReductiveGroups

open TauCeti WithConv
open scoped TensorProduct

variable {K B : Type*} [Field K] [CommRing B] [HopfAlgebra K B]
variable {ι : Type*}

/-- Differences cutting out common fixed points. -/
def hopfAutomorphismDifferenceSet (e : ι → B ≃ₐc[K] B) : Set B :=
  {x | ∃ i b, x = e i b - b}

/-- The ordinary ideal generated by the differences, before adding any
Hopf closure. -/
def hopfAutomorphismDifferenceIdeal (e : ι → B ≃ₐc[K] B) : Ideal B :=
  Ideal.span (hopfAutomorphismDifferenceSet e)

private theorem tensorMap_sub_mem
    (f : B →ₐ[K] B) (I : Ideal B)
    (hI : ∀ b, f b - b ∈ I) (z : B ⊗[K] B) :
    Algebra.TensorProduct.map f f z - z ∈
      TauCeti.HopfIdeal.leftTensorIdeal (R := K) (H := B) I ⊔
        TauCeti.HopfIdeal.rightTensorIdeal (R := K) (H := B) I := by
  induction z using TensorProduct.inductionOn with
  | tmul a b =>
      rw [Algebra.TensorProduct.map_tmul]
      have hcalc : f a ⊗ₜ[K] f b - a ⊗ₜ[K] b =
          (f a - a) ⊗ₜ[K] f b + a ⊗ₜ[K] (f b - b) := by
        rw [TensorProduct.sub_tmul, TensorProduct.tmul_sub]
        abel
      rw [hcalc]
      exact add_mem
        (Ideal.mem_sup_left (TauCeti.HopfIdeal.tmul_mem_leftTensorIdeal
          (R := K) (H := B) (hI a) (f b)))
        (Ideal.mem_sup_right (TauCeti.HopfIdeal.tmul_mem_rightTensorIdeal
          (R := K) (H := B) a (hI b)))
  | add x y hx hy =>
      simpa only [map_add, add_sub_add_comm] using add_mem hx hy

/-- The ordinary difference ideal is already a Hopf ideal. Its underlying
ideal is definitionally the ordinary span of the differences. -/
def hopfAutomorphismFixedHopfIdeal (e : ι → B ≃ₐc[K] B) : HopfIdeal K B :=
  HopfIdeal.ofSpan (hopfAutomorphismDifferenceSet e)
    (by
      intro x hx
      obtain ⟨i, b, rfl⟩ := hx
      let f := (e i).toBialgHom
      have hcomm := BialgHomClass.map_comp_comulAlgHom f
      have hΔ : Coalgebra.comul (R := K) (e i b - b) =
          Algebra.TensorProduct.map f.toAlgHom f.toAlgHom
            (Coalgebra.comul (R := K) b) - Coalgebra.comul (R := K) b := by
        rw [map_sub]
        have hm : Coalgebra.comul (R := K) (f b) =
            Algebra.TensorProduct.map f.toAlgHom f.toAlgHom
              (Coalgebra.comul (R := K) b) := by
          exact (congrArg (fun h : B →ₐ[K] B ⊗[K] B => h b) hcomm).symm
        exact congrArg (fun z : B ⊗[K] B => z - Coalgebra.comul (R := K) b) hm
      rw [hΔ]
      apply tensorMap_sub_mem f.toAlgHom (hopfAutomorphismDifferenceIdeal e)
      intro c
      exact Ideal.subset_span ⟨i, c, rfl⟩)
    (by
      intro x hx
      obtain ⟨i, b, rfl⟩ := hx
      change Bialgebra.counitAlgHom K B (e i b - b) = 0
      rw [map_sub]
      have hε := BialgHomClass.counitAlgHom_comp (e i).toBialgHom
      have heq := congrArg (fun h : B →ₐ[K] K => h b) hε
      simp)
    (by
      intro x hx
      obtain ⟨i, b, rfl⟩ := hx
      let f := (e i).toBialgHom
      change HopfAlgebra.antipode K (f b - b) ∈ Ideal.span (hopfAutomorphismDifferenceSet e)
      rw [map_sub, ← BialgHomClass.map_antipode f]
      exact Ideal.subset_span ⟨i, HopfAlgebra.antipode K b, rfl⟩)

/-- The equality is

```lean
(hopfAutomorphismFixedHopfIdeal e).toIdeal =
      hopfAutomorphismDifferenceIdeal e
```
-/
@[simp] theorem hopfAutomorphismFixedHopfIdeal_toIdeal
    (e : ι → B ≃ₐc[K] B) :
    (hopfAutomorphismFixedHopfIdeal e).toIdeal =
      hopfAutomorphismDifferenceIdeal e :=
  HopfIdeal.ofSpan_toIdeal _ _ _ _

/-- For every commutative value algebra, the quotient's points are exactly
those fixed by every coordinate Hopf automorphism in the family. -/
theorem mem_hopfAutomorphismFixed_iff
    (e : ι → B ≃ₐc[K] B)
    {A : Type*} [CommRing A] [Algebra K A]
    (g : WithConv (B →ₐ[K] A)) :
    g ∈ TauCeti.CommHopfAlgCat.quotientPointsSubgroup
      (CommHopfAlgCat.of K B) (hopfAutomorphismFixedHopfIdeal e)
      (CommAlgCat.of K A) ↔
      ∀ i, g.ofConv.comp (e i).toAlgEquiv.toAlgHom = g.ofConv := by
  rw [TauCeti.CommHopfAlgCat.mem_quotientPointsSubgroup_iff]
  constructor
  · intro hg i
    apply AlgHom.ext
    intro b
    have hmem : e i b - b ∈ hopfAutomorphismFixedHopfIdeal e := by
      rw [← HopfIdeal.mem_toIdeal, hopfAutomorphismFixedHopfIdeal_toIdeal]
      exact Ideal.subset_span ⟨i, b, rfl⟩
    have hz := hg (e i b - b) hmem
    change g.ofConv (e i b - b) = 0 at hz
    change g.ofConv (e i b) = g.ofConv b
    simpa only [map_sub, sub_eq_zero] using hz
  · intro hfix b hb
    have hker : (hopfAutomorphismFixedHopfIdeal e).toIdeal ≤
        RingHom.ker g.ofConv.toRingHom := by
      rw [hopfAutomorphismFixedHopfIdeal_toIdeal,
        hopfAutomorphismDifferenceIdeal]
      apply Ideal.span_le.mpr
      intro x hx
      obtain ⟨i, c, rfl⟩ := hx
      change g.ofConv (e i c - c) = 0
      rw [map_sub, sub_eq_zero]
      have hc := congrArg (fun f : B →ₐ[K] A => f c) (hfix i)
      exact hc
    exact RingHom.mem_ker.mp (hker ((HopfIdeal.mem_toIdeal).mpr hb))

end ReductiveGroups
