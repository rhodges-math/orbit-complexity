import OrbitComplexity.ReductiveGroups.Groups.Reductive.CentralNilpotentMatrixUnipotence
import OrbitComplexity.ReductiveGroups.Groups.Representations.FaithfulMatrixUnipotence
import TauCeti.Algebra.AlgebraicGroup.Unipotent.Basic

/-!
# Central Nilpotent Unipotence

The subgroup generated by central nilpotent tangents is geometrically
unipotent. Its defining faithful embedding is retained throughout. -/

noncomputable section
namespace ReductiveGroups
open WithConv Module

universe u
variable {K B : Type u} [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]
variable (n : ℕ) (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
  (hρ : Function.Surjective ρ)

omit [IsAlgClosed K] in
/-- For these parameters,

```lean
TauCeti.geometricallyUnipotentPointsCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ))
```
-/
theorem CentralNilpotentGenerated.geometricallyUnipotent :
    TauCeti.geometricallyUnipotentPointsCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ)) := by
  intro g
  obtain ⟨V, m, b, hσ⟩ :=
    TauCeti.Comodule.exists_coordinateBialgHom_surjective (k := K) (H := B)
  let M : TauCeti.FGComoduleCat.{u,u,u} K B :=
    ⟨TauCeti.ComoduleCat.of K B V, Module.Finite.of_basis b⟩
  let Q := TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
    (centralNilpotentGeneratedHopfIdeal n ρ hρ)
  let q : B →ₐc[K] Q :=
    (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
      (centralNilpotentGeneratedHopfIdeal n ρ hρ)).hom
  let N : TauCeti.FGComoduleCat.{u,u,u} K Q :=
    (TauCeti.FGComoduleCat.corestrict q.toCoalgHom).obj M
  let c : Basis (Fin m) K N := b
  have hcomp : TauCeti.Comodule.coordinateBialgHom (H := Q) c =
      q.comp (TauCeti.Comodule.coordinateBialgHom (H := B) b) :=
    TauCeti.Comodule.coordinateBialgHom_corestrict q b
  have hc : Function.Surjective (TauCeti.Comodule.coordinateBialgHom (H := Q) c) := by
    rw [hcomp]
    exact (TauCeti.CommHopfAlgCat.mkQuotient_surjective
      (CommHopfAlgCat.of K B) (centralNilpotentGeneratedHopfIdeal n ρ hρ)).comp hσ
  obtain ⟨e, he⟩ := CentralNilpotentGeneratedQuotient.matrix_uniform_unipotent n ρ hρ m
    (TauCeti.Comodule.coordinateBialgHom (H := B) b)
  apply FaithfulMatrixUnipotence.isUnipotentPoint_matrix_nilpotent N m c hc g
  rw [hcomp]
  exact ⟨e, he g⟩

/-- For these parameters,

```lean
TauCeti.smoothUnipotentCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.quotient
        (TauCeti.FiniteTypeCommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ))
```
-/
theorem CentralNilpotentGenerated.smoothUnipotent :
    TauCeti.smoothUnipotentCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.quotient
        (TauCeti.FiniteTypeCommHopfAlgCat.of K B)
        (centralNilpotentGeneratedHopfIdeal n ρ hρ)) := by
  rw [TauCeti.smoothUnipotentCommHopfAlgProperty_iff]
  constructor
  · exact (TauCeti.smoothCommHopfAlgProperty_iff _).mp
      (centralNilpotentGenerated_smooth n ρ hρ)
  · exact CentralNilpotentGenerated.geometricallyUnipotent n ρ hρ

end ReductiveGroups
