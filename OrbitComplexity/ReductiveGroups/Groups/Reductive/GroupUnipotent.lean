import OrbitComplexity.ReductiveGroups.Groups.Reductive.GroupPoints
import OrbitComplexity.ReductiveGroups.Groups.Unipotent.BorelRootUnipotentSubgroup

/-!
# The unipotent subgroup of a chosen Borel subgroup

The root-vector one-parameter subgroups generate a closed unipotent subgroup of
the chosen Borel subgroup. Its rational points are characterized by vanishing of
the corresponding Hopf ideal.

## Main definitions

* `ReductiveGroups.ReductiveGroupData.unipotentIdeal`: the defining Hopf ideal.
* `ReductiveGroups.ReductiveGroupData.unipotentPoints`: its group of rational points.

## Main results

* `ReductiveGroups.ReductiveGroupData.unipotent_le_borel`: containment in the Borel subgroup.
-/

noncomputable section

namespace ReductiveGroups.ReductiveGroupData

open TauCeti

universe u

variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K] (G : ReductiveGroupData K)

/-- The Hopf ideal of the subgroup generated by the Borel root-vector subgroups. -/
def unipotentIdeal : HopfIdeal K G.coordinateAlgebra :=
  borelRootUnipotentHopfIdeal G.borelIdeal G.torusSplit G.split_surjective

/-- The finite type coordinate Hopf algebra of the Borel root-unipotent subgroup. -/
def unipotentAlgebra : FiniteTypeCommHopfAlgCat.{u, u} K :=
  FiniteTypeCommHopfAlgCat.quotient G.coordinateAlgebra G.unipotentIdeal

/-- The rational points of the Borel root-unipotent subgroup. -/
def unipotentPoints : Subgroup G.points :=
  CommHopfAlgCat.quotientPointsSubgroup (CommHopfAlgCat.of K G.coordinateAlgebra)
    G.unipotentIdeal (CommAlgCat.of K K)

/-- The Borel defining ideal is contained in the root-unipotent defining ideal. -/
theorem borel_le_unipotentIdeal : G.borelIdeal ≤ G.unipotentIdeal :=
  borel_le_borelRootUnipotentHopfIdeal G.borelIdeal G.torusSplit G.split_surjective

/-- A point belongs to the unipotent subgroup exactly when it kills its defining ideal. -/
theorem mem_unipotentPoints (g : G.points) :
    g ∈ G.unipotentPoints ↔ ∀ a ∈ G.unipotentIdeal, g.ofConv a = 0 :=
  CommHopfAlgCat.mem_quotientPointsSubgroup_iff _ _ _ _

/-- The unipotent subgroup is contained in the chosen Borel subgroup. -/
theorem unipotent_le_borel : G.unipotentPoints ≤ G.borelPoints :=
  CommHopfAlgCat.quotientPointsSubgroup_le_of_le _
    G.borel_le_unipotentIdeal _

/-- The coordinate quotient of the root-unipotent subgroup is geometrically unipotent. -/
theorem unipotent_geometricallyUnipotent :
    geometricallyUnipotentPointsCommHopfAlgProperty K G.unipotentAlgebra.obj :=
  BorelRootUnipotentQuotient.geometricallyUnipotent G.borelIdeal G.isBorel
    G.torusSplit G.split_surjective

/-- The Borel root-unipotent coordinate quotient is smooth. -/
theorem unipotent_smooth : smoothCommHopfAlgProperty K G.unipotentAlgebra.obj :=
  borelRootUnipotentQuotient_smooth G.borelIdeal G.torusSplit G.split_surjective

/-- The Borel root-unipotent coordinate quotient is geometrically connected. -/
theorem unipotent_geometricallyConnected :
    geometricallyConnectedCommHopfAlgProperty K G.unipotentAlgebra.obj :=
  BorelRootUnipotentQuotient.geometrically_connected G.borelIdeal G.torusSplit
    G.split_surjective

end ReductiveGroupData
