import OrbitComplexity.ReductiveGroups.Groups.Reductive.CentralNilpotentUnipotence
import OrbitComplexity.ReductiveGroups.Groups.Reductive.ReductiveSubgroupTriviality

/-!
# Reductive Central Nilpotent

A central tangent of a reductive affine group whose matrix in a faithful
representation is nilpotent must vanish. -/

noncomputable section
namespace ReductiveGroups

universe u
variable {K B : Type u} [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]
variable (n : ℕ) (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
  (hρ : Function.Surjective ρ)
  (hB : TauCeti.reductiveCommHopfAlgProperty K
    (TauCeti.FiniteTypeCommHopfAlgCat.of K B))

local notation "𝔤" => Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

include hρ hB

/-- The subgroup generated by all central nilpotent tangents is trivial. -/
theorem ReductiveCentralNilpotent.eq_augmentation :
    centralNilpotentGeneratedHopfIdeal n ρ hρ = TauCeti.HopfIdeal.augmentation K B := by
  let _ : Algebra.Smooth K B := TauCeti.reductiveCommHopfAlgProperty.smooth hB
  let _ : IsReduced B := TauCeti.isReduced_of_smooth K B
  exact ReductiveSubgroupTriviality.hopfIdeal_eq_augmentation_unbundled hB
    (centralNilpotentGeneratedHopfIdeal n ρ hρ)
    (centralNilpotentGenerated_isNormal n ρ hρ)
    (CentralNilpotentGenerated.geometrically_connected n ρ hρ)
    (CentralNilpotentGenerated.smoothUnipotent n ρ hρ)

/-- The equality is

```lean
centralNilpotentIdeal (affineGroupMatrixDifferential n ρ) = ⊥
```
-/
theorem reductive_centralNilpotentIdeal_eq_bot :
    centralNilpotentIdeal (affineGroupMatrixDifferential n ρ) = ⊥ :=
  (CentralNilpotentGenerated.eq_augmentation_iff n ρ hρ).mp
    (ReductiveCentralNilpotent.eq_augmentation n ρ hρ hB)

/-- This is matrix nilpotence in a faithful representation, not merely
nilpotence of the adjoint action, which would also hold for toral centers. -/
theorem ReductiveCentralNilpotent.central_matrix_nilpotent_eq_zero
    (d : 𝔤) (hc : d ∈ LieAlgebra.center K 𝔤)
    (hn : IsNilpotent (affineGroupMatrixDifferential n ρ d)) : d = 0 := by
  have hd : d ∈ centralNilpotentIdeal (affineGroupMatrixDifferential n ρ) := ⟨hc, hn⟩
  rw [reductive_centralNilpotentIdeal_eq_bot n ρ hρ hB] at hd
  exact hd

end ReductiveGroups
