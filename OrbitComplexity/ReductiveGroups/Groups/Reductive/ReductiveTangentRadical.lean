import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedUnipotence
import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedProperties
import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedNormality
import OrbitComplexity.ReductiveGroups.Groups.Reductive.ReductiveSubgroupTriviality
import OrbitComplexity.ReductiveGroups.Lie.Cartan.CentralRadicalDerived

/-!
# Reductive Tangent Radical

Geometric reductivity of the original affine group forces central
solvable radical of its tangent algebra. The derived algebra then
has nondegenerate Killing form; the center of the full tangent is retained. -/

noncomputable section
namespace ReductiveGroups

universe u
variable {K B : Type u} [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

local notation "𝔤" => Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

/-- The original radical-generated subgroup is smooth unipotent, in the
geometric-point sense testing every finite-dimensional representation. -/
theorem radicalGeneratedQuotient_smoothUnipotent :
    TauCeti.smoothUnipotentCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.quotient
        (TauCeti.FiniteTypeCommHopfAlgCat.of K B) (radicalGeneratedHopfIdeal K B)) := by
  rw [TauCeti.smoothUnipotentCommHopfAlgProperty_iff]
  constructor
  · exact (TauCeti.smoothCommHopfAlgProperty_iff _).mp
      (radicalGeneratedQuotient_smooth K B)
  · exact RadicalGeneratedQuotient.geometricallyUnipotent (K := K) (B := B)

/-- Reductivity kills the connected normal smooth unipotent subgroup
generated by the integrated radical-bracket tangents. -/
theorem ReductiveTangentRadical.radicalGenerated_eq_augmentation
    (hB : TauCeti.reductiveCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.of K B)) :
    radicalGeneratedHopfIdeal K B = TauCeti.HopfIdeal.augmentation K B := by
  let _ : Algebra.Smooth K B := TauCeti.reductiveCommHopfAlgProperty.smooth hB
  let _ : IsReduced B := TauCeti.isReduced_of_smooth K B
  exact ReductiveSubgroupTriviality.hopfIdeal_eq_augmentation_unbundled hB
    (radicalGeneratedHopfIdeal K B) (radicalGeneratedHopfIdeal_isNormal K B)
    (RadicalGeneratedQuotient.geometrically_connected K B)
    (radicalGeneratedQuotient_smoothUnipotent (K := K) (B := B))

/-- The tangent Lie algebra of the reductive group has
central solvable radical.  -/
theorem reductive_tangent_hasCentralRadical
    (hB : TauCeti.reductiveCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.of K B)) :
    LieAlgebra.HasCentralRadical K 𝔤 :=
  (RadicalGenerated.eq_augmentation_iff_hasCentralRadical K B).mp
    (ReductiveTangentRadical.radicalGenerated_eq_augmentation hB)

/-- Killing nondegeneracy holds on the derived tangent algebra,
without imposing it on the potentially nonzero center of the full tangent. -/
theorem reductive_tangent_derived_isKilling
    (hB : TauCeti.reductiveCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.of K B)) :
    LieAlgebra.IsKilling K (LieAlgebra.derivedSeries K 𝔤 1) := by
  let _ := finiteTypeAffineGroup_tangent_finite (K := K) (B := B)
  let _ := reductive_tangent_hasCentralRadical hB
  exact centralRadical_derived_isKilling

/-- The derived tangent algebra has trivial solvable radical. -/
theorem ReductiveTangentRadical.tangent_derived_hasTrivialRadical
    (hB : TauCeti.reductiveCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.of K B)) :
    LieAlgebra.HasTrivialRadical K (LieAlgebra.derivedSeries K 𝔤 1) := by
  let _ := finiteTypeAffineGroup_tangent_finite (K := K) (B := B)
  let _ := reductive_tangent_derived_isKilling hB
  infer_instance

end ReductiveGroups
