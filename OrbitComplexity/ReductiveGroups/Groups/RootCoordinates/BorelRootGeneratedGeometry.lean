import OrbitComplexity.ReductiveGroups.Groups.RootCoordinates.BorelRootGenerated
import OrbitComplexity.ReductiveGroups.Groups.Solvable.ConnectedGeneratedSubgroup
import Mathlib.Algebra.MonoidAlgebra.NoZeroDivisors

/-!
# Borel Root Generated Geometry

Smoothness and connectedness of the closed subgroup generated by the
torus and the root vectors in the Borel tangent. -/

noncomputable section
namespace ReductiveGroups

universe u
variable {K B ι : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

omit [IsAlgClosed K] [CharZero K] in
/-- For these parameters,

```lean
Algebra.FiniteType K (borelRootGeneratorCodomain J π j)
```
-/
theorem borelRootGeneratorCodomain_finiteType
    (J : TauCeti.HopfIdeal K B)
    (π : B →ₐc[K] MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
    (hπ : Function.Surjective π) (j : Option (borelRootVectorIndex J π)) :
    Algebra.FiniteType K (borelRootGeneratorCodomain J π j) := by
  cases j with
  | none => exact Algebra.FiniteType.of_surjective π.toAlgHom hπ
  | some r =>
      change Algebra.FiniteType K (SymmetricAlgebra K K)
      exact Algebra.FiniteType.of_surjective (gaPolynomialEquiv K).symm.toAlgHom
        (gaPolynomialEquiv K).symm.surjective

omit [IsAlgClosed K] [CharZero K] in
/-- For these parameters,

```lean
IsDomain (borelRootGeneratorCodomain J π j)
```
-/
theorem borelRootGeneratorCodomain_isDomain
    (J : TauCeti.HopfIdeal K B)
    (π : B →ₐc[K] MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
    (j : Option (borelRootVectorIndex J π)) :
    IsDomain (borelRootGeneratorCodomain J π j) := by
  cases j with
  | none =>
      change IsDomain (MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
      infer_instance
  | some r =>
      change IsDomain (SymmetricAlgebra K K)
      exact (gaPolynomialEquiv K).injective.isDomain

/-- The original mixed generated subgroup is smooth. -/
theorem borelRootGenerated_smooth
    (J : TauCeti.HopfIdeal K B)
    (π : B →ₐc[K] MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
    (hπ : Function.Surjective π) :
    TauCeti.smoothCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal
          (borelRootGeneratorFamily J π hπ))) := by
  let _ := fun j => borelRootGeneratorCodomain_finiteType J π hπ j
  let _ := fun j => borelRootGeneratorCodomain_isDomain J π j
  let _ : ∀ j, IsReduced (borelRootGeneratorCodomain J π j) := fun _ => inferInstance
  exact commonKernelQuotient_smooth (CommHopfAlgCat.of K B)
    (borelRootGeneratorCodomain J π) (borelRootGeneratorFamily J π hπ)

/-- The original mixed generated subgroup is geometrically connected. -/
theorem BorelRootGenerated.geometrically_connected
    (J : TauCeti.HopfIdeal K B)
    (π : B →ₐc[K] MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
    (hπ : Function.Surjective π) :
    TauCeti.geometricallyConnectedCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal
          (borelRootGeneratorFamily J π hπ))) := by
  let _ := fun j => borelRootGeneratorCodomain_finiteType J π hπ j
  let _ := fun j => borelRootGeneratorCodomain_isDomain J π j
  let _ : ∀ j, IsReduced (borelRootGeneratorCodomain J π j) := fun _ => inferInstance
  let _ : ∀ j, ConnectedSpace (PrimeSpectrum (borelRootGeneratorCodomain J π j)) :=
    fun _ => inferInstance
  exact CommonKernelQuotient.geometrically_connected (CommHopfAlgCat.of K B)
    (borelRootGeneratorCodomain J π) (borelRootGeneratorFamily J π hπ)

end ReductiveGroups
