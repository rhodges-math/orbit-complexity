import OrbitComplexity.ReductiveGroups.Groups.RootCoordinates.BorelRootGeneratedGeometry
import OrbitComplexity.ReductiveGroups.Groups.Borel.BorelGeometricProperties
import OrbitComplexity.ReductiveGroups.Groups.Tangents.ConnectedSubgroupTangentEquality

/-!
# Borel Root Generation

The Borel is the closed subgroup generated by its original
maximal torus and its nonidentity character root groups. -/

noncomputable section
namespace ReductiveGroups

universe u
variable {K B ι : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B] [Finite ι]

/-- A smooth connected original subgroup containing the original maximal
torus is generated as a closed subgroup by that torus and its own integrated
character vectors. The equality concerns the original Hopf ideal. -/
theorem TorusContaining.commonKernelRootGenerators_eq
    (I J : TauCeti.HopfIdeal K B) (hJI : J ≤ I)
    (hI : TauCeti.HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (π : B →ₐc[K] MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
    (hπ : Function.Surjective π)
    (hker : ∀ b : B, π b = 0 ↔ b ∈ I.toIdeal)
    (hB : TauCeti.reductiveCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.of K B))
    (hJs : TauCeti.smoothCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B) J))
    (hJc : ConnectedSpace (PrimeSpectrum (B ⧸ J.toIdeal))) :
    TauCeti.CommHopfAlgCat.commonKernelHopfIdeal
      (borelRootGeneratorFamily J π hπ) = J := by
  symm
  apply HopfIdeals.eq_of_le_of_smooth_connected_tangent J
    (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal (borelRootGeneratorFamily J π hπ))
    (borel_le_commonKernelRootGenerators I J hJI π hπ hker) hJs hJc
    (borelRootGenerated_smooth J π hπ)
  · exact TauCeti.geometricallyConnectedCommHopfAlgProperty.connectedSpace K _
      (BorelRootGenerated.geometrically_connected J π hπ)
  · exact (borelRootGenerators_tangent_eq I J hJI hI π hπ hker hB).symm.le

/-- The fixed Borel is generated by its fixed torus and
the root groups integrated from its own character vectors.  -/
theorem borel_commonKernelRootGenerators_eq
    (I J : TauCeti.HopfIdeal K B) (hJI : J ≤ I)
    (hI : TauCeti.HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : TauCeti.HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K (Multiplicative (ι →₀ ℤ)))
    (hπ : Function.Surjective π)
    (hker : ∀ b : B, π b = 0 ↔ b ∈ I.toIdeal)
    (hB : TauCeti.reductiveCommHopfAlgProperty K
      (TauCeti.FiniteTypeCommHopfAlgCat.of K B)) :
    TauCeti.CommHopfAlgCat.commonKernelHopfIdeal
      (borelRootGeneratorFamily J π hπ) = J := by
  exact TorusContaining.commonKernelRootGenerators_eq I J hJI hI π hπ hker hB
    (borelQuotient_smooth J hJ)
    (TauCeti.geometricallyConnectedCommHopfAlgProperty.connectedSpace K _
      (borelQuotient_geometricallyConnected J hJ))

end ReductiveGroups
