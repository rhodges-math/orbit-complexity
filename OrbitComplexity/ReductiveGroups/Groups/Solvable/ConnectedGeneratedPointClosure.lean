import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Vanishing
import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.CommonKernel
import TauCeti.RingTheory.FiniteType.PointSeparation

/-!
# Connected Generated Point Closure

The common-kernel quotient of reduced finite-type Hopf generators
is the reduced closure of their generated ordinary-point subgroup. -/

noncomputable section
namespace ReductiveGroups

open TauCeti CategoryTheory WithConv

universe u v
variable {K : Type u} [Field K] [IsAlgClosed K]
  {ι : Type v} (H : CommHopfAlgCat.{u} K)
  (D : ι → CommHopfAlgCat.{u} K)
  [∀ i, Algebra.FiniteType K (D i)] [∀ i, IsReduced (D i)]

/-- The subgroup of `K`-points generated by the images of all
members of the dependent Hopf family. -/
def connectedGeneratedPointSubgroup
    (f : ∀ i, H ⟶ D i) : Subgroup (WithConv (H →ₐ[K] K)) :=
  Subgroup.closure (⋃ i, Set.range
    (fun p : HopfAlgebra.points (R := K) (H := D i) (CommAlgCat.of K K) =>
      toConv (p.ofConv.comp ((f i).hom : H →ₐ[K] D i))))

/-- The common-kernel Hopf ideal is exactly the ideal vanishing on
its generated subgroup of ordinary points. -/
theorem CommonKernelHopfIdeal.eq_generated_vanishingIdeal
    (f : ∀ i, H ⟶ D i) :
    CommHopfAlgCat.commonKernelHopfIdeal f =
      HopfIdeal.vanishingIdeal (connectedGeneratedPointSubgroup H D f) := by
  apply le_antisymm
  · apply (HopfIdeal.le_vanishingIdeal_iff
      (connectedGeneratedPointSubgroup H D f)
      (CommHopfAlgCat.commonKernelHopfIdeal f)).mpr
    exact CommHopfAlgCat.closure_iUnion_range_mapPoints_le_commonKernelPoints f
      (CommAlgCat.of K K)
  · apply (CommHopfAlgCat.le_commonKernelHopfIdeal_iff f
      (HopfIdeal.vanishingIdeal (connectedGeneratedPointSubgroup H D f))).mpr
    intro i b hb
    change (f i).hom b = 0
    let _ : Algebra.FiniteType K (D i) := inferInstance
    let _ : IsReduced (D i) := inferInstance
    apply TauCeti.eq_of_forall_algHom_apply_eq (k := K) (K := K)
    intro p
    have hp : toConv (p.comp ((f i).hom : H →ₐ[K] D i)) ∈
        connectedGeneratedPointSubgroup H D f := by
      apply Subgroup.subset_closure
      exact Set.mem_iUnion.mpr ⟨i, Set.mem_range_self (toConv p)⟩
    have hv := (HopfIdeal.mem_vanishingIdeal
      (connectedGeneratedPointSubgroup H D f) b).mp hb ⟨_, hp⟩
    change p ((f i).hom b) = 0 at hv
    simpa only [map_zero] using hv

/-- The common-kernel quotient is reduced, including an empty
family, because it is a point-vanishing quotient. -/
instance connectedGeneratedQuotient_isReduced (f : ∀ i, H ⟶ D i) :
    IsReduced (CommHopfAlgCat.quotient H (CommHopfAlgCat.commonKernelHopfIdeal f)) := by
  rw [CommonKernelHopfIdeal.eq_generated_vanishingIdeal H D f]
  infer_instance

end ReductiveGroups
