import OrbitComplexity.ReductiveGroups.Groups.Solvable.SolvablePointClosure
import OrbitComplexity.ReductiveGroups.Groups.Solvable.ConnectedGeneratedSubgroup
import TauCeti.Algebra.AlgebraicGroup.Borel.Basic

/-!
# Connected Generated Solvability

The common-kernel quotient is a Borel candidate once the
subgroup generated by its rational generator points is solvable. -/

noncomputable section
namespace ReductiveGroups
open CategoryTheory WithConv

universe u v
variable {K : Type u} [Field K] [IsAlgClosed K] {ι : Type v}
  (H : CommHopfAlgCat.{u} K) (D : ι → CommHopfAlgCat.{u} K)
  [∀ i, Algebra.FiniteType K (D i)] [∀ i, IsReduced (D i)]
  (f : ∀ i, H ⟶ D i)

/-- For these parameters,

```lean
Group.IsSolvable (WithConv (TauCeti.CommHopfAlgCat.quotient H
      (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f) →ₐ[K] A))
```
-/
theorem commonKernelQuotient_points_isSolvable
    [Group.IsSolvable (connectedGeneratedPointSubgroup H D f)]
    {A : Type*} [CommRing A] [Algebra K A] :
    Group.IsSolvable (WithConv (TauCeti.CommHopfAlgCat.quotient H
      (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f) →ₐ[K] A)) := by
  rw [CommonKernelHopfIdeal.eq_generated_vanishingIdeal H D f]
  exact vanishingQuotient_points_isSolvable (connectedGeneratedPointSubgroup H D f)

/-- For these parameters,

```lean
TauCeti.geometricallySolvablePointsCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient H
        (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f))
```
-/
theorem CommonKernelQuotient.geometricallySolvable
    [Group.IsSolvable (connectedGeneratedPointSubgroup H D f)] :
    TauCeti.geometricallySolvablePointsCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient H
        (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f)) :=
  commonKernelQuotient_points_isSolvable H D f

/-- For these parameters,

```lean
TauCeti.HopfIdeal.IsBorelCandidate K
      ⟨H, (TauCeti.finiteTypeCommHopfAlgProperty_iff H).2 inferInstance⟩
      (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f)
```
-/
theorem commonKernelQuotient_borelCandidate
    [Algebra.FiniteType K H] [∀ i, ConnectedSpace (PrimeSpectrum (D i))]
    [Group.IsSolvable (connectedGeneratedPointSubgroup H D f)] :
    TauCeti.HopfIdeal.IsBorelCandidate K
      ⟨H, (TauCeti.finiteTypeCommHopfAlgProperty_iff H).2 inferInstance⟩
      (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f) := by
  exact ⟨commonKernelQuotient_smooth H D f,
    CommonKernelQuotient.geometrically_connected H D f,
    CommonKernelQuotient.geometricallySolvable H D f⟩

end ReductiveGroups
