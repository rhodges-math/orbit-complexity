import OrbitComplexity.ReductiveGroups.Groups.Solvable.ConnectedGeneratedPointClosure
import OrbitComplexity.ReductiveGroups.Groups.Solvable.ConnectedGroupTranslation
import TauCeti.Algebra.AlgebraicGroup.Smooth.AlgebraicallyClosed

/-!
# Connected Generated Subgroup

The closed subgroup generated by connected reduced finite-type affine
groups is connected. The family may mix a torus with additive root groups.
The defining ideal is the existing common-kernel Hopf ideal. -/

noncomputable section
namespace ReductiveGroups
open WithConv CategoryTheory

universe u v
variable {K : Type u} [Field K] [IsAlgClosed K] {ι : Type v}
  (H : CommHopfAlgCat.{u} K) [Algebra.FiniteType K H]
  (D : ι → CommHopfAlgCat.{u} K)
  [∀ i, Algebra.FiniteType K (D i)] [∀ i, IsReduced (D i)]
  [∀ i, ConnectedSpace (PrimeSpectrum (D i))]

/-- Connectedness of the closed group generated by a family of
connected reduced finite-type groups, including the empty family. -/
theorem commonKernelQuotient_connected (f : ∀ i, H ⟶ D i) :
    ConnectedSpace (PrimeSpectrum (TauCeti.CommHopfAlgCat.quotient H
      (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f))) := by
  let Q := TauCeti.CommHopfAlgCat.quotient H
    (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f)
  let q := (TauCeti.CommHopfAlgCat.mkQuotient H
    (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f)).hom
  let _ : Nontrivial Q := Bialgebra.nontrivial (A := Q) K
  apply TauCeti.connectedSpace_primeSpectrum_iff_idempotent_eq_zero_or_one.mpr
  intro e he
  have hS : connectedGeneratedPointSubgroup H D f ≤
      (TauCeti.HopfAlgebra.rightTranslationStabilizer e).map
        (TauCeti.AlgHom.mapDomain q) := by
    rw [connectedGeneratedPointSubgroup, Subgroup.closure_le]
    intro g hg
    obtain ⟨i, p, rfl⟩ := Set.mem_iUnion.mp hg
    let l := (TauCeti.CommHopfAlgCat.commonKernelLift f i).hom
    refine ⟨TauCeti.AlgHom.mapDomain l p, ?_, ?_⟩
    · apply TauCeti.HopfAlgebra.mem_rightTranslationStabilizer.mpr
      exact ConnectedGroupPoint.rightTranslation_fixes_idempotent l p e he
    · apply WithConv.ofConv_injective
      ext b
      change p.ofConv (l (q b)) = p.ofConv ((f i).hom b)
      apply congrArg p.ofConv
      exact congrArg (fun g => g.hom b)
        (TauCeti.CommHopfAlgCat.mkQuotient_comp_commonKernelLift f i)
  obtain ⟨b, hb⟩ := TauCeti.CommHopfAlgCat.mkQuotient_surjective H
    (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f) e
  have hval (s : connectedGeneratedPointSubgroup H D f) :
      s.val.ofConv b = Coalgebra.counit (R := K) e := by
    obtain ⟨x, hx, hs⟩ := hS s.property
    have hfix := TauCeti.HopfAlgebra.mem_rightTranslationStabilizer.mp hx
    have hxval := congrArg (fun a : Q →ₐ[K] K => a e)
      (TauCeti.HopfAlgebra.counitAlgHom_comp_rightTranslationAlgHom x)
    simp only [AlgHom.comp_apply, hfix, Bialgebra.counitAlgHom_apply] at hxval
    have hsval := congrArg (fun p : WithConv (H →ₐ[K] K) => p.ofConv b) hs
    change x.ofConv (q b) = s.val.ofConv b at hsval
    rw [hb] at hsval
    exact hsval.symm.trans hxval.symm
  have hvan : b - algebraMap K H (Coalgebra.counit (R := K) e) ∈
      TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f := by
    apply (CommonKernelHopfIdeal.eq_generated_vanishingIdeal H D f).symm.le
    rw [TauCeti.HopfIdeal.mem_vanishingIdeal]
    intro s
    rw [map_sub, AlgHom.commutes, hval]
    simp
  have hz : q (b - algebraMap K H (Coalgebra.counit (R := K) e)) = 0 :=
    (TauCeti.CommHopfAlgCat.mkQuotient_eq_zero_iff H
      (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f) _).mpr hvan
  have heq : e = algebraMap K Q (Coalgebra.counit (R := K) e) := by
    have hb' : q b = e := hb
    have hcomm : q (algebraMap K H (Coalgebra.counit (R := K) e)) =
        algebraMap K Q (Coalgebra.counit (R := K) e) := q.toAlgHom.commutes _
    rw [map_sub, hcomm, hb'] at hz
    exact sub_eq_zero.mp hz
  rcases IsIdempotentElem.iff_eq_zero_or_one.mp
    (he.map (Bialgebra.counitAlgHom K Q)) with hzero | hone
  · left
    exact heq.trans (by rw [show Coalgebra.counit (R := K) e = 0 from hzero, map_zero])
  · right
    exact heq.trans (by rw [show Coalgebra.counit (R := K) e = 1 from hone, map_one])

/-- The generated original quotient is geometrically connected. -/
theorem CommonKernelQuotient.geometrically_connected (f : ∀ i, H ⟶ D i) :
    TauCeti.geometricallyConnectedCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient H
        (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f)) :=
  (TauCeti.geometricallyConnectedCommHopfAlgProperty_iff_connectedSpace K _).mpr
    (commonKernelQuotient_connected H D f)

omit [∀ i, ConnectedSpace (PrimeSpectrum (D i))] in
/-- Reducedness of the generators implies smoothness of the generated
group over the algebraically closed field. -/
theorem commonKernelQuotient_smooth (f : ∀ i, H ⟶ D i) :
    TauCeti.smoothCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient H
        (TauCeti.CommHopfAlgCat.commonKernelHopfIdeal f)) := by
  let _ := connectedGeneratedQuotient_isReduced H D f
  exact TauCeti.smoothCommHopfAlgProperty_of_isAlgClosed_of_isReduced K _

end ReductiveGroups
