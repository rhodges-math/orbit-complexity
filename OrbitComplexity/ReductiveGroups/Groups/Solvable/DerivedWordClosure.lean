import OrbitComplexity.ReductiveGroups.Groups.Solvable.DerivedWordSolvability
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Derived Word Closure

The values of the balanced commutator word generate exactly the derived
series term. In particular, its universal identity characterizes solvability
at the same depth, rather than merely following from solvability. -/

namespace ReductiveGroups
open scoped commutatorElement IsMulCommutative

variable {G : Type*} [Group G]

/-- The subgroup of `G` generated by all values of the balanced derived commutator word of depth
`n`. -/
def derivedWordClosure (n : ℕ) : Subgroup G :=
  Subgroup.closure (Set.range (derivedGroupWord (G := G) n))

/-- For these parameters,

```lean
derivedGroupWord n x ∈ derivedWordClosure n
```
-/
theorem derivedGroupWord_mem_closure (n : ℕ) (x : DerivedWordIndex n → G) :
    derivedGroupWord n x ∈ derivedWordClosure n :=
  Subgroup.subset_closure ⟨x, rfl⟩

/-- The subgroup generated by derived words is normal. -/
instance derivedWordClosure_normal (n : ℕ) : (derivedWordClosure (G := G) n).Normal := by
  constructor
  intro a ha g
  let f := (MulAut.conj g).toMonoidHom
  have hf : (derivedWordClosure n).map f ≤ derivedWordClosure n := by
    rw [derivedWordClosure, MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    rw [derivedGroupWord_map]
    exact derivedGroupWord_mem_closure n _
  exact hf ⟨a, ha, rfl⟩

/-- The equality is

```lean
⁅derivedWordClosure (G := G) n, derivedWordClosure (G := G) n⁆ =
      derivedWordClosure (G := G) (n + 1)
```
-/
theorem commutator_derivedWordClosure (n : ℕ) :
    ⁅derivedWordClosure (G := G) n, derivedWordClosure (G := G) n⁆ =
      derivedWordClosure (G := G) (n + 1) := by
  apply le_antisymm
  · let N := derivedWordClosure (G := G) (n + 1)
    let q : G →* G ⧸ N := QuotientGroup.mk' N
    let S := q '' Set.range (derivedGroupWord (G := G) n)
    have hcomm : ∀ a ∈ S, ∀ b ∈ S, a * b = b * a := by
      rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩ _ ⟨_, ⟨y, rfl⟩, rfl⟩
      apply commutatorElement_eq_one_iff_mul_comm.mp
      rw [← map_commutatorElement]
      apply (QuotientGroup.eq_one_iff _).mpr
      exact derivedGroupWord_mem_closure (n + 1)
        (fun i => if i.1 then y i.2 else x i.2)
    let := Subgroup.isMulCommutative_closure fun a ha b hb _ => hcomm a ha b hb
    have hmap : (derivedWordClosure (G := G) n).map q = Subgroup.closure S :=
      MonoidHom.map_closure q _
    apply Subgroup.commutator_le.mpr
    intro a ha b hb
    apply (QuotientGroup.eq_one_iff _).mp
    change q ⁅a, b⁆ = 1
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
    have hqa : q a ∈ Subgroup.closure S := hmap ▸ ⟨a, ha, rfl⟩
    have hqb : q b ∈ Subgroup.closure S := hmap ▸ ⟨b, hb, rfl⟩
    exact congrArg Subtype.val (mul_comm
      (⟨q a, hqa⟩ : Subgroup.closure S) ⟨q b, hqb⟩)
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    exact Subgroup.commutator_mem_commutator
      (derivedGroupWord_mem_closure n (fun i => x (false, i)))
      (derivedGroupWord_mem_closure n (fun i => x (true, i)))

/-- The equality is

```lean
derivedWordClosure (G := G) n = derivedSeries G n
```
-/
theorem derivedWordClosure_eq_derivedSeries (n : ℕ) :
    derivedWordClosure (G := G) n = derivedSeries G n := by
  induction n with
  | zero =>
      apply top_unique
      intro a _
      exact derivedGroupWord_mem_closure 0 (fun _ => a)
  | succ n ih =>
      rw [← commutator_derivedWordClosure, derivedSeries_succ, ih]

/-- The equality is

```lean
derivedSeries G n = ⊥
```
-/
theorem DerivedSeries.eq_bot_of_derivedGroupWord_identity (n : ℕ)
    (h : ∀ x : DerivedWordIndex n → G, derivedGroupWord n x = 1) :
    derivedSeries G n = ⊥ := by
  rw [← derivedWordClosure_eq_derivedSeries]
  apply le_bot_iff.mp
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨x, rfl⟩
  exact h x

/-- For these parameters,

```lean
Group.IsSolvable G
```
-/
theorem isSolvable_of_derivedGroupWord_identity (n : ℕ)
    (h : ∀ x : DerivedWordIndex n → G, derivedGroupWord n x = 1) :
    Group.IsSolvable G :=
  ⟨⟨n, DerivedSeries.eq_bot_of_derivedGroupWord_identity n h⟩⟩

end ReductiveGroups
