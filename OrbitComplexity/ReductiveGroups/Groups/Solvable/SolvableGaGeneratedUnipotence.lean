import OrbitComplexity.ReductiveGroups.Groups.Solvable.SolvableGaMatrixUnipotence
import OrbitComplexity.ReductiveGroups.Groups.Generated.RadicalGeneratedMatrixUnipotence
import OrbitComplexity.ReductiveGroups.Groups.Representations.FaithfulMatrixUnipotence
import TauCeti.Algebra.AlgebraicGroup.Unipotent.Basic

/-!
# Solvable Ga Generated Unipotence

Geometric unipotence of a closed subgroup generated by additive
subgroups whose tangents lie in one solvable Lie subalgebra. -/

noncomputable section
namespace ReductiveGroups
open WithConv Module

attribute [local instance 100] LieRing.ofAssociativeRing

universe u w
variable {K B ι : Type u} [Field K] [CharZero K] [IsAlgClosed K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

private abbrev tangent :=
  Derivation K B (TauCeti.Bialgebra.CounitAlgebra K B K)

omit [IsAlgClosed K] [Algebra.FiniteType K B] in
private theorem solvableGaPoint_matrix_word (x : ι → B →ₐc[K] SymmetricAlgebra K K)
    (S : LieSubalgebra K (tangent (K := K) (B := B)))
    (hX : ∀ i, gaAffineGroupTangent (x i) ∈ S)
    (n : ℕ) (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (g : gaGeneratedPointSubgroup x) :
    ∃ zs : List S,
      representedMatrixPoint (K := K) n ρ (g.val : WithConv (B →ₐ[K] K)) =
        (zs.map (fun z => associativeExponential (K := K)
          (affineGroupMatrixDifferential n ρ (z : tangent (K := K) (B := B))))).prod ∧
      ∀ z ∈ zs, IsNilpotent
        (affineGroupMatrixDifferential n ρ (z : tangent (K := K) (B := B))) := by
  let F := representedMatrixPoint (K := K) n ρ
  let D := affineGroupMatrixDifferential n ρ
  have hgen (i : ι) (t : Multiplicative K) :
      ∃ zs : List S,
        F (gaAffineGroupPoints (x i) t) =
          (zs.map (fun z => associativeExponential (K := K)
            (D (z : tangent (K := K) (B := B))))).prod ∧
        ∀ z ∈ zs, IsNilpotent (D (z : tangent (K := K) (B := B))) := by
    let s : K := Multiplicative.toAdd t
    let z : S := ⟨gaAffineGroupTangent (x i), hX i⟩
    refine ⟨[s • z], ?_, ?_⟩
    · have ht := GaAffineGroupPoints.matrix_eq_exponential n (x i) ρ s
      simp [List.map, List.flatMap, List.prod_cons]
      simpa [F, representedMatrixPoint, D, s, z] using ht
    · intro w hw
      have hw' : w = s • z := by simpa using hw
      subst w
      have hnil := gaAffineGroupTangent_matrix_nilpotent n (x i) ρ
      simpa [D, z] using hnil.smul s
  have hword : ∀ g ∈ gaGeneratedPointSubgroup x,
      ∃ zs : List S, F g =
        (zs.map (fun z => associativeExponential (K := K)
          (D (z : tangent (K := K) (B := B))))).prod ∧
        ∀ z ∈ zs, IsNilpotent (D (z : tangent (K := K) (B := B))) := by
    intro g hg
    change g ∈ Subgroup.closure (⋃ i : ι, Set.range (gaAffineGroupPoints (x i))) at hg
    induction hg using Subgroup.closure_induction'' with
    | mem g hg =>
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
        obtain ⟨t, rfl⟩ := hi
        exact hgen i t
    | inv_mem g hg =>
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hg
        obtain ⟨t, rfl⟩ := hi
        rw [← map_inv (gaAffineGroupPoints (x i)) t]
        exact hgen i t⁻¹
    | one => exact ⟨[], by simp [F], by simp⟩
    | mul a b _ _ ha hb =>
        obtain ⟨as, has, hanil⟩ := ha
        obtain ⟨bs, hbs, hbnil⟩ := hb
        refine ⟨as ++ bs, ?_, ?_⟩
        · simp [map_mul, has, hbs, List.map_append, List.prod_append]
        · intro z hz
          rcases List.mem_append.mp hz with hz | hz
          · exact hanil z hz
          · exact hbnil z hz
  exact hword g.val g.property

omit [Algebra.FiniteType K B] in
/-- A common exponent, equal to the faithful matrix dimension, works on
the ordinary point subgroup generated by the given additive subgroups. -/
theorem SolvableGaGeneratedPoint.matrix_uniform_unipotent
    (x : ι → B →ₐc[K] SymmetricAlgebra K K)
    (S : LieSubalgebra K (tangent (K := K) (B := B)))
    [LieAlgebra.IsSolvable S]
    (hX : ∀ i, gaAffineGroupTangent (x i) ∈ S)
    (n : ℕ) (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (g : gaGeneratedPointSubgroup x) :
    (representedMatrixPoint (K := K) n ρ (g.val : WithConv (B →ₐ[K] K)) - 1) ^ n = 0 := by
  obtain ⟨zs, hzs, hnil⟩ := solvableGaPoint_matrix_word x S hX n ρ g
  let f : S →ₗ⁅K⁆ Matrix (Fin n) (Fin n) K :=
    (affineGroupMatrixDifferential n ρ).comp S.incl
  rw [hzs]
  simpa [f] using SolvableLie.nilpotent_exponential_product_unipotent f zs
    (fun z hz => hnil z hz)

omit [Algebra.FiniteType K B] in
/-- The uniform matrix equation extends from the generated ordinary point
subgroup to every algebra-valued point of its closed Hopf quotient. -/
theorem SolvableGaGeneratedQuotient.matrix_uniform_unipotent
    (x : ι → B →ₐc[K] SymmetricAlgebra K K)
    (S : LieSubalgebra K (tangent (K := K) (B := B)))
    [LieAlgebra.IsSolvable S]
    (hX : ∀ i, gaAffineGroupTangent (x i) ∈ S)
    (n : ℕ) (ρ : TauCeti.GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B) :
    ∀ {A : Type w} [CommRing A] [Algebra K A]
      (g : WithConv ((TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal x)) →ₐ[K] A)),
      ((TauCeti.GeneralLinear.pointsMulEquiv n (TauCeti.AlgHom.mapDomain
        ((TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
          (gaGeneratedHopfIdeal x)).hom.comp ρ) g) :
            Matrix (Fin n) (Fin n) A) - 1) ^ n = 0 := by
  intro A _ _ g
  apply GaGeneratedQuotient.matrix_pow_sub_one_eq_zero x n ρ n
  intro h
  exact SolvableGaGeneratedPoint.matrix_uniform_unipotent x S hX n ρ h

/-- Every point of the closed subgroup generated by the given
additive subgroups is geometrically unipotent. -/
theorem SolvableGaGeneratedQuotient.geometricallyUnipotent
    (x : ι → B →ₐc[K] SymmetricAlgebra K K)
    (S : LieSubalgebra K (tangent (K := K) (B := B)))
    [LieAlgebra.IsSolvable S]
    (hX : ∀ i, gaAffineGroupTangent (x i) ∈ S) :
    TauCeti.geometricallyUnipotentPointsCommHopfAlgProperty K
      (TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal x)) := by
  intro g
  obtain ⟨V, n, b, hρ⟩ :=
    TauCeti.Comodule.exists_coordinateBialgHom_surjective (k := K) (H := B)
  let M : TauCeti.FGComoduleCat.{u,u,u} K B :=
    ⟨TauCeti.ComoduleCat.of K B V, Module.Finite.of_basis b⟩
  let Q := TauCeti.CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
    (gaGeneratedHopfIdeal x)
  let q : B →ₐc[K] Q :=
    (TauCeti.CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
      (gaGeneratedHopfIdeal x)).hom
  let N : TauCeti.FGComoduleCat.{u,u,u} K Q :=
    (TauCeti.FGComoduleCat.corestrict q.toCoalgHom).obj M
  let c : Basis (Fin n) K N := b
  have hcomp : TauCeti.Comodule.coordinateBialgHom (H := Q) c =
      q.comp (TauCeti.Comodule.coordinateBialgHom (H := B) b) := by
    exact TauCeti.Comodule.coordinateBialgHom_corestrict q b
  have hc : Function.Surjective (TauCeti.Comodule.coordinateBialgHom (H := Q) c) := by
    have hq : Function.Surjective q :=
      TauCeti.CommHopfAlgCat.mkQuotient_surjective
        (CommHopfAlgCat.of K B) (gaGeneratedHopfIdeal x)
    rw [hcomp]
    exact hq.comp hρ
  apply FaithfulMatrixUnipotence.isUnipotentPoint_matrix_nilpotent N n c hc g
  rw [hcomp]
  change IsNilpotent (((TauCeti.GeneralLinear.pointsMulEquiv n
    (TauCeti.AlgHom.mapDomain (q.comp
      (TauCeti.Comodule.coordinateBialgHom (H := B) b)) g) :
        Matrix (Fin n) (Fin n) (AlgebraicClosure K)) - 1))
  refine ⟨n, ?_⟩
  exact SolvableGaGeneratedQuotient.matrix_uniform_unipotent x S hX n
    (TauCeti.Comodule.coordinateBialgHom (H := B) b) g

end ReductiveGroups
