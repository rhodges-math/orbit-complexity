import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedTriangularTangent
import OrbitComplexity.ReductiveGroups.Groups.Representations.MatrixCoordinateConjugation

/-!
# Solvable Ga Generated Tangent

Tangent nilpotence for the closed subgroup generated by Ga
morphisms with tangents in a solvable Lie subalgebra. The common matrix
basis and the corresponding coordinate representation are constructed. -/

noncomputable section
namespace ReductiveGroups

open TauCeti Module
attribute [local instance 100] LieRing.ofAssociativeRing

universe u v
variable {K B : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] {ι : Type v}

omit [IsAlgClosed K] [CharZero K] in
private theorem matrixUpperGap_one_pow_eq_zero {n : ℕ}
    {A : Matrix (Fin n) (Fin n) K} (hA : matrixUpperGap 1 A) : A ^ n = 0 := by
  have hp (m : ℕ) : matrixUpperGap m (A ^ m) := by
    induction m with
    | zero =>
        simp only [pow_zero]
        intro i j hij
        simp [Fin.ne_of_gt hij]
    | succ m hm =>
        rw [pow_succ]
        exact matrixUpperGap_mul hm hA
  exact matrixUpperGap_eq_zero (hp n) le_rfl

/-- Every represented tangent of the closed Ga-generated subgroup
is nilpotent, with exponent at most the matrix size. It is enough that the
generating tangents lie in one solvable Lie subalgebra of the original group. -/
theorem SolvableGaGeneratedTangent.matrix_pow_eq_zero
    (x : ι → B →ₐc[K] SymmetricAlgebra K K)
    (S : LieSubalgebra K (Derivation K B (Bialgebra.CounitAlgebra K B K)))
    [LieAlgebra.IsSolvable S]
    (hX : ∀ i, gaAffineGroupTangent (x i) ∈ S)
    (n : ℕ) (ρ : GeneralLinear.coordinateHopfAlgebra K n →ₐc[K] B)
    (d : Derivation K B (Bialgebra.CounitAlgebra K B K))
    (hd : d ∈ (derivationCompLieHom (B := K)
      (CommHopfAlgCat.mkQuotient (_root_.CommHopfAlgCat.of K B)
        (gaGeneratedHopfIdeal x)).hom).range) :
    (affineGroupMatrixDifferential n ρ d) ^ n = 0 := by
  let f : S →ₗ⁅K⁆ Matrix (Fin n) (Fin n) K :=
    (affineGroupMatrixDifferential n ρ).comp S.incl
  let fEnd : S →ₗ⁅K⁆ Module.End K (Fin n → K) :=
    (Matrix.toLinAlgEquiv' : Matrix (Fin n) (Fin n) K ≃ₐ[K]
      Module.End K (Fin n → K)).toAlgHom.toLieHom.comp f
  let _ : LieRingModule S (Fin n → K) := LieRingModule.compLieHom (Fin n → K) fEnd
  let _ : LieModule K S (Fin n → K) := LieModule.compLieHom (Fin n → K) fEnd
  have hact (z : S) (v : Fin n → K) :
      ⁅z, v⁆ = Matrix.toLin' (f z) v := by rfl
  obtain ⟨b, hb⟩ := SolvableLieTriangularBasis.exists_upperTriangular_matrix_basis K S n
  obtain ⟨σ, _, hσ⟩ := exists_matrixCoordinate_in_basis n ρ b
  have hupper : ∀ i, matrixUpperGap 0
      (affineGroupMatrixDifferential n σ (gaAffineGroupTangent (x i))) := by
    intro i a c hac
    rw [hσ, LinearMap.toMatrix_apply]
    let z : S := ⟨gaAffineGroupTangent (x i), hX i⟩
    change b.repr (Matrix.toLin' (f z) (b c)) a = 0
    rw [← hact z]
    exact hb z a c hac
  have hstrict := GaGeneratedTangent.matrixUpperGap_of_tangents_upper x n σ hupper d hd
  have hp := matrixUpperGap_one_pow_eq_zero hstrict
  let e : Matrix (Fin n) (Fin n) K ≃ₐ[K] Matrix (Fin n) (Fin n) K :=
    (Matrix.toLinAlgEquiv' : Matrix (Fin n) (Fin n) K ≃ₐ[K]
      Module.End K (Fin n → K)).trans (LinearMap.toMatrixAlgEquiv b)
  have he : e (affineGroupMatrixDifferential n ρ d) =
      affineGroupMatrixDifferential n σ d := (hσ d).symm
  apply e.injective
  rw [map_pow, map_zero, he]
  exact hp

end ReductiveGroups
