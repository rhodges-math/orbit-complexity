import OrbitComplexity.ReductiveGroups.Groups.Unipotent.BorelRootUnipotentTangent

/-!
# Borel Root Unipotent Lie Decomposition

The tangent of the Borel's Ga-only subgroup is precisely the sum
of its nonidentity character spaces. No extra torus tangent occurs in closure. -/

noncomputable section
namespace ReductiveGroups

open TauCeti LieAlgebra LieModule

universe u
variable {K B ι : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B] [Finite ι]

local notation "𝔤" => Derivation K B (Bialgebra.CounitAlgebra K B K)
local notation "M" => Multiplicative (ι →₀ ℤ)

/-- The closed subgroup generated by the Borel's root groups has
exactly the nonidentity character part of that Borel's original tangent. -/
theorem BorelRootUnipotentTangent.eq_character_sum
    (I J : HopfIdeal K B) (hJI : J ≤ I)
    (hI : HopfIdeal.IsMaximalTorus K (CommHopfAlgCat.of K B) I)
    (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π)
    (hker : ∀ a : B, π a = 0 ↔ a ∈ I.toIdeal)
    (hB : reductiveCommHopfAlgProperty K (FiniteTypeCommHopfAlgCat.of K B)) :
    (derivationCompLieHom (B := K)
      (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ)).hom).range.toSubmodule =
      ⨆ (α : M) (_ : α ≠ 1),
        (derivationCompLieHom (B := K)
          (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B) J).hom).range.toSubmodule ⊓
          affineGroupCharacterWeightSpace π α := by
  let _ := finiteTypeAffineGroup_tangent_finite (K := K) (B := B)
  let _ := MaximalTorusLieCartan.maximalTorus_coordinateTangent_isCartan I hI π hπ hker hB
  let H := diagonalizableTangentImage π
  let S := (derivationCompLieHom (B := K)
    (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B) J).hom).range
  let U := (derivationCompLieHom (B := K)
    (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B)
      (borelRootUnipotentHopfIdeal J π hπ)).hom).range
  let N : Submodule K 𝔤 := ⨆ (α : M) (_ : α ≠ 1),
    S.toSubmodule ⊓ affineGroupCharacterWeightSpace π α
  change U.toSubmodule = N
  have hNU : N ≤ U.toSubmodule := by
    refine iSup₂_le fun α hα => ?_
    intro d hd
    let r : borelRootVectorIndex J π := ⟨α, ⟨d, hα, hd.2, hd.1⟩⟩
    have hm := gaGenerated_tangent_mem_range (borelRootVectorGa J π hπ) r
    rw [borelRootVectorGa_tangent] at hm
    exact hm
  have hUS : U ≤ S := hopfQuotient_tangentImage_antitone
    (borelRootUnipotentHopfIdeal J π hπ) J (borel_le_borelRootUnipotentHopfIdeal J π hπ)
  have hHS : H ≤ S := by
    intro d hd
    apply (tangent_mem_hopfQuotient_iff J d).mpr
    intro a ha
    obtain ⟨t, rfl⟩ := hd
    change t (π a) = 0
    rw [(hker a).mpr (hJI ha), map_zero]
  have hSle : S.toSubmodule ≤ H.toSubmodule ⊔ N := by
    change (cartanStableSubmodule H S hHS).toSubmodule ≤ _
    rw [CartanStableSubmodule.eq_iSup_inf_rootSpace H S hHS]
    simp only [LieSubmodule.iSup_toSubmodule]
    refine iSup_le fun χ => ?_
    intro d hd
    have hdS : d ∈ S := hd.1
    have hdroot : d ∈ rootSpace H χ := hd.2
    by_cases hχ : χ.IsZero
    · have hz : rootSpace H χ = H.toLieSubmodule := by
        simpa only [hχ.eq] using (rootSpace_zero_eq K 𝔤 H)
      rw [hz] at hdroot
      exact (le_sup_left : H.toSubmodule ≤ H.toSubmodule ⊔ N) hdroot
    · obtain ⟨α, ⟨_, hαχ⟩, _⟩ := existsUnique_character_of_lieWeight π hπ χ
      have hα : α ≠ 1 := by
        intro ha
        apply hχ
        change (χ : H → K) = 0
        rw [hαχ, ha, characterDifferentialOnImage_one]
        rfl
      have hdW : d ∈ affineGroupCharacterWeightSpace π α := by
        rw [AffineGroupCharacterWeightSpace.eq_rootSpace π hπ α]
        change d ∈ rootSpace H (characterDifferentialOnImage π hπ α)
        exact hαχ ▸ hdroot
      have hdN : d ∈ N :=
        (le_iSup₂_of_le α hα le_rfl :
          S.toSubmodule ⊓ affineGroupCharacterWeightSpace π α ≤ N) ⟨hdS, hdW⟩
      exact (le_sup_right : N ≤ H.toSubmodule ⊔ N) hdN
  have hdisjoint : U ⊓ H = ⊥ := BorelRootUnipotentTangent.inf_torus_eq_bot J hJ π hπ
  apply le_antisymm _ hNU
  intro d hd
  obtain ⟨t, ht, z, hz, he⟩ := Submodule.mem_sup.mp (hSle (hUS hd))
  have htU : t ∈ U := by
    have hm := U.sub_mem hd (hNU hz)
    have he' : d - z = t := by rw [← he]; abel
    rwa [he'] at hm
  have ht0 : t = 0 := by
    have hm : t ∈ U ⊓ H := ⟨htU, ht⟩
    rw [hdisjoint] at hm
    exact hm
  rw [ht0, zero_add] at he
  exact he ▸ hz

end ReductiveGroups
