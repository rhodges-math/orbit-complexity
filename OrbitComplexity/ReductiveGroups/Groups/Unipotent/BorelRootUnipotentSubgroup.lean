import OrbitComplexity.ReductiveGroups.Groups.RootCoordinates.BorelRootGenerated
import OrbitComplexity.ReductiveGroups.Groups.Borel.BorelTangent
import OrbitComplexity.ReductiveGroups.Groups.Solvable.SolvableGaGeneratedUnipotence
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedSmooth
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedConnected

/-!
# Borel Root Unipotent Subgroup

The subgroup generated by the nonidentity Borel root groups,
inside the fixed Borel. -/

noncomputable section
namespace ReductiveGroups

open TauCeti

universe u
variable {K B ι : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

local notation "M" => Multiplicative (ι →₀ ℤ)

/-- The exact Hopf ideal of the closed subgroup generated only by the
integrated nonidentity character vectors of the fixed Borel. -/
noncomputable def borelRootUnipotentHopfIdeal
    (J : HopfIdeal K B) (π : B →ₐc[K] MonoidAlgebra K M)
    (hπ : Function.Surjective π) : HopfIdeal K B :=
  gaGeneratedHopfIdeal (borelRootVectorGa J π hπ)

/-- Every root-vector Ga lies in the fixed Borel. -/
theorem borel_le_borelRootUnipotentHopfIdeal
    (J : HopfIdeal K B) (π : B →ₐc[K] MonoidAlgebra K M)
    (hπ : Function.Surjective π) :
    J ≤ borelRootUnipotentHopfIdeal J π hπ := by
  change J ≤ gaGeneratedHopfIdeal (borelRootVectorGa J π hπ)
  apply (le_gaGeneratedHopfIdeal_iff_tangents _ J).mpr
  intro r b hb
  rw [borelRootVectorGa_tangent]
  exact (tangent_mem_hopfQuotient_iff J r.2.val).mp r.2.property.2.2 b hb

/-- The Ga-only generated quotient is geometrically unipotent. The
solvable Lie algebra is the tangent image of the fixed Borel. -/
theorem BorelRootUnipotentQuotient.geometricallyUnipotent
    (J : HopfIdeal K B) (hJ : HopfIdeal.IsBorel K (CommHopfAlgCat.of K B) J)
    (π : B →ₐc[K] MonoidAlgebra K M) (hπ : Function.Surjective π) :
    geometricallyUnipotentPointsCommHopfAlgProperty K
      (CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ)) := by
  let S := (derivationCompLieHom (B := K)
    (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B) J).hom).range
  let : LieAlgebra.IsSolvable S := borel_tangentImage_isSolvable J hJ
  change geometricallyUnipotentPointsCommHopfAlgProperty K
    (CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
      (gaGeneratedHopfIdeal (borelRootVectorGa J π hπ)))
  apply SolvableGaGeneratedQuotient.geometricallyUnipotent
    (borelRootVectorGa J π hπ) S
  intro r
  rw [borelRootVectorGa_tangent]
  exact r.2.property.2.2

/-- For these parameters,

```lean
smoothCommHopfAlgProperty K
      (CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ))
```
-/
theorem borelRootUnipotentQuotient_smooth
    (J : HopfIdeal K B) (π : B →ₐc[K] MonoidAlgebra K M)
    (hπ : Function.Surjective π) :
    smoothCommHopfAlgProperty K
      (CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ)) := by
  unfold borelRootUnipotentHopfIdeal
  exact gaGeneratedQuotient_smooth _

/-- For these parameters,

```lean
geometricallyConnectedCommHopfAlgProperty K
      (CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ))
```
-/
theorem BorelRootUnipotentQuotient.geometrically_connected
    (J : HopfIdeal K B) (π : B →ₐc[K] MonoidAlgebra K M)
    (hπ : Function.Surjective π) :
    geometricallyConnectedCommHopfAlgProperty K
      (CommHopfAlgCat.quotient (CommHopfAlgCat.of K B)
        (borelRootUnipotentHopfIdeal J π hπ)) := by
  unfold borelRootUnipotentHopfIdeal
  exact GaGeneratedQuotient.geometrically_connected _

end ReductiveGroups
