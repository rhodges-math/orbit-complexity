import OrbitComplexity.ReductiveGroups.Groups.Unipotent.BorelRootUnipotentSubgroup
import OrbitComplexity.ReductiveGroups.Groups.Generated.GaGeneratedConjugation
import OrbitComplexity.ReductiveGroups.Groups.Representations.AffineGroupConjugationMorphism
import OrbitComplexity.ReductiveGroups.Groups.Characters.AffineGroupCharacterWeights

/-!
# Borel Root Unipotent Torus Normalization

Fixed original split-torus points normalize the Ga-only subgroup
generated by the fixed Borel's character vectors. -/

noncomputable section
namespace ReductiveGroups

open TauCeti

universe u
variable {K B ι : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  [CommRing B] [HopfAlgebra K B] [Algebra.FiniteType K B]

local notation "M" => Multiplicative (ι →₀ ℤ)

/-- Conjugation by a point of the original split torus preserves
the defining ideal of the Borel's Ga-only generated closed subgroup. -/
theorem BorelRootUnipotentHopfIdeal.torus_point_conjugation
    (J : HopfIdeal K B) (π : B →ₐc[K] MonoidAlgebra K M)
    (hπ : Function.Surjective π)
    (g : WithConv (MonoidAlgebra K M →ₐ[K] K))
    (b : B) (hb : b ∈ borelRootUnipotentHopfIdeal J π hπ) :
    affineGroupConjugationBialgHom (AlgHom.mapDomain π g) b ∈
      borelRootUnipotentHopfIdeal J π hπ := by
  let f := borelRootVectorGa J π hπ
  change affineGroupConjugationBialgHom (AlgHom.mapDomain π g) b ∈
    gaGeneratedHopfIdeal f
  apply GaGeneratedHopfIdeal.stable_of_tangent_closed f
    (affineGroupConjugationBialgHom (AlgHom.mapDomain π g))
    (affineGroupConjugationBialgEquiv (AlgHom.mapDomain π g)).surjective ?_ b hb
  intro r
  let c : K := g.ofConv (MonoidAlgebra.single r.1 1)
  let s : borelRootVectorIndex J π :=
    ⟨r.1, ⟨c • r.2.val, r.2.property.1,
      (affineGroupCharacterWeightSpace π r.1).smul_mem c r.2.property.2.1,
      (derivationCompLieHom (B := K)
        (CommHopfAlgCat.mkQuotient (CommHopfAlgCat.of K B) J).hom).range.smul_mem
          c r.2.property.2.2⟩⟩
  refine ⟨s, ?_⟩
  simp only [f, borelRootVectorGa_tangent]
  rw [DerivationComp.conjugation,
    ← affineGroupAdjointRepresentation_apply]
  exact AffineGroupAdjoint.eq_character_of_mem_weight π r.1 g r.2.val
    r.2.property.2.1

end ReductiveGroups
