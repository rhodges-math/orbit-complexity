import Mathlib.Algebra.Group.Submonoid.BigOperators

/-!
# Auxiliary closure by nonnegative integral combinations

For sets `A`, `U`, and `R` in an additive commutative monoid, `auxiliaryClosure A U R`
consists of elements of `U` in the additive submonoid generated by `A ∪ R`.
Membership is equivalent to a finite natural-number linear combination.
This closure is monotone and idempotent, and is extensive on subsets of `U`.

## Main definitions

* `ReductiveGroups.auxiliaryClosure`: closure in `U` under nonnegative integral combinations.

## Main results

* `ReductiveGroups.mem_auxiliaryClosure_iff_finite_sum`: the finite-sum characterization.
* `ReductiveGroups.auxiliaryClosure_idempotent`: idempotence of auxiliary closure.
-/

namespace ReductiveGroups

open scoped BigOperators

variable {V : Type*} [AddCommMonoid V]

/-- Membership in additive-submonoid closure means a finite sum of generators
with natural-number coefficients. Coefficients away from `t` are immaterial. -/
theorem mem_addSubmonoidClosure_iff_finite_sum {S : Set V} {β : V} :
    β ∈ AddSubmonoid.closure S ↔
      ∃ (t : Finset V) (n : V → ℕ), (↑t : Set V) ⊆ S ∧
        ∑ α ∈ t, n α • α = β := by
  constructor
  · intro hβ
    obtain ⟨n, t, ht, _, hsum⟩ :=
      AddSubmonoid.mem_closure_iff_exists_finset_subset.mp hβ
    exact ⟨t, n, ht, hsum⟩
  · rintro ⟨t, n, ht, rfl⟩
    exact AddSubmonoid.sum_mem _ fun α hα =>
      AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (ht hα)) _

/-- The auxiliary closure `cl_A^U(R)` : those elements of
`U` that are nonnegative integral combinations of elements of `A ∪ R`. -/
def auxiliaryClosure (A U R : Set V) : Set V :=
  U ∩ (AddSubmonoid.closure (A ∪ R) : Set V)

/-- The equivalence is

```lean
β ∈ auxiliaryClosure A U R ↔
      β ∈ U ∧ β ∈ AddSubmonoid.closure (A ∪ R)
```
-/
@[simp]
theorem mem_auxiliaryClosure {A U R : Set V} {β : V} :
    β ∈ auxiliaryClosure A U R ↔
      β ∈ U ∧ β ∈ AddSubmonoid.closure (A ∪ R) :=
  Iff.rfl

/-- Explicit agreement with the finite, nonnegative integral
combinations. The coefficient type is `ℕ`, not a field of scalars. -/
theorem mem_auxiliaryClosure_iff_finite_sum {A U R : Set V} {β : V} :
    β ∈ auxiliaryClosure A U R ↔
      β ∈ U ∧ ∃ (t : Finset V) (n : V → ℕ), (↑t : Set V) ⊆ A ∪ R ∧
        ∑ α ∈ t, n α • α = β := by
  rw [mem_auxiliaryClosure, mem_addSubmonoidClosure_iff_finite_sum]

/-- Auxiliary closure takes values in the specified ambient universe. -/
theorem auxiliaryClosure_subset (A U R : Set V) : auxiliaryClosure A U R ⊆ U :=
  fun _ hβ => hβ.1

/-- Extensivity is asserted on subsets of `U`, . -/
theorem subset_auxiliaryClosure {A U R : Set V} (hRU : R ⊆ U) :
    R ⊆ auxiliaryClosure A U R := by
  intro β hβ
  exact ⟨hRU hβ, AddSubmonoid.subset_closure (Or.inr hβ)⟩

/-- Monotonicity in the set whose closure is taken. -/
theorem auxiliaryClosure_mono {A U R R' : Set V} (hRR' : R ⊆ R') :
    auxiliaryClosure A U R ⊆ auxiliaryClosure A U R' := by
  intro β hβ
  refine ⟨hβ.1, AddSubmonoid.closure_mono ?_ hβ.2⟩
  exact Set.union_subset_union_right A hRR'

/-- The substitution step of the idempotence proof. Each summand
from the inner closure already has an integral expression in `A ∪ R`; natural
multiples and finite sums of these expressions remain in the same span. -/
theorem auxiliaryClosure_idempotent_subset (A U R : Set V) :
    auxiliaryClosure A U (auxiliaryClosure A U R) ⊆ auxiliaryClosure A U R := by
  intro β hβ
  obtain ⟨hβU, t, n, ht, rfl⟩ := mem_auxiliaryClosure_iff_finite_sum.mp hβ
  refine ⟨hβU, AddSubmonoid.sum_mem _ fun α hα => ?_⟩
  apply AddSubmonoid.nsmul_mem
  rcases ht hα with hαA | hαR
  · exact AddSubmonoid.subset_closure (Or.inl hαA)
  · exact hαR.2

/-- Idempotence; the reverse inclusion is extensivity applied to the inner
closure, exactly . -/
@[simp]
theorem auxiliaryClosure_idempotent (A U R : Set V) :
    auxiliaryClosure A U (auxiliaryClosure A U R) = auxiliaryClosure A U R :=
  Set.Subset.antisymm (auxiliaryClosure_idempotent_subset A U R)
    (subset_auxiliaryClosure (auxiliaryClosure_subset A U R))

end ReductiveGroups
