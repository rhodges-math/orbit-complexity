import Mathlib.LinearAlgebra.RootSystem.Base

/-!
# Base Positive Closure

Membership in the additive cone of a base means positivity of a root. -/

noncomputable section
namespace ReductiveGroups

open RootPairing

universe u v w₁ w₂
variable {ι : Type u} {R : Type v} {M : Type w₁} {N : Type w₂}
  [Finite ι] [AddCommGroup M] [AddCommGroup N]
  [Field R] [CharZero R] [Module R M] [Module R N]
  (P : RootPairing ι R M N) [P.IsRootSystem]

omit [Finite ι] [P.IsRootSystem] in
/-- A root in the additive cone generated by the simple roots is positive
relative to that base. -/
theorem isPos_of_mem_simple_root_closure (b : P.Base) (i : ι)
    (hi : P.root i ∈ AddSubmonoid.closure (P.root '' (b.support : Set ι))) :
    b.IsPos i := by
  classical
  have hrepr (m : M) (hm : m ∈ AddSubmonoid.closure (P.root '' (b.support : Set ι))) :
      ∃ f : ι → ℕ, m = ∑ j ∈ b.support, f j • P.root j := by
    refine AddSubmonoid.closure_induction ?_ ⟨0, by simp⟩ ?_ hm
    · rintro - ⟨j, hj, rfl⟩
      refine ⟨Pi.single j 1, ?_⟩
      rw [Finset.sum_eq_single_of_mem j hj (by simp_all)]
      simp
    · intro x y hx hy ⟨f, hf⟩ ⟨g, hg⟩
      refine ⟨f + g, ?_⟩
      simp [hf, hg, add_smul, Finset.sum_add_distrib]
  obtain ⟨f, hf⟩ := hrepr (P.root i) hi
  have hfZ : P.root i = ∑ j ∈ b.support, (f j : ℤ) • P.root j := by
    simpa only [natCast_zsmul] using hf
  have hsum : b.height i = ∑ j ∈ b.support, (f j : ℤ) := b.height_eq_sum hfZ
  have hsome : ∃ j ∈ b.support, 0 < f j := by
    by_contra hn
    push Not at hn
    have hzero (j : ι) (hj : j ∈ b.support) : f j = 0 := by
      have := hn j hj
      omega
    have : P.root i = 0 := by
      exact hf.trans (Finset.sum_eq_zero (fun j hj => by simp [hzero j hj]))
    exact P.ne_zero i this
  rw [b.isPos_iff, hsum]
  exact Finset.sum_pos' (fun j hj => Int.natCast_nonneg _) ⟨hsome.choose,
    hsome.choose_spec.1, by exact_mod_cast hsome.choose_spec.2⟩

end ReductiveGroups
