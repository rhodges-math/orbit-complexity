import OrbitComplexity.ReductiveGroups.Roots.Parabolic.ParabolicSubgroup
import OrbitComplexity.ReductiveGroups.Roots.Coxeter.RootLatticeAction
import OrbitComplexity.ReductiveGroups.Roots.Supports.MultiplicityFreeSupportPartition
import Mathlib.Algebra.Order.Group.Defs

/-! # Parabolic stabilizers of dominant functionals

A functional on the integral root span is dominant when it is nonnegative on the simple roots.
The Weyl elements fixing it are generated by the simple reflections on which it vanishes.
The proof successively removes a right descent and uses the integral positive-root expansion.
-/

noncomputable section
namespace ReductiveGroups
variable {ι R M N A : Type*} [CommRing R] [CharZero R] [IsDomain R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [AddCommGroup A] [LinearOrder A] [IsOrderedAddMonoid A]
  {P : RootPairing ι R M N} [Finite ι] [P.IsCrystallographic] [P.IsReduced]

omit [IsDomain R] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
private theorem positive_functional (b : P.Base) (f : P.rootSpan ℤ →+ A)
    (hpos : ∀ i : b.support, 0 ≤ f (P.rootSpanMem ℤ i.val))
    (r : ι) (hr : b.IsPos r) : 0 ≤ f (P.rootSpanMem ℤ r) := by
  classical
  have hb (i : b.support) : b.toWeightBasisInt i = P.rootSpanMem ℤ i.val :=
    Subtype.ext (b.coe_toWeightBasisInt_apply i)
  have he : P.rootSpanMem ℤ r =
      ∑ i : b.support, simpleRootCoeffInt b r i • P.rootSpanMem ℤ i.val := by
    simpa only [simpleRootCoeffInt, hb] using
      (b.toWeightBasisInt.sum_repr (P.rootSpanMem ℤ r)).symm
  rw [he, map_sum]
  exact Finset.sum_nonneg fun i _ => by
    rw [map_zsmul]
    exact zsmul_nonneg (hpos i) (simpleRootCoeffInt_nonneg_of_isPos b r hr i)

omit [CharZero R] [IsDomain R] [LinearOrder A] [IsOrderedAddMonoid A] [Finite ι]
  [P.IsReduced] in
private theorem simple_functional (f : P.rootSpan ℤ →+ A) (i : ι)
    (hi : f (P.rootSpanMem ℤ i) = 0) (r : ι) :
    f (P.rootSpanMem ℤ (P.weylGroupToPerm (RootPairing.weylGroup.ofIdx P i) r)) =
      f (P.rootSpanMem ℤ r) := by
  rw [← rootLatticeAction_root, rootLatticeAction_reflect_root, map_sub, map_zsmul, hi,
    zsmul_zero, sub_zero]

omit [CharZero R] [IsDomain R] [LinearOrder A] [IsOrderedAddMonoid A] [Finite ι]
  [P.IsReduced] in
private theorem functional_of_parabolic (b : P.Base) (I : Set b.support)
    (f : P.rootSpan ℤ →+ A)
    (hzero : ∀ i : b.support, f (P.rootSpanMem ℤ i.val) = 0 ↔ i ∈ I)
    (w : P.weylGroup) (hw : w ∈ standardParabolicSubgroup b I) :
    ∀ r, f (P.rootSpanMem ℤ (P.weylGroupToPerm w r)) = f (P.rootSpanMem ℤ r) := by
  induction hw using Subgroup.closure_induction with
  | mem w hw =>
    obtain ⟨i, hi, rfl⟩ := hw
    exact simple_functional f i.val ((hzero i).mpr hi)
  | one => intro r; simp
  | mul w v _ _ hw hv =>
    intro r
    rw [map_mul, Equiv.Perm.mul_apply, hw, hv]
  | inv w _ hw =>
    intro r
    have hr := hw (P.weylGroupToPerm w⁻¹ r)
    simpa only [← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one,
      Equiv.Perm.one_apply] using hr.symm

private theorem parabolic_of_functional (b : P.Base) (I : Set b.support)
    (f : P.rootSpan ℤ →+ A)
    (hpos : ∀ i : b.support, 0 ≤ f (P.rootSpanMem ℤ i.val))
    (hzero : ∀ i : b.support, f (P.rootSpanMem ℤ i.val) = 0 ↔ i ∈ I)
    (w : P.weylGroup)
    (hw : ∀ r, f (P.rootSpanMem ℤ (P.weylGroupToPerm w r)) = f (P.rootSpanMem ℤ r)) :
    w ∈ standardParabolicSubgroup b I := by
  have step : ∀ n, ∀ v : P.weylGroup, rootInversionCount b v = n →
      (∀ r, f (P.rootSpanMem ℤ (P.weylGroupToPerm v r)) = f (P.rootSpanMem ℤ r)) →
        v ∈ standardParabolicSubgroup b I := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro v hv hfix
      by_cases hv1 : v = 1
      · rw [hv1]
        exact (standardParabolicSubgroup b I).one_mem
      obtain ⟨i, hi⟩ := (weylCoxeterSystem b).exists_rightDescent_of_ne_one hv1
      have hlt : rootInversionCount b (v * RootPairing.weylGroup.ofIdx P i.val) <
          rootInversionCount b v := by
        simpa only [CoxeterSystem.IsRightDescent, weylCoxeterSystem_simple,
          weylCoxeterSystem_length] using hi
      have hn : ¬ b.IsPos (P.weylGroupToPerm v i.val) := by
        intro hp
        have hincr := rootInversionCount_mul_simple_of_pos b v i hp
        omega
      have hnonpos : f (P.rootSpanMem ℤ (P.weylGroupToPerm v i.val)) ≤ 0 := by
        have hnegpos := positive_functional b f hpos
          (P.reflectionPerm (P.weylGroupToPerm v i.val) (P.weylGroupToPerm v i.val))
          ((isPos_neg_index_iff b _).mpr hn)
        rw [P.rootSpanMem_reflectionPerm_self, map_neg] at hnegpos
        exact neg_nonneg.mp hnegpos
      have hi0 : f (P.rootSpanMem ℤ i.val) = 0 :=
        le_antisymm ((hfix i.val) ▸ hnonpos) (hpos i)
      have hiI := (hzero i).mp hi0
      have hfix' : ∀ r, f (P.rootSpanMem ℤ
          (P.weylGroupToPerm (v * RootPairing.weylGroup.ofIdx P i.val) r)) =
            f (P.rootSpanMem ℤ r) := by
        intro r
        rw [map_mul, Equiv.Perm.mul_apply, hfix, simple_functional f i.val hi0]
      have hshort := ih _ (hv ▸ hlt) _ rfl hfix'
      have hm := (standardParabolicSubgroup b I).mul_mem hshort
        (simple_mem_standardParabolicSubgroup b I i hiI)
      simpa only [mul_assoc, weylGroup_ofIdx_mul_self, mul_one] using hm
  exact step _ w rfl hw

/-- The Weyl elements fixing a dominant functional form the parabolic of its zero simple roots. -/
theorem mem_parabolic_iff_fix_functional (b : P.Base) (I : Set b.support)
    (f : P.rootSpan ℤ →+ A)
    (hpos : ∀ i : b.support, 0 ≤ f (P.rootSpanMem ℤ i.val))
    (hzero : ∀ i : b.support, f (P.rootSpanMem ℤ i.val) = 0 ↔ i ∈ I)
    (w : P.weylGroup) :
    w ∈ standardParabolicSubgroup b I ↔
      ∀ r, f (P.rootSpanMem ℤ (P.weylGroupToPerm w r)) = f (P.rootSpanMem ℤ r) :=
  ⟨functional_of_parabolic b I f hzero w, parabolic_of_functional b I f hpos hzero w⟩

end ReductiveGroups
