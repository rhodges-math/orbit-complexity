import OrbitComplexity.ReductiveGroups.Roots.Parabolic.Longest

/-! # Roots of the parabolic unipotent subgroup

The positive roots outside a Levi subsystem are the noninversions of its longest element.
They form a closed positive-root set preserved by the parabolic Weyl subgroup.
-/

noncomputable section
namespace ReductiveGroups
attribute [local instance] Classical.propDecidable
variable {ι K M N : Type*} [Field K] [CharZero K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  {P : RootPairing ι K M N}

/-- The positive roots outside the subsystem generated by the chosen simple roots. -/
def parabolicRadicalRoots (b : P.Base) (I : Set b.support) : Set ι :=
  {r | b.IsPos r ∧ r ∉ leviPositiveRoots b I}

/-- The Levi roots and their positive complement partition the positive roots. -/
theorem parabolicRadicalRoots_partition (b : P.Base) (I : Set b.support) :
    {r | b.IsPos r} = leviPositiveRoots b I ∪ parabolicRadicalRoots b I ∧
      Disjoint (leviPositiveRoots b I) (parabolicRadicalRoots b I) := by
  constructor
  · ext r
    constructor
    · intro hr
      by_cases h : r ∈ leviPositiveRoots b I
      · exact Or.inl h
      · exact Or.inr ⟨hr, h⟩
    · rintro (hr | hr)
      · exact hr.1
      · exact hr.1
  · exact Set.disjoint_left.mpr fun _ hr hs => hs.2 hr

variable [P.IsRootSystem]

private def outsideDegree (b : P.Base) (I : Set b.support) : P.rootSpan ℤ →ₗ[ℤ] ℤ := by
  classical
  exact b.toWeightBasisInt.constr ℤ (fun i => if i ∈ I then 0 else 1)

omit [P.IsRootSystem] in
private theorem degree_sum (b : P.Base) (I : Set b.support) (r : ι) :
    outsideDegree b I (P.rootSpanMem ℤ r) =
      ∑ i : b.support, simpleRootCoeffInt b r i * (if i ∈ I then 0 else 1) := by
  classical
  rw [← b.toWeightBasisInt.sum_repr (P.rootSpanMem ℤ r), map_sum]
  simp only [map_smul, outsideDegree, Module.Basis.constr_basis, smul_eq_mul,
    simpleRootCoeffInt]

omit [P.IsRootSystem] in
private theorem degree_nonneg (b : P.Base) (I : Set b.support) (r : ι)
    (hr : b.IsPos r) : 0 ≤ outsideDegree b I (P.rootSpanMem ℤ r) := by
  classical
  rw [degree_sum]
  exact Finset.sum_nonneg fun i _ => mul_nonneg
    (simpleRootCoeffInt_nonneg_of_isPos b r hr i) (by split_ifs <;> norm_num)

omit [P.IsRootSystem] in
private theorem degree_zero_of_levi (b : P.Base) (I : Set b.support) (r : ι)
    (hr : r ∈ leviPositiveRoots b I) : outsideDegree b I (P.rootSpanMem ℤ r) = 0 := by
  classical
  let D := outsideDegree b I
  let S : AddSubmonoid M := (LinearMap.ker D).toAddSubmonoid.map
    (P.rootSpan ℤ).subtype.toAddMonoidHom
  have hgen : P.root '' (Subtype.val '' I) ⊆ S := by
    rintro _ ⟨r, ⟨i, hi, rfl⟩, rfl⟩
    apply AddSubmonoid.mem_map.mpr
    refine ⟨P.rootSpanMem ℤ i.val, ?_, rfl⟩
    change D (P.rootSpanMem ℤ i.val) = 0
    have hb : P.rootSpanMem ℤ i.val = b.toWeightBasisInt i :=
      Subtype.ext (b.coe_toWeightBasisInt_apply i).symm
    rw [hb]
    change outsideDegree b I (b.toWeightBasisInt i) = 0
    rw [outsideDegree, Module.Basis.constr_basis, ite_eq_left hi]
  have hmem : P.root r ∈ S := (AddSubmonoid.closure_le.mpr hgen) hr.2
  obtain ⟨x, hx, he⟩ := AddSubmonoid.mem_map.mp hmem
  have hxr : x = P.rootSpanMem ℤ r := Subtype.ext he
  change D x = 0 at hx
  exact hxr ▸ hx

private theorem levi_of_degree_zero (b : P.Base) (I : Set b.support) (r : ι)
    (hr : b.IsPos r) (hz : outsideDegree b I (P.rootSpanMem ℤ r) = 0) :
    r ∈ leviPositiveRoots b I := by
  classical
  have hcoeff (i : b.support) (hi : i ∉ I) : simpleRootCoeffInt b r i = 0 := by
    have hle : simpleRootCoeffInt b r i ≤ outsideDegree b I (P.rootSpanMem ℤ r) := by
      rw [degree_sum]
      have hterm : simpleRootCoeffInt b r i =
          simpleRootCoeffInt b r i * (if i ∈ I then 0 else 1) := by
        simp only [hi, ite_false, mul_one]
      rw [hterm]
      exact Finset.single_le_sum (s := Finset.univ)
        (f := fun j : b.support => simpleRootCoeffInt b r j * (if j ∈ I then 0 else 1))
        (fun j _ => mul_nonneg (simpleRootCoeffInt_nonneg_of_isPos b r hr j)
          (by split_ifs <;> norm_num)) (Finset.mem_univ i)
    exact le_antisymm (hz ▸ hle) (simpleRootCoeffInt_nonneg_of_isPos b r hr i)
  have hroot : P.root r = ∑ i : b.support, simpleRootCoeffInt b r i • P.root i.val := by
    have he := congrArg (fun x : P.rootSpan ℤ => (x : M))
      (b.toWeightBasisInt.sum_repr (P.rootSpanMem ℤ r)).symm
    simpa only [Submodule.coe_sum, Submodule.coe_smul,
      RootPairing.Base.coe_toWeightBasisInt_apply, simpleRootCoeffInt] using he
  rw [leviPositiveRoots_eq_span]
  refine ⟨hr, ?_⟩
  rw [hroot]
  apply Submodule.sum_mem
  intro i _
  by_cases hi : i ∈ I
  · simpa only [Int.cast_smul_eq_zsmul] using
      (Submodule.smul_mem (Submodule.span K (Set.range fun j : I => P.root j.val.val))
        (simpleRootCoeffInt b r i : K) (Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩))
  · rw [hcoeff i hi, zero_smul]
    exact Submodule.zero_mem _

/-- A positive root sum containing an outside-subsystem summand stays outside the subsystem. -/
theorem parabolicRadicalRoots_mixed (b : P.Base) (I : Set b.support)
    (α β γ : ι) (hα : b.IsPos α) (hβ : β ∈ parabolicRadicalRoots b I)
    (hγ : b.IsPos γ) (n m : ℕ) (hm : 0 < m)
    (hsum : P.root γ = n • P.root α + m • P.root β) :
    γ ∈ parabolicRadicalRoots b I := by
  have he : P.rootSpanMem ℤ γ = n • P.rootSpanMem ℤ α + m • P.rootSpanMem ℤ β :=
    Subtype.ext hsum
  have hβd : 0 < outsideDegree b I (P.rootSpanMem ℤ β) := by
    have hnn := degree_nonneg b I β hβ.1
    have hne : outsideDegree b I (P.rootSpanMem ℤ β) ≠ 0 :=
      fun h => hβ.2 (levi_of_degree_zero b I β hβ.1 h)
    omega
  have hγd : 0 < outsideDegree b I (P.rootSpanMem ℤ γ) := by
    rw [he, map_add, map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul]
    exact add_pos_of_nonneg_of_pos
      (mul_nonneg (Int.natCast_nonneg n) (degree_nonneg b I α hα))
      (mul_pos (Int.natCast_pos.mpr hm) hβd)
  exact ⟨hγ, fun h => (ne_of_gt hγd) (degree_zero_of_levi b I γ h)⟩

variable [Finite ι] [P.IsCrystallographic] [P.IsReduced]


/-- The positive roots outside a Levi subsystem form an integrally closed root set. -/
theorem parabolicRadicalRoots_closed (b : P.Base) (I : Set b.support) :
    IsPositiveRootClosed b (parabolicRadicalRoots b I) := by
  have h := PositiveRootClosedSets.isPositiveRootClosed b (longestParabolicElement b I)
  rw [leftRootInv_longestParabolic] at h
  exact h

private theorem span_weyl_iff (b : P.Base) (I : Set b.support)
    (w : P.weylGroup) (hw : w ∈ standardParabolicSubgroup b I) (r : ι) :
    P.root (P.weylGroupToPerm w r) ∈
        Submodule.span K (Set.range fun j : I => P.root j.val.val) ↔
      P.root r ∈ Submodule.span K (Set.range fun j : I => P.root j.val.val) := by
  classical
  have hrange : Set.range (fun j : I => P.root j.val.val) = b.toWeightBasis '' I := by
    ext v
    simp [RootPairing.Base.toWeightBasis_apply]
  have heq (j : b.support) (hj : j ∉ I) :
      b.toWeightBasis.repr (P.root (P.weylGroupToPerm w r)) j =
        b.toWeightBasis.repr (P.root r) j := by
    obtain ⟨l, hl, hprod⟩ := (mem_standardParabolicSubgroup_iff_word b I w).mp hw
    have hn : j ∉ l := fun h => hj (hl j h)
    have hc := simpleRootCoeff_word_of_notMem b l hn (P.root r)
    rw [← simpleWeylWord_smul, hprod, P.weylGroup_apply_root] at hc
    exact hc
  rw [hrange, Module.Basis.mem_span_image, Module.Basis.mem_span_image]
  constructor
  · intro h j hj
    by_contra hjI
    apply hjI
    apply h
    apply Finsupp.mem_support_iff.mpr
    rw [heq j hjI]
    exact Finsupp.mem_support_iff.mp hj
  · intro h j hj
    by_contra hjI
    apply hjI
    apply h
    apply Finsupp.mem_support_iff.mpr
    rw [← heq j hjI]
    exact Finsupp.mem_support_iff.mp hj

private theorem radical_weyl_mem (b : P.Base) (I : Set b.support)
    (w : P.weylGroup) (hw : w ∈ standardParabolicSubgroup b I) (r : ι)
    (hr : r ∈ parabolicRadicalRoots b I) :
    P.weylGroupToPerm w r ∈ parabolicRadicalRoots b I := by
  have hp : b.IsPos (P.weylGroupToPerm w r) := by
    by_contra hn
    apply hr.2
    apply parabolic_inversions_subset b I w⁻¹ ((standardParabolicSubgroup b I).inv_mem hw)
    apply (mem_leftRootInversionIndices b w⁻¹ r).mpr
    exact ⟨hr.1, by simpa only [inv_inv] using hn⟩
  refine ⟨hp, ?_⟩
  intro hlevi
  have hs := (leviPositiveRoots_eq_span b I ▸ hlevi).2
  exact LeviRootSpan.notMem_span_of_notMem_leviPositiveRoots b I hr.1 hr.2
    ((span_weyl_iff b I w hw r).mp hs)

/-- The parabolic Weyl subgroup preserves the positive roots outside its Levi subsystem. -/
theorem parabolicRadicalRoots_weyl (b : P.Base) (I : Set b.support)
    (w : P.weylGroup) (hw : w ∈ standardParabolicSubgroup b I) :
    P.weylGroupToPerm w '' parabolicRadicalRoots b I = parabolicRadicalRoots b I := by
  apply Set.Subset.antisymm
  · rintro _ ⟨r, hr, rfl⟩
    exact radical_weyl_mem b I w hw r hr
  · intro r hr
    refine ⟨P.weylGroupToPerm w⁻¹ r,
      radical_weyl_mem b I w⁻¹ ((standardParabolicSubgroup b I).inv_mem hw) r hr, ?_⟩
    simp only [← Equiv.Perm.mul_apply, ← map_mul, mul_inv_cancel, map_one,
      Equiv.Perm.one_apply]

end ReductiveGroups
