import Mathlib.LinearAlgebra.RootSystem.Base
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas

/-!
# Levi Root Span

The positive roots of the root subsystem generated by a set `I` of
simple roots (`Φ_I^+`): positive roots in the nonnegative
integral cone of the simple roots in `I`. A positive root outside `Φ_I^+`
is not in the linear span of the simple roots in `I`, so it is linearly
independent from them. -/

noncomputable section

namespace ReductiveGroups

variable {ι K M N : Type*} [Field K] [CharZero K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  {P : RootPairing ι K M N}

/-- `Φ_I^+`: positive roots lying in the nonnegative integral
cone of the simple roots in `I`. -/
def leviPositiveRoots (b : P.Base) (I : Set b.support) : Set ι :=
  {γ | b.IsPos γ ∧ P.root γ ∈ AddSubmonoid.closure (P.root '' (Subtype.val '' I))}

variable [P.IsRootSystem]

/-- A positive root outside `Φ_I^+` is not in the `K`-span of the simple
roots in `I`. -/
theorem LeviRootSpan.notMem_span_of_notMem_leviPositiveRoots (b : P.Base) (I : Set b.support)
    {γ : ι} (hγ : b.IsPos γ) (hn : γ ∉ leviPositiveRoots b I) :
    P.root γ ∉ Submodule.span K (Set.range fun j : I => P.root j.val.val) := by
  classical
  intro hspan
  apply hn
  refine ⟨hγ, ?_⟩
  obtain ⟨f, hf₀, hf₁, hf₂⟩ := b.exists_root_eq_sum_int γ
  have hfpos : 0 < f := by
    refine hf₁.resolve_right ?_
    have h₀ := hγ
    rw [RootPairing.Base.isPos_iff, b.height_eq_sum hf₂] at h₀
    intro hneg
    have : ∑ j ∈ b.support, f j ≤ 0 := Finset.sum_nonpos fun j _ => hneg.le j
    lia
  have hfnn : ∀ j, 0 ≤ f j := fun j => hfpos.le j
  -- coordinates in the simple-root basis
  have hrange : Set.range (fun j : I => P.root j.val.val) = b.toWeightBasis '' I := by
    ext v
    simp [RootPairing.Base.toWeightBasis_apply]
  rw [hrange, Module.Basis.mem_span_image] at hspan
  have hrepr : ∀ j : b.support, b.toWeightBasis.repr (P.root γ) j = (f j : K) := by
    intro j
    have hsum : P.root γ = ∑ k : b.support, (f k : K) • b.toWeightBasis k := by
      rw [hf₂]
      rw [← Finset.sum_coe_sort b.support]
      apply Finset.sum_congr rfl
      intro k _
      rw [RootPairing.Base.toWeightBasis_apply, Int.cast_smul_eq_zsmul]
    rw [hsum, map_sum]
    simp [Finsupp.single_apply]
  have hvanish : ∀ j : b.support, j ∉ I → f j = 0 := by
    intro j hj
    have hnot : j ∉ (b.toWeightBasis.repr (P.root γ)).support := fun h => hj (hspan h)
    rw [Finsupp.notMem_support_iff, hrepr] at hnot
    exact_mod_cast hnot
  rw [hf₂]
  apply AddSubmonoid.sum_mem
  intro j hj
  by_cases hjI : (⟨j, hj⟩ : b.support) ∈ I
  · have hmem : P.root j ∈ P.root '' (Subtype.val '' I) := ⟨j, ⟨⟨j, hj⟩, hjI, rfl⟩, rfl⟩
    rw [← Int.toNat_of_nonneg (hfnn j), natCast_zsmul]
    exact AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure hmem) _
  · rw [show f j = 0 from hvanish ⟨j, hj⟩ hjI, zero_smul]
    exact AddSubmonoid.zero_mem _

/-- The simple roots in `I` together with a positive root outside `Φ_I^+`
are linearly independent. -/
theorem LinearIndependent.option_of_notMem_leviPositiveRoots
    (b : P.Base) (I : Set b.support) {γ : ι} (hγ : b.IsPos γ)
    (hn : γ ∉ leviPositiveRoots b I) :
    LinearIndependent K (fun o : Option I =>
      Option.casesOn' o (P.root γ) (fun j : I => P.root j.val.val)) := by
  apply LinearIndependent.option
  · have h := b.toWeightBasis.linearIndependent.comp (fun j : I => j.val) Subtype.val_injective
    simpa [Function.comp_def, RootPairing.Base.toWeightBasis_apply] using h
  · exact LeviRootSpan.notMem_span_of_notMem_leviPositiveRoots b I hγ hn

end ReductiveGroups
