import OrbitComplexity.ReductiveGroups.Roots.Supports.BooleanWordProperty
import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Standard parabolic subgroups and right-coset minima

The subgroup is generated by the simple reflections indexed by an
ordinary subset of the base. Membership is equivalent to a word
using those letters; deletion supplies a reduced such word. Right-coset
minimality means the minimum of inversion length on the
coset.
-/

noncomputable section

namespace ReductiveGroups

variable {ι R M N : Type*} [CommRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N}

/-- The standard parabolic generated by the specified base simples. -/
def standardParabolicSubgroup (b : P.Base) (J : Set b.support) : Subgroup P.weylGroup :=
  Subgroup.closure {s | ∃ i ∈ J, s = RootPairing.weylGroup.ofIdx P i}

/-- For these parameters,

```lean
RootPairing.weylGroup.ofIdx P i ∈ standardParabolicSubgroup b J
```
-/
theorem simple_mem_standardParabolicSubgroup (b : P.Base) (J : Set b.support)
    (i : b.support) (hi : i ∈ J) :
    RootPairing.weylGroup.ofIdx P i ∈ standardParabolicSubgroup b J :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

/-- For these parameters,

```lean
simpleWeylWord b l ∈ standardParabolicSubgroup b J
```
-/
theorem SimpleWeylWord.mem_standardParabolicSubgroup (b : P.Base) (J : Set b.support)
    (l : List b.support) (hl : ∀ i ∈ l, i ∈ J) :
    simpleWeylWord b l ∈ standardParabolicSubgroup b J := by
  induction l with
  | nil => exact (standardParabolicSubgroup b J).one_mem
  | cons i l ih =>
    exact (standardParabolicSubgroup b J).mul_mem
      (simple_mem_standardParabolicSubgroup b J i (hl i (by simp)))
      (ih (fun j hj => hl j (List.mem_cons_of_mem _ hj)))

variable [CharZero R] [Finite ι] [IsDomain R] [P.IsCrystallographic] [P.IsReduced]

/-- The equality is

```lean
simpleWeylWord b l.reverse = (simpleWeylWord b l)⁻¹
```
-/
@[simp] theorem simpleWeylWord_reverse (b : P.Base) (l : List b.support) :
    simpleWeylWord b l.reverse = (simpleWeylWord b l)⁻¹ := by
  simpa only [weylCoxeterSystem_wordProd] using
    (weylCoxeterSystem b).wordProd_reverse l

/-- Generated-subgroup membership is word existence in the allowed simples. -/
theorem mem_standardParabolicSubgroup_iff_word (b : P.Base) (J : Set b.support)
    (w : P.weylGroup) : w ∈ standardParabolicSubgroup b J ↔
      ∃ l : List b.support, (∀ i ∈ l, i ∈ J) ∧ simpleWeylWord b l = w := by
  constructor
  · intro hw
    induction hw using Subgroup.closure_induction with
    | mem w hw =>
      obtain ⟨i, hi, rfl⟩ := hw
      exact ⟨[i], by simpa, by simp [simpleWeylWord]⟩
    | one => exact ⟨[], by simp, rfl⟩
    | mul w v _ _ ihw ihv =>
      obtain ⟨l, hl, hprod⟩ := ihw
      obtain ⟨k, hk, hprod'⟩ := ihv
      exact ⟨l ++ k, fun i hi => (List.mem_append.mp hi).elim (hl i) (hk i),
        by rw [simpleWeylWord_append, hprod, hprod']⟩
    | inv w _ ih =>
      obtain ⟨l, hl, hprod⟩ := ih
      exact ⟨l.reverse, by simpa only [List.mem_reverse] using hl,
        by rw [simpleWeylWord_reverse, hprod]⟩
  · rintro ⟨l, hl, rfl⟩
    exact SimpleWeylWord.mem_standardParabolicSubgroup b J l hl

/-- Every parabolic element has a reduced expression using only its prescribed simples. -/
theorem exists_reduced_standardParabolic_word (b : P.Base) (J : Set b.support)
    (w : P.weylGroup) (hw : w ∈ standardParabolicSubgroup b J) :
    ∃ l : List b.support, (∀ i ∈ l, i ∈ J) ∧
      simpleWeylWord b l = w ∧ l.length = rootInversionCount b w := by
  obtain ⟨l, hl, hprod⟩ := (mem_standardParabolicSubgroup_iff_word b J w).mp hw
  obtain ⟨k, hsub, hk, hlen⟩ := simpleWeylWord_has_reduced_sublist b l
  exact ⟨k, fun i hi => hl i (hsub.subset hi), hk.trans hprod, by simpa only [hprod] using hlen⟩

/-- The equality is

```lean
rootInversionCount b w⁻¹ = rootInversionCount b w
```
-/
@[simp] theorem rootInversionCount_inv (b : P.Base) (w : P.weylGroup) :
    rootInversionCount b w⁻¹ = rootInversionCount b w := by
  simpa only [weylCoxeterSystem_length] using (weylCoxeterSystem b).length_inv w

/-- Ordinary minimum-length representatives for right cosets of the subgroup. -/
def IsMinimalRightParabolic (b : P.Base) (J : Set b.support) (d : P.weylGroup) : Prop :=
  ∀ a ∈ standardParabolicSubgroup b J, rootInversionCount b d ≤ rootInversionCount b (d * a)

omit [Finite ι] [IsDomain R] [P.IsCrystallographic] [P.IsReduced] in
/-- Every right coset has a minimum for inversion length. The
factorization is obtained by choosing that minimum; length additivity is
`Roots/ParabolicLength.lean`. -/
theorem ParabolicSubgroup.exists_rightParabolic_factorization (b : P.Base) (J : Set b.support)
    (w : P.weylGroup) :
    ∃ d a : P.weylGroup, IsMinimalRightParabolic b J d ∧
      a ∈ standardParabolicSubgroup b J ∧ w = d * a := by
  classical
  have hex : ∃ n : ℕ, ∃ a ∈ standardParabolicSubgroup b J,
      rootInversionCount b (w * a) = n :=
    ⟨rootInversionCount b w, 1, (standardParabolicSubgroup b J).one_mem, by simp⟩
  obtain ⟨a, ha, hlen⟩ := Nat.find_spec hex
  refine ⟨w * a, a⁻¹, ?_, (standardParabolicSubgroup b J).inv_mem ha, by simp⟩
  intro c hc
  have hmin := Nat.find_min' hex
    ⟨a * c, (standardParabolicSubgroup b J).mul_mem ha hc, rfl⟩
  simpa only [← hlen, mul_assoc] using hmin

end ReductiveGroups
