import OrbitComplexity.ReductiveGroups.Roots.Supports.BooleanRootGrowth
import OrbitComplexity.ReductiveGroups.Roots.Supports.DistinctWordSupport

/-!
# Boolean Support Localization

The simply-laced hypothesis is needed only on the final root support,
as in the subsystem generated by that support. The ambient
root system and unused letters may contain multiple bonds. -/

noncomputable section
namespace ReductiveGroups
attribute [local instance] Classical.decEq

variable {ι R M N : Type*} [CommRing R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic]

/-- The inclusion is

```lean
simpleRootSupportInt b β ⊆ simpleRootSupportInt b (P.reflectionPerm (j : ι) β)
```
-/
theorem SimpleRootSupportInt.subset_reflection_of_omitted
    (b : P.Base) (β : ι) (j : b.support)
    (hj : simpleRootCoeffInt b β j = 0) :
    simpleRootSupportInt b β ⊆ simpleRootSupportInt b (P.reflectionPerm (j : ι) β) := by
  intro k hk
  have hjk : j ≠ k := by
    intro h
    exact hk (h ▸ hj)
  change simpleRootCoeffInt b (P.reflectionPerm (j : ι) β) k ≠ 0
  rw [simpleRootCoeffInt_reflection, ite_eq_right hjk, mul_zero, sub_zero]
  exact hk

variable [IsDomain R] [Finite ι] [P.IsReduced]

/-- A distinct simple word acting on an omitted initial simple root has
0/1 coordinates whenever the Cartan entries within its final support are
simply laced. No condition on other ambient vertices is imposed. -/
theorem SimpleWeylWord.simple_coeff_zero_one_of_support
    (b : P.Base) (word : List b.support) (hword : word.Nodup)
    (i : b.support) (hi : i ∉ word)
    (hCartan : ∀ u ∈ simpleRootSupportInt b
          (P.weylGroupToPerm (simpleWeylWord b word) (i : ι)),
      ∀ v ∈ simpleRootSupportInt b
          (P.weylGroupToPerm (simpleWeylWord b word) (i : ι)),
      u ≠ v → P.pairingIn ℤ (u : ι) (v : ι) = 0 ∨
        P.pairingIn ℤ (u : ι) (v : ι) = -1) :
    ∀ k : b.support,
      simpleRootCoeffInt b (P.weylGroupToPerm (simpleWeylWord b word) (i : ι)) k = 0 ∨
      simpleRootCoeffInt b (P.weylGroupToPerm (simpleWeylWord b word) (i : ι)) k = 1 := by
  induction word with
  | nil =>
    intro k
    change simpleRootCoeffInt b (i : ι) k = 0 ∨ simpleRootCoeffInt b (i : ι) k = 1
    rw [simpleRootCoeffInt_simple]
    by_cases h : i = k <;> simp [h]
  | cons j tail ih =>
    have htail : tail.Nodup := (List.nodup_cons.mp hword).2
    have hjtail : j ∉ tail := (List.nodup_cons.mp hword).1
    have hitail : i ∉ tail := fun h => hi (List.mem_cons_of_mem _ h)
    have hji : j ≠ i := fun h => hi (by simp [h])
    let β : ι := P.weylGroupToPerm (simpleWeylWord b tail) (i : ι)
    have hβpos : b.IsPos β := simpleWeylWord_isPos_of_notMem_ambient b tail hitail
    have hjzero : simpleRootCoeffInt b β j = 0 :=
      SimpleWeylWord.simple_coeff_zero_of_omitted b tail i j hji hjtail
    have hsub := SimpleRootSupportInt.subset_reflection_of_omitted b β j hjzero
    have hβcoeff : ∀ k : b.support,
        simpleRootCoeffInt b β k = 0 ∨ simpleRootCoeffInt b β k = 1 :=
      ih htail hitail (fun u hu v hv hne => hCartan u (hsub hu) v (hsub hv) hne)
    intro k
    change simpleRootCoeffInt b (P.reflectionPerm (j : ι) β) k = 0 ∨
      simpleRootCoeffInt b (P.reflectionPerm (j : ι) β) k = 1
    by_cases hfix : P.reflectionPerm (j : ι) β = β
    · simpa only [hfix] using hβcoeff k
    · obtain ⟨u, hu, huj, _, _, hsupp, hother, hnew⟩ :=
        booleanRootGrowth_reflection b β hβpos j hjzero hfix
      have huNe : u ≠ j := by
        intro h
        subst u
        exact hu hjzero
      have hjmem : j ∈ simpleRootSupportInt b (P.reflectionPerm (j : ι) β) := by
        rw [hsupp]
        exact Or.inr rfl
      have hpair : P.pairingIn ℤ (u : ι) (j : ι) = -1 :=
        (hCartan u (hsub hu) j hjmem huNe).resolve_left huj
      have huOne : simpleRootCoeffInt b β u = 1 := (hβcoeff u).resolve_left hu
      by_cases hk : k = j
      · subst k
        right
        rw [hnew, huOne, hpair]
        norm_num
      · rw [hother k hk]
        exact hβcoeff k

end ReductiveGroups
