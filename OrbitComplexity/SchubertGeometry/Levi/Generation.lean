import OrbitComplexity.SchubertGeometry.Levi.Center
import OrbitComplexity.ReductiveGroups.Groups.Reductive.GroupLeviSimple

/-! # Generators of the standard Levi point group

The Bruhat normal form of a Levi point reduces generation to selected Weyl representatives.
Each selected representative is a product of positive and negative simple-root points.
-/

noncomputable section
namespace SchubertGeometry
open ReductiveGroups GroupActions TauCeti
universe u
variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K] (G : ReductiveGroupData K)

/-- The Levi point group is generated by its Borel and its selected negative simple root groups. -/
theorem leviPoints_eq_generated (I : Set G.rootBase.support) :
    G.leviPoints I = G.leviBorelPoints I ⊔ Subgroup.closure
      (⋃ i : I, Set.range (fun c : K => gaParameterPoint (G.negativeSimpleRootMap i.val) c)) := by
  let H := G.leviBorelPoints I ⊔ Subgroup.closure
    (⋃ i : I, Set.range (fun c : K => gaParameterPoint (G.negativeSimpleRootMap i.val) c))
  have hBH : G.leviBorelPoints I ≤ H := le_sup_left
  have hTH : G.torusPoints ≤ H := (G.torus_le_leviBorelPoints I).trans hBH
  have hneg (i : G.rootBase.support) (hi : i ∈ I) (c : K) :
      gaParameterPoint (G.negativeSimpleRootMap i) c ∈ H := by
    apply (le_sup_right : Subgroup.closure _ ≤ H)
    apply Subgroup.subset_closure
    exact Set.mem_iUnion.mpr ⟨⟨i, hi⟩, Set.mem_range_self c⟩
  have href (i : G.rootBase.support) (hi : i ∈ I) : G.reflectionPoint i.val ∈ H := by
    have hp : gaParameterPoint (G.simpleRootMap i) 1 ∈ H :=
      hBH ⟨G.simpleRootPoint_mem_levi I i hi 1, (G.isBruhatSystem.rankOne i).x_mem 1⟩
    change gaParameterPoint (G.simpleRootMap i) 1 *
      gaParameterPoint (G.negativeSimpleRootMap i) (-1) *
      gaParameterPoint (G.simpleRootMap i) 1 ∈ H
    exact H.mul_mem (H.mul_mem hp (hneg i hi (-1))) hp
  apply le_antisymm
  · intro g hg
    obtain ⟨w, u, b, hprod, hwb⟩ := leviPoint_normalForm G I g hg
    have hnL := levi_weyl_of_mul_borel G I w b b.property hwb
    have hw := (G.weylPoint_mem_levi_iff I w).mp hnL
    obtain ⟨l, hl, hword⟩ := (mem_standardParabolicSubgroup_iff_word G.rootBase I w).mp hw
    have hp : simpleWordPoint G.reflectionPoint G.rootBase l ∈ H := by
      change (l.map (fun i : G.rootBase.support => G.reflectionPoint i.val)).prod ∈ H
      apply Subgroup.list_prod_mem
      intro g hg
      obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hg
      exact href i (hl i hi)
    obtain ⟨t, ht, he⟩ := G.isBruhatSystem.weyl.simpleWordPoint_eq_mul_weylElementPoint
      G.rootBase l
    rw [hword, ← G.weylPoint_eq] at he
    have hn : G.weylPoint w ∈ H := by
      have hh := H.mul_mem (H.inv_mem (hTH ht)) hp
      rwa [he, inv_mul_cancel_left] at hh
    have huH : (u : G.points) ∈ H := hBH
      (G.rootSubsetPoints_le_leviBorel I _ _ Set.Subset.rfl u.property)
    have hbL : (b : G.points) ∈ G.leviPoints I := by
      have hh := (G.leviPoints I).mul_mem ((G.leviPoints I).inv_mem hnL) hwb
      simpa only [inv_mul_cancel_left] using hh
    exact hprod ▸ H.mul_mem (H.mul_mem huH hn) (hBH ⟨hbL, b.property⟩)
  · apply sup_le inf_le_left
    apply (Subgroup.closure_le _).mpr
    rintro g hg
    obtain ⟨i, c, rfl⟩ := Set.mem_iUnion.mp hg
    exact G.negativeRootPoint_mem_levi I i.val i.property c

end SchubertGeometry
