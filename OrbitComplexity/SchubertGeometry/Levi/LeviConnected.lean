import OrbitComplexity.SchubertGeometry.Levi.Generation
import OrbitComplexity.SchubertGeometry.Levi.Subgroup
import OrbitComplexity.SchubertGeometry.Levi.Connected
import OrbitComplexity.ReductiveGroups.Groups.Solvable.ConnectedGeneratedSubgroup
import OrbitComplexity.ReductiveGroups.Groups.RootCoordinates.BorelRootGeneratedGeometry

/-! # Connectedness of standard Levi subgroups

The Levi is generated by its connected Borel intersection and negative simple-root
groups. Their common-kernel quotient is the reduced Levi coordinate algebra.
-/

noncomputable section
namespace SchubertGeometry
open ReductiveGroups GroupActions TauCeti CategoryTheory WithConv
universe u
variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K] (G : ReductiveGroupData K)

private def generatorAlgebra (I : Set G.rootBase.support) : Option I → CommHopfAlgCat.{u} K
  | none => (G.leviBorelAlgebra I).obj
  | some _ => CommHopfAlgCat.of K (SymmetricAlgebra K K)

private def generatorFamily (I : Set G.rootBase.support) :
    ∀ i, CommHopfAlgCat.of K G.coordinateAlgebra ⟶ generatorAlgebra G I i
  | none => CommHopfAlgCat.mkQuotient _ (G.leviBorelIdeal I)
  | some i => CommHopfAlgCat.ofHom (G.negativeSimpleRootMap i.val)

private instance generator_finiteType (I : Set G.rootBase.support) (i : Option I) :
    Algebra.FiniteType K (generatorAlgebra G I i) := by
  cases i with
  | none => change Algebra.FiniteType K (G.leviBorelAlgebra I); infer_instance
  | some i =>
      change Algebra.FiniteType K (SymmetricAlgebra K K)
      exact Algebra.FiniteType.of_surjective (gaPolynomialEquiv K).symm.toAlgHom
        (gaPolynomialEquiv K).symm.surjective

private instance generator_reduced (I : Set G.rootBase.support) (i : Option I) :
    IsReduced (generatorAlgebra G I i) := by
  cases i with
  | none => change IsReduced (G.leviBorelAlgebra I); infer_instance
  | some i =>
      change IsReduced (SymmetricAlgebra K K)
      let : IsDomain (SymmetricAlgebra K K) := (gaPolynomialEquiv K).injective.isDomain
      infer_instance

private instance generator_connected (I : Set G.rootBase.support) (i : Option I) :
    ConnectedSpace (PrimeSpectrum (generatorAlgebra G I i)) := by
  cases i with
  | none => change ConnectedSpace (leviBorelVariety G I).scheme; infer_instance
  | some i =>
      change ConnectedSpace (PrimeSpectrum (SymmetricAlgebra K K))
      let : IsDomain (SymmetricAlgebra K K) := (gaPolynomialEquiv K).injective.isDomain
      infer_instance

private theorem generator_none_range (I : Set G.rootBase.support) :
    Set.range (fun p : HopfAlgebra.points (R := K) (H := generatorAlgebra G I none)
        (CommAlgCat.of K K) => toConv (p.ofConv.comp (generatorFamily G I none).hom.toAlgHom)) =
      (G.leviBorelPoints I : Set G.points) := by
  rw [← G.leviBorelIdeal_points I]
  rfl

private theorem generator_some_range (I : Set G.rootBase.support) (i : I) :
    Set.range (fun p : HopfAlgebra.points (R := K) (H := generatorAlgebra G I (some i))
        (CommAlgCat.of K K) =>
      toConv (p.ofConv.comp (generatorFamily G I (some i)).hom.toAlgHom)) =
      Set.range (fun c : K => gaParameterPoint (G.negativeSimpleRootMap i.val) c) := by
  change Set.range (AlgHom.mapDomain (G.negativeSimpleRootMap i.val)) = _
  ext g
  constructor
  · rintro ⟨p, rfl⟩
    refine ⟨Multiplicative.toAdd ((AdditiveGroup.gaPointsMulEquiv (R := K) (A := K)) p), ?_⟩
    change AlgHom.mapDomain (G.negativeSimpleRootMap i.val)
      ((AdditiveGroup.gaPointsMulEquiv (R := K) (A := K)).symm
        ((AdditiveGroup.gaPointsMulEquiv (R := K) (A := K)) p)) = _
    rw [MulEquiv.symm_apply_apply]
  · rintro ⟨c, rfl⟩
    exact ⟨(AdditiveGroup.gaPointsMulEquiv (R := K) (A := K)).symm
      (Multiplicative.ofAdd c), rfl⟩

private theorem generator_points (I : Set G.rootBase.support) :
    connectedGeneratedPointSubgroup (CommHopfAlgCat.of K G.coordinateAlgebra)
      (generatorAlgebra G I) (generatorFamily G I) = G.leviPoints I := by
  unfold connectedGeneratedPointSubgroup
  rw [Set.iUnion_option, generator_none_range]
  rw [Set.iUnion_congr (fun i : I => generator_some_range G I i)]
  rw [Subgroup.closure_union, Subgroup.closure_eq, ← leviPoints_eq_generated G I]

private theorem generator_ideal (I : Set G.rootBase.support) :
    CommHopfAlgCat.commonKernelHopfIdeal (generatorFamily G I) = G.leviIdeal I := by
  rw [CommonKernelHopfIdeal.eq_generated_vanishingIdeal
    (CommHopfAlgCat.of K G.coordinateAlgebra) (generatorAlgebra G I), generator_points]
  rfl

/-- The standard Levi coordinate Hopf algebra is geometrically connected. -/
theorem levi_geometricallyConnected (I : Set G.rootBase.support) :
    geometricallyConnectedCommHopfAlgProperty K (G.leviAlgebra I).obj := by
  have h := CommonKernelQuotient.geometrically_connected
    (CommHopfAlgCat.of K G.coordinateAlgebra) (generatorAlgebra G I) (generatorFamily G I)
  rw [generator_ideal] at h
  exact h

/-- The standard Levi variety is connected. -/
instance levi_connected (I : Set G.rootBase.support) : ConnectedSpace (leviVariety G I).scheme :=
  (geometricallyConnectedCommHopfAlgProperty_iff_connectedSpace K (G.leviAlgebra I).obj).mp
    (levi_geometricallyConnected G I)

end SchubertGeometry
