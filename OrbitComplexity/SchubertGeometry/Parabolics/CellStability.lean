import OrbitComplexity.SchubertGeometry.Parabolics.BruhatClosure
import Mathlib.GroupTheory.GroupAction.Basic

/-! # Simple parabolic stabilizers of Schubert varieties

The subgroup generated by the Borel and selected simple reflection representatives
preserves a Schubert closure exactly when those simples are left descents. The proof uses
the Bruhat closure relation and the multiplication rule for a simple reflection.
-/

noncomputable section
namespace SchubertGeometry
open ReductiveGroups GroupActions
open scoped Pointwise
universe u
variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  (G : ReductiveGroupData K)

/-- The point subgroup generated by the Borel and prescribed simple representatives. -/
def standardParabolicPoints (I : Set G.rootBase.support) : Subgroup G.points :=
  G.borelPoints ⊔ Subgroup.closure ((fun i : G.rootBase.support => G.reflectionPoint i.val) '' I)

private theorem groupFlag_mem_closure (w : G.weylGroup) (g : G.points) :
    flagVarietyPointsEquiv G (flagProjection G g) ∈
        Set.range (Variety.mapPoints (schubertInclusion G w)) ↔
      g ∈ closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)) := by
  rw [schubertVariety_points_cells, bruhat_doubleCoset_closure]
  simp only [Set.mem_iUnion, schubertCell_points_range, mem_schubertOrbit_iff]

private theorem doubleCoset_inverse {w : G.weylGroup} {g : G.points}
    (hg : g ∈ subgroupDoubleCoset G.borelPoints (G.weylPoint w)) :
    g⁻¹ ∈ subgroupDoubleCoset G.borelPoints (G.weylPoint w⁻¹) := by
  obtain ⟨t, ht, he⟩ := G.isBruhatSystem.weyl.weylElementPoint_inv G.rootBase w
  change (G.weylPoint w)⁻¹ = t * G.weylPoint w⁻¹ at he
  obtain ⟨b, hb, c, hc, rfl⟩ := hg
  refine ⟨c⁻¹ * t, G.borelPoints.mul_mem (G.borelPoints.inv_mem hc) (G.torus_le_borel ht),
    b⁻¹, G.borelPoints.inv_mem hb, ?_⟩
  rw [mul_inv_rev, mul_inv_rev, he]
  group

private theorem simple_mul_doubleCoset (w : G.weylGroup) (i : G.rootBase.support)
    {g : G.points} (hg : g ∈ subgroupDoubleCoset G.borelPoints (G.weylPoint w)) :
    G.reflectionPoint i.val * g ∈ subgroupDoubleCoset G.borelPoints
        (G.weylPoint (RootPairing.weylGroup.ofIdx G.rootSystem i.val * w)) ∨
      G.reflectionPoint i.val * g ∈ subgroupDoubleCoset G.borelPoints (G.weylPoint w) := by
  have hm := G.isBruhatSystem.doubleCoset_mul w⁻¹ i
    (doubleCoset_inverse G hg) (G.isBruhatSystem.rankOne i).inv_mem_doubleCoset
  change g⁻¹ * (G.reflectionPoint i.val)⁻¹ ∈
      subgroupDoubleCoset G.borelPoints
        (G.weylPoint (w⁻¹ * RootPairing.weylGroup.ofIdx G.rootSystem i.val)) ∨
    g⁻¹ * (G.reflectionPoint i.val)⁻¹ ∈
      subgroupDoubleCoset G.borelPoints (G.weylPoint w⁻¹) at hm
  rcases hm with hm | hm
  · left
    simpa only [mul_inv_rev, inv_inv, weylGroup_simple_inv] using doubleCoset_inverse G hm
  · right
    simpa only [mul_inv_rev, inv_inv] using doubleCoset_inverse G hm

private theorem simple_le_of_negative (w : G.weylGroup) (i : G.rootBase.support)
    (hi : ¬ G.rootBase.IsPos (G.rootSystem.weylGroupToPerm w⁻¹ i.val)) :
    WeylBruhatLE G.rootBase (RootPairing.weylGroup.ofIdx G.rootSystem i.val * w) w := by
  have hdrop := rootInversionCount_mul_simple_of_neg G.rootBase w⁻¹ i
    ((root_height_neg_iff_not_isPos G.rootBase _).mpr hi)
  obtain ⟨l, hl, hlen⟩ := InversionLength.exists_of_inversionCount_length G.rootBase
    (w⁻¹ * RootPairing.weylGroup.ofIdx G.rootSystem i.val)
  have hprod : simpleWeylWord G.rootBase (l ++ [i]) = w⁻¹ := by
    simp only [simpleWeylWord_append, simpleWeylWord, mul_one, hl, mul_assoc,
      weylGroup_ofIdx_mul_self]
  have hred : rootInversionCount G.rootBase (simpleWeylWord G.rootBase (l ++ [i])) =
      (l ++ [i]).length := by
    rw [hprod, List.length_append, List.length_singleton, hlen]
    exact hdrop.symm
  have hle := weylBruhatLE_of_sublist G.rootBase hred (List.sublist_append_left l [i])
  rw [hprod, hl] at hle
  simpa only [mul_inv_rev, weylGroup_simple_inv, inv_inv] using hle.inv

private theorem borel_closure_stable (w : G.weylGroup) (b : G.points)
    (hb : b ∈ G.borelPoints) {g : G.points}
    (hg : g ∈ closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w))) :
    b * g ∈ closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)) :=
  map_mem_closure SeparatelyContinuousMul.continuous_const_mul hg
    (fun _ ha => mul_mem_subgroupDoubleCoset ha hb)

private theorem simple_closure_stable (w : G.weylGroup) (i : G.rootBase.support)
    (hi : ¬ G.rootBase.IsPos (G.rootSystem.weylGroupToPerm w⁻¹ i.val)) {g : G.points}
    (hg : g ∈ closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w))) :
    G.reflectionPoint i.val * g ∈
      closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)) := by
  have hm := map_mem_closure SeparatelyContinuousMul.continuous_const_mul hg
    (fun a ha => show G.reflectionPoint i.val * a ∈
        closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)) from by
      rcases simple_mul_doubleCoset G w i ha with ha | ha
      · rw [bruhat_doubleCoset_closure]
        exact Set.mem_iUnion₂.mpr ⟨_, simple_le_of_negative G w i hi, ha⟩
      · exact subset_closure ha)
  simpa only [closure_closure] using hm

private theorem simplePoint_weyl_mem (w : G.weylGroup) (i : G.rootBase.support) :
    G.reflectionPoint i.val * G.weylPoint w ∈ subgroupDoubleCoset G.borelPoints
      (G.weylPoint (RootPairing.weylGroup.ofIdx G.rootSystem i.val * w)) := by
  obtain ⟨a, ha, hea⟩ := G.isBruhatSystem.weyl.simple_eq_mul_weylElementPoint G.rootBase i
  obtain ⟨b, hb, heb⟩ := G.isBruhatSystem.weyl.weylElementPoint_mul G.rootBase
    (RootPairing.weylGroup.ofIdx G.rootSystem i.val) w
  change G.reflectionPoint i.val = a * G.weylPoint _ at hea
  change G.weylPoint _ * G.weylPoint w = b * G.weylPoint _ at heb
  refine ⟨a * b, G.torus_le_borel (G.torusPoints.mul_mem ha hb), 1,
    G.borelPoints.one_mem, ?_⟩
  rw [hea, mul_assoc, heb]
  group

private theorem parabolic_le_stabilizer (I : Set G.rootBase.support) (w : G.weylGroup)
    (hI : ∀ i ∈ I, ¬ G.rootBase.IsPos (G.rootSystem.weylGroupToPerm w⁻¹ i.val)) :
    standardParabolicPoints G I ≤ MulAction.stabilizer G.points
      (closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w))) := by
  apply sup_le
  · rw [MulAction.le_stabilizer_iff_smul_le]
    intro b hb
    rintro _ ⟨a, ha, rfl⟩
    exact borel_closure_stable G w b hb ha
  · apply (Subgroup.closure_le _).mpr
    rintro n ⟨i, hiI, rfl⟩
    change G.reflectionPoint i.val ∈ MulAction.stabilizer G.points
      (closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)))
    rw [MulAction.mem_stabilizer_iff]
    apply subset_antisymm
    · rintro _ ⟨a, ha, rfl⟩
      exact simple_closure_stable G w i (hI i hiI) ha
    · intro a ha
      refine ⟨(G.reflectionPoint i.val)⁻¹ * a, ?_, by simp⟩
      obtain ⟨t, ht, he⟩ := (G.isBruhatSystem.rankOne i).inv_eq
      rw [he, mul_assoc]
      exact borel_closure_stable G w t (G.torus_le_borel ht)
        (simple_closure_stable G w i (hI i hiI) ha)

/-- A standard parabolic point subgroup preserves a Schubert variety precisely at left descents. -/
theorem parabolic_schubert_stable_iff (I : Set G.rootBase.support) (w : G.weylGroup) :
    (∀ g ∈ standardParabolicPoints G I, ∀ q : flagPoints G,
      flagVarietyPointsEquiv G q ∈ Set.range (Variety.mapPoints (schubertInclusion G w)) →
        flagVarietyPointsEquiv G (g • q) ∈
          Set.range (Variety.mapPoints (schubertInclusion G w))) ↔
      ∀ i ∈ I, ¬ G.rootBase.IsPos (G.rootSystem.weylGroupToPerm w⁻¹ i.val) := by
  constructor
  · intro hstable i hiI hpos
    have hn : G.reflectionPoint i.val ∈ standardParabolicPoints G I := by
      apply (show Subgroup.closure
        ((fun j : G.rootBase.support => G.reflectionPoint j.val) '' I) ≤
          standardParabolicPoints G I from le_sup_right)
      exact Subgroup.subset_closure ⟨i, hiI, rfl⟩
    have hw : flagVarietyPointsEquiv G (flagProjection G (G.weylPoint w)) ∈
        Set.range (Variety.mapPoints (schubertInclusion G w)) :=
      (weylFlag_mem_schubert_iff G w w).mpr (WeylBruhatLE.refl _ _)
    have hmem := hstable _ hn _ hw
    change flagVarietyPointsEquiv G
      (flagProjection G (G.reflectionPoint i.val * G.weylPoint w)) ∈ _ at hmem
    rw [groupFlag_mem_closure, bruhat_doubleCoset_closure] at hmem
    obtain ⟨v, hv, hgv⟩ := Set.mem_iUnion₂.mp hmem
    have he := bruhatDecomposition_unique G (simplePoint_weyl_mem G w i) hgv
    rw [← he] at hv
    have hlen := hv.length_le
    have hinc := rootInversionCount_mul_simple_of_pos G.rootBase w⁻¹ i hpos
    have hinv := rootInversionCount_inv G.rootBase
      (RootPairing.weylGroup.ofIdx G.rootSystem i.val * w)
    rw [mul_inv_rev, weylGroup_simple_inv] at hinv
    rw [rootInversionCount_inv] at hinc
    omega
  · intro hI g hg q hq
    obtain ⟨a, rfl⟩ := flagProjection_surjective G q
    rw [groupFlag_mem_closure] at hq
    change flagVarietyPointsEquiv G (flagProjection G (g * a)) ∈ _
    rw [groupFlag_mem_closure]
    have hs := (MulAction.le_stabilizer_iff_smul_le _ _).mp
      (parabolic_le_stabilizer G I w hI) g hg
    exact hs ⟨a, hq, rfl⟩

end SchubertGeometry
