import OrbitComplexity.SchubertGeometry.Parabolics.CellStability

/-! # Closed subgroups containing the Borel

Bruhat closures show that a closed subgroup containing the Borel is generated by its
simple reflection representatives. Translation stabilizers of closed point sets are closed,
and inverse images along surjective equivariant maps preserve stabilizers.
-/

noncomputable section
namespace SchubertGeometry
open ReductiveGroups GroupActions
open scoped Pointwise

/-- A surjective equivariant map preserves the stabilizer of each inverse image. -/
theorem stabilizer_preimage_of_surjective {Γ X Y : Type*} [Group Γ]
    [MulAction Γ X] [MulAction Γ Y] (f : X → Y) (hsurj : Function.Surjective f)
    (heq : ∀ g : Γ, ∀ x : X, f (g • x) = g • f x) (s : Set Y) :
    MulAction.stabilizer Γ (f ⁻¹' s) = MulAction.stabilizer Γ s := by
  have hpre (g : Γ) : g • (f ⁻¹' s) = f ⁻¹' (g • s) := by
    ext x
    simp only [Set.mem_smul_set_iff_inv_smul_mem, Set.mem_preimage, heq]
  ext g
  rw [MulAction.mem_stabilizer_iff, MulAction.mem_stabilizer_iff, hpre]
  exact (Set.preimage_injective.mpr hsurj).eq_iff

universe u
variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  (G : ReductiveGroupData K)

omit [IsAlgClosed K] [CharZero K] in
private theorem point_inverse_continuous : Continuous (fun g : G.points => g⁻¹) := by
  let _ : TopologicalSpace (G.coordinateAlgebra →ₐ[K] K) := pointZariskiTopology
  apply continuous_induced_rng.mpr
  exact (pointZariski_continuous_comp
    (HopfAlgebra.antipodeAlgHom K G.coordinateAlgebra)).comp continuous_induced_dom

omit [IsAlgClosed K] [CharZero K] in
/-- The translation stabilizer of a closed set of reductive group points is closed. -/
theorem isClosed_set_stabilizer (C : Set G.points) (hC : IsClosed C) :
    IsClosed (MulAction.stabilizer G.points C : Set G.points) := by
  have he : (MulAction.stabilizer G.points C : Set G.points) =
      (⋂ x ∈ C, (fun g : G.points => g * x) ⁻¹' C) ∩
        (⋂ x ∈ C, (fun g : G.points => g⁻¹ * x) ⁻¹' C) := by
    ext g
    simp only [Set.mem_inter_iff, Set.mem_iInter, Set.mem_preimage]
    constructor
    · intro hg
      have hf := MulAction.mem_stabilizer_iff.mp hg
      have hb := MulAction.mem_stabilizer_iff.mp
        ((MulAction.stabilizer G.points C).inv_mem hg)
      exact ⟨fun x hx => hf ▸ Set.smul_mem_smul_set hx,
        fun x hx => hb ▸ Set.smul_mem_smul_set hx⟩
    · rintro ⟨hf, hb⟩
      change g ∈ MulAction.stabilizer G.points C
      rw [MulAction.mem_stabilizer_iff]
      apply subset_antisymm
      · rintro _ ⟨x, hx, rfl⟩
        exact hf x hx
      · intro x hx
        exact ⟨g⁻¹ * x, hb x hx, by simp⟩
  rw [he]
  exact (isClosed_iInter fun x => isClosed_iInter fun _ =>
    hC.preimage SeparatelyContinuousMul.continuous_mul_const).inter
      (isClosed_iInter fun x => isClosed_iInter fun _ =>
        hC.preimage (SeparatelyContinuousMul.continuous_mul_const.comp
          (point_inverse_continuous G)))

private theorem doubleCoset_subset_subgroup (H : Subgroup G.points)
    (hB : G.borelPoints ≤ H) {v : G.weylGroup} (hv : G.weylPoint v ∈ H) :
    subgroupDoubleCoset G.borelPoints (G.weylPoint v) ⊆ H := by
  rintro _ ⟨b, hb, c, hc, rfl⟩
  exact H.mul_mem (H.mul_mem (hB hb) hv) (hB hc)

private theorem weylPoint_mem_of_doubleCoset (H : Subgroup G.points)
    (hB : G.borelPoints ≤ H) {v : G.weylGroup} {g : G.points}
    (hg : g ∈ H) (hv : g ∈ subgroupDoubleCoset G.borelPoints (G.weylPoint v)) :
    G.weylPoint v ∈ H := by
  obtain ⟨b, hb, c, hc, rfl⟩ := hv
  have hm := H.mul_mem (H.mul_mem (H.inv_mem (hB hb)) hg) (H.inv_mem (hB hc))
  simpa only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one] using hm

private theorem simple_mem_of_word (H : Subgroup G.points)
    (hclosed : IsClosed (H : Set G.points)) (hB : G.borelPoints ≤ H)
    (v : G.weylGroup) (hv : G.weylPoint v ∈ H)
    (i : G.rootBase.support) (hi : i ∈ chosenReducedWord G.rootBase v) :
    G.reflectionPoint i.val ∈ H := by
  have hred := (weylCoxeterSystem_isReduced_iff G.rootBase _).mp
    (chosenReducedWord_isReduced G.rootBase v)
  have hle := weylBruhatLE_of_sublist G.rootBase hred (List.singleton_sublist.mpr hi)
  rw [simpleWeylWord_chosenReducedWord] at hle
  have hsimple : G.reflectionPoint i.val ∈ subgroupDoubleCoset G.borelPoints
      (G.weylPoint (simpleWeylWord G.rootBase [i])) := by
    obtain ⟨t, ht, he⟩ := G.isBruhatSystem.weyl.simple_eq_mul_weylElementPoint G.rootBase i
    refine ⟨t, G.torus_le_borel ht, 1, G.borelPoints.one_mem, ?_⟩
    simpa only [simpleWeylWord, mul_one, G.weylPoint_eq] using he
  have hc : closure (subgroupDoubleCoset G.borelPoints (G.weylPoint v)) ⊆ H :=
    closure_minimal (doubleCoset_subset_subgroup G H hB hv) hclosed
  apply hc
  rw [bruhat_doubleCoset_closure]
  exact Set.mem_iUnion₂.mpr ⟨_, hle, hsimple⟩

/-- A closed subgroup containing the Borel is generated by its simple representatives. -/
theorem closed_borel_subgroup_eq (H : Subgroup G.points)
    (hclosed : IsClosed (H : Set G.points)) (hB : G.borelPoints ≤ H) :
    H = standardParabolicPoints G {i | G.reflectionPoint i.val ∈ H} := by
  apply le_antisymm
  · intro g hg
    obtain ⟨v, hv⟩ := bruhatDecomposition G g
    have hn := weylPoint_mem_of_doubleCoset G H hB hg hv
    let P := standardParabolicPoints G {i | G.reflectionPoint i.val ∈ H}
    have hBP : G.borelPoints ≤ P := le_sup_left
    have hnp : G.weylPoint v ∈ P := by
      rw [G.weylPoint_eq, weylElementPoint]
      change ((chosenReducedWord G.rootBase v).map
        (fun i : G.rootBase.support => G.reflectionPoint i.val)).prod ∈ P
      apply Subgroup.list_prod_mem
      intro x hx
      obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
      exact (le_sup_right : Subgroup.closure _ ≤ P)
        (Subgroup.subset_closure ⟨i, simple_mem_of_word G H hclosed hB v hn i hi, rfl⟩)
    exact doubleCoset_subset_subgroup G P hBP hnp hv
  · apply sup_le hB
    exact (Subgroup.closure_le H).mpr (by rintro _ ⟨i, hi, rfl⟩; exact hi)

end SchubertGeometry
