import OrbitComplexity.SchubertGeometry.Parabolics.CellStability
import OrbitComplexity.ReductiveGroups.Roots.Parabolic.Longest

/-! # Bruhat double cosets of standard parabolics

The subgroup generated by the Borel and selected simple representatives is the union
of the double cosets indexed by the corresponding parabolic Weyl subgroup. It is
the closure of the double coset of the longest parabolic element and is closed.
-/

noncomputable section
namespace SchubertGeometry
open ReductiveGroups GroupActions
open scoped Pointwise
universe u
variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  (G : ReductiveGroupData K)

private theorem weyl_mem_parabolic (I : Set G.rootBase.support) (v : G.weylGroup)
    (hv : v ∈ standardParabolicSubgroup G.rootBase I) :
    G.weylPoint v ∈ standardParabolicPoints G I := by
  obtain ⟨l, hl, hword⟩ := (mem_standardParabolicSubgroup_iff_word G.rootBase I v).mp hv
  let H := standardParabolicPoints G I
  have hp : simpleWordPoint G.reflectionPoint G.rootBase l ∈ H := by
    change (l.map (fun i : G.rootBase.support => G.reflectionPoint i.val)).prod ∈ H
    apply Subgroup.list_prod_mem
    intro g hg
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hg
    exact (le_sup_right : Subgroup.closure _ ≤ H)
      (Subgroup.subset_closure ⟨i, hl i hi, rfl⟩)
  obtain ⟨t, ht, he⟩ := G.isBruhatSystem.weyl.simpleWordPoint_eq_mul_weylElementPoint
    G.rootBase l
  rw [hword, ← G.weylPoint_eq] at he
  have htH : t ∈ H := (le_sup_left : G.borelPoints ≤ H) (G.torus_le_borel ht)
  have hh := H.mul_mem (H.inv_mem htH) hp
  rwa [he, inv_mul_cancel_left] at hh

private theorem doubleCoset_mem_parabolic (I : Set G.rootBase.support) (v : G.weylGroup)
    (hv : v ∈ standardParabolicSubgroup G.rootBase I) :
    subgroupDoubleCoset G.borelPoints (G.weylPoint v) ⊆ standardParabolicPoints G I := by
  rintro _ ⟨b, hb, c, hc, rfl⟩
  exact (standardParabolicPoints G I).mul_mem
    ((standardParabolicPoints G I).mul_mem
      ((le_sup_left : G.borelPoints ≤ standardParabolicPoints G I) hb)
      (weyl_mem_parabolic G I v hv))
    ((le_sup_left : G.borelPoints ≤ standardParabolicPoints G I) hc)

private theorem bruhat_le_parabolic (I : Set G.rootBase.support) {v a : G.weylGroup}
    (ha : a ∈ standardParabolicSubgroup G.rootBase I) (hva : WeylBruhatLE G.rootBase v a) :
    v ∈ standardParabolicSubgroup G.rootBase I := by
  obtain ⟨l, hl, hprod, hlen⟩ := exists_reduced_standardParabolic_word G.rootBase I a ha
  rw [← hprod] at hva
  have hred : rootInversionCount G.rootBase (simpleWeylWord G.rootBase l) = l.length := by
    rw [hprod, hlen]
  obtain ⟨k, hk, hkprod, _⟩ := (weylBruhatLE_iff_subword G.rootBase v l hred).mp hva
  rw [← hkprod]
  exact SimpleWeylWord.mem_standardParabolicSubgroup G.rootBase I k
    (fun i hi => hl i (hk.subset hi))

private theorem groupFlag_mem_closure (w : G.weylGroup) (g : G.points) :
    flagVarietyPointsEquiv G (flagProjection G g) ∈
        Set.range (Variety.mapPoints (schubertInclusion G w)) ↔
      g ∈ closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)) := by
  rw [schubertVariety_points_cells, bruhat_doubleCoset_closure]
  simp only [Set.mem_iUnion, schubertCell_points_range, mem_schubertOrbit_iff]

private theorem one_mem_closure (w : G.weylGroup) :
    (1 : G.points) ∈ closure (subgroupDoubleCoset G.borelPoints (G.weylPoint w)) := by
  have hred := (weylCoxeterSystem_isReduced_iff G.rootBase _).mp
    (chosenReducedWord_isReduced G.rootBase w)
  have hle := weylBruhatLE_of_sublist G.rootBase hred
    (List.nil_sublist (chosenReducedWord G.rootBase w))
  have h1 : WeylBruhatLE G.rootBase 1 w := by
    change WeylBruhatLE G.rootBase 1
      (simpleWeylWord G.rootBase (chosenReducedWord G.rootBase w)) at hle
    rwa [simpleWeylWord_chosenReducedWord] at hle
  rw [bruhat_doubleCoset_closure]
  refine Set.mem_iUnion₂.mpr ⟨1, h1, ?_⟩
  have he : G.weylPoint 1 = 1 := by rw [G.weylPoint_eq, weylElementPoint_one]
  rw [he]
  exact mem_subgroupDoubleCoset_self G.borelPoints 1

private theorem parabolic_closure_eq (I : Set G.rootBase.support) :
    (standardParabolicPoints G I : Set G.points) =
      closure (subgroupDoubleCoset G.borelPoints
        (G.weylPoint (longestParabolicElement G.rootBase I))) := by
  let a := longestParabolicElement G.rootBase I
  have ha := longestParabolicElement_mem G.rootBase I
  have hneg := (eq_longestParabolic_iff G.rootBase I a ha).mp rfl
  have hstable := (parabolic_schubert_stable_iff G I a).mpr hneg
  apply subset_antisymm
  · intro g hg
    have hunit := (groupFlag_mem_closure G a 1).mpr (one_mem_closure G a)
    have hh := hstable g hg (flagProjection G 1) hunit
    change flagVarietyPointsEquiv G (flagProjection G (g * 1)) ∈ _ at hh
    rw [mul_one] at hh
    exact (groupFlag_mem_closure G a g).mp hh
  · intro g hg
    rw [bruhat_doubleCoset_closure] at hg
    obtain ⟨v, hv, hgv⟩ := Set.mem_iUnion₂.mp hg
    exact doubleCoset_mem_parabolic G I v (bruhat_le_parabolic G I ha hv) hgv

/-- A standard parabolic is the closed union of its parabolic Bruhat double cosets. -/
theorem standardParabolicPoints_bruhat (I : Set G.rootBase.support) :
    ((standardParabolicPoints G I : Set G.points) =
      ⋃ v : G.weylGroup, ⋃ (_ : v ∈ standardParabolicSubgroup G.rootBase I),
        subgroupDoubleCoset G.borelPoints (G.weylPoint v)) ∧
      IsClosed (standardParabolicPoints G I : Set G.points) := by
  constructor
  · apply subset_antisymm
    · intro g hg
      rw [parabolic_closure_eq, bruhat_doubleCoset_closure] at hg
      obtain ⟨v, hv, hgv⟩ := Set.mem_iUnion₂.mp hg
      exact Set.mem_iUnion₂.mpr ⟨v, bruhat_le_parabolic G I
        (longestParabolicElement_mem G.rootBase I) hv, hgv⟩
    · intro g hg
      obtain ⟨v, hv, hgv⟩ := Set.mem_iUnion₂.mp hg
      exact doubleCoset_mem_parabolic G I v hv hgv
  · rw [parabolic_closure_eq]
    exact isClosed_closure

end SchubertGeometry
