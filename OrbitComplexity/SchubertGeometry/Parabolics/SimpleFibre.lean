import OrbitComplexity.SchubertGeometry.Parabolics.Projection
import OrbitComplexity.SchubertGeometry.Deodhar.PartialFlagPoints
import OrbitComplexity.SchubertGeometry.Parabolics.BruhatClosure
import OrbitComplexity.SchubertGeometry.Parabolics.ProjectionSmooth
import TauCeti.AlgebraicGeometry.Morphisms.Smooth.GeometricallyReduced

/-! # Simple Schubert fibres of parabolic projection

The standard parabolic generated by one simple reflection identifies the simple Schubert
variety with the scheme fibre over its base partial flag. Smoothness makes that fibre
reduced, and the Bruhat closure relation identifies its closed image.
-/

noncomputable section
namespace SchubertGeometry
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry ReductiveGroups GroupActions
open Topology
universe u
variable {K : Type u} [Field K] [IsAlgClosed K] [CharZero K]
  (G : ReductiveGroupData K)

private theorem singleton_parabolic (i : G.rootBase.support) :
    standardParabolicPoints G {i} = rankOneParabolicPoints G i := by
  apply le_antisymm
  · apply sup_le
    · intro g hg
      exact Or.inl hg
    · apply (Subgroup.closure_le _).mpr
      rintro _ ⟨j, hj, rfl⟩
      have hji : j = i := Set.mem_singleton_iff.mp hj
      subst j
      exact Or.inr (mem_subgroupDoubleCoset_self G.borelPoints (G.reflectionPoint i.val))
  · intro g hg
    rcases hg with hg | hg
    · exact (le_sup_left : G.borelPoints ≤ standardParabolicPoints G {i}) hg
    · obtain ⟨b, hb, c, hc, rfl⟩ := hg
      have hn : G.reflectionPoint i.val ∈ standardParabolicPoints G {i} :=
        (le_sup_right : Subgroup.closure _ ≤ standardParabolicPoints G {i})
          (Subgroup.subset_closure ⟨i, Set.mem_singleton i, rfl⟩)
      exact (standardParabolicPoints G {i}).mul_mem
        ((standardParabolicPoints G {i}).mul_mem
          ((le_sup_left : G.borelPoints ≤ standardParabolicPoints G {i}) hb) hn)
        ((le_sup_left : G.borelPoints ≤ standardParabolicPoints G {i}) hc)

private theorem lower_simple (i : G.rootBase.support) (w : G.weylGroup)
    (hw : WeylBruhatLE G.rootBase w (RootPairing.weylGroup.ofIdx G.rootSystem i.val)) :
    w = 1 ∨ w = RootPairing.weylGroup.ofIdx G.rootSystem i.val := by
  have hs : rootInversionCount G.rootBase
      (RootPairing.weylGroup.ofIdx G.rootSystem i.val) = 1 := by
    rw [← weylCoxeterSystem_length, ← weylCoxeterSystem_simple]
    exact CoxeterSystem.length_simple _ i
  have hle := hw.length_le
  rcases Nat.eq_zero_or_pos (rootInversionCount G.rootBase w) with hz | hz
  · exact Or.inl ((rootInversionCount_eq_zero_iff G.rootBase w).mp hz)
  · exact Or.inr (hw.eq_of_length_eq (by omega))

private theorem simple_doubleCoset (i : G.rootBase.support) :
    subgroupDoubleCoset G.borelPoints
      (G.weylPoint (RootPairing.weylGroup.ofIdx G.rootSystem i.val)) =
        subgroupDoubleCoset G.borelPoints (G.reflectionPoint i.val) := by
  simpa only [G.weylPoint_eq] using (G.isBruhatSystem.doubleCoset_simple_eq i).symm

omit [IsAlgClosed K] [CharZero K] in
private theorem doubleCoset_one :
    subgroupDoubleCoset G.borelPoints 1 = (G.borelPoints : Set G.points) := by
  ext g
  constructor
  · rintro ⟨b, hb, c, hc, rfl⟩
    change b * 1 * c ∈ G.borelPoints
    simpa only [mul_one] using G.borelPoints.mul_mem hb hc
  · intro hg
    exact ⟨g, hg, 1, G.borelPoints.one_mem, by simp⟩

private theorem simple_schubert (i : G.rootBase.support) (g : G.points) :
    flagVarietyPointsEquiv G (flagProjection G g) ∈ Set.range (Variety.mapPoints
      (schubertInclusion G (RootPairing.weylGroup.ofIdx G.rootSystem i.val))) ↔
      g ∈ standardParabolicPoints G {i} := by
  rw [singleton_parabolic]
  change _ ↔ g ∈ G.borelPoints ∨ g ∈
    subgroupDoubleCoset G.borelPoints (G.reflectionPoint i.val)
  rw [schubertVariety_points_cells]
  constructor
  · intro hg
    obtain ⟨v, hv, hgv⟩ := Set.mem_iUnion₂.mp hg
    rw [schubertCell_points_range, mem_schubertOrbit_iff] at hgv
    rcases lower_simple G i v hv with rfl | rfl
    · left
      rw [G.weylPoint_eq, weylElementPoint_one] at hgv
      rw [doubleCoset_one] at hgv
      exact hgv
    · right
      rwa [simple_doubleCoset] at hgv
  · intro hg
    rcases hg with hg | hg
    · apply Set.mem_iUnion₂.mpr
      refine ⟨1, ?_, ?_⟩
      · obtain ⟨l, hprod, hlen⟩ :=
          InversionLength.exists_of_inversionCount_length G.rootBase
            (RootPairing.weylGroup.ofIdx G.rootSystem i.val)
        refine ⟨l, [], List.nil_sublist _, hprod, rfl, ?_, ?_⟩
        · rw [hprod, hlen]
        · simp only [simpleWeylWord, rootInversionCount_one, List.length_nil]
      · rw [schubertCell_points_range, mem_schubertOrbit_iff,
          G.weylPoint_eq, weylElementPoint_one, doubleCoset_one]
        exact hg
    · apply Set.mem_iUnion₂.mpr
      refine ⟨_, WeylBruhatLE.refl G.rootBase _, ?_⟩
      rw [schubertCell_points_range, mem_schubertOrbit_iff, simple_doubleCoset]
      exact hg

private theorem simple_point_fibre (i : G.rootBase.support) (q : (flagVariety G).points) :
    q ∈ Set.range (Variety.mapPoints
      (schubertInclusion G (RootPairing.weylGroup.ofIdx G.rootSystem i.val))) ↔
      Variety.mapPoints (partialFlagMorphism G {i}) q =
        Variety.mapPoints (partialFlagMorphism G {i}) (baseFlagPoint G) := by
  obtain ⟨p, rfl⟩ := (flagVarietyPointsEquiv G).surjective q
  obtain ⟨g, rfl⟩ := flagProjection_surjective G p
  rw [simple_schubert, partialFlagMorphism_points]
  change _ ↔ _ = Variety.mapPoints (partialFlagMorphism G {i})
    (flagVarietyPointsEquiv G (flagProjection G 1))
  rw [partialFlagMorphism_points, (partialFlagPointsEquiv G {i}).injective.eq_iff,
    eq_comm, partialFlagProjection_eq]
  simp only [inv_one, one_mul]

omit [IsAlgClosed K] [CharZero K] in
private theorem point_range (X : Variety K) (p : X.points) :
    Set.range p.val = {X.pointMap p} := by
  ext x
  constructor
  · rintro ⟨t, rfl⟩
    exact Set.mem_singleton_iff.mpr (congrArg p.val (Subsingleton.elim _ _))
  · intro hx
    exact ⟨IsLocalRing.closedPoint K, Set.mem_singleton_iff.mp hx |>.symm⟩

omit [CharZero K] in
private theorem closed_eq_of_points (X : GroupActions.Variety K) (S T : Set X.scheme)
    (hS : IsClosed S) (hT : IsClosed T) (h : X.pointMap ⁻¹' S = X.pointMap ⁻¹' T) :
    S = T := by
  have : JacobsonSpace X.scheme := LocallyOfFiniteType.jacobsonSpace X.toSpec
  have he : S ∩ closedPoints X.scheme = T ∩ closedPoints X.scheme := by
    rw [← X.pointMap_range, ← Set.image_preimage_eq_inter_range,
      ← Set.image_preimage_eq_inter_range, h]
  exact (closure_inter_closedPoints hS).symm.trans
    ((congrArg closure he).trans (closure_inter_closedPoints hT))

private theorem simple_scheme_fibre (i : G.rootBase.support) :
    (partialFlagMorphism G {i}).left ⁻¹'
        Set.range ((baseFlagPoint G).val ≫ (partialFlagMorphism G {i}).left) =
      Set.range (schubertInclusion G
        (RootPairing.weylGroup.ofIdx G.rootSystem i.val)).left := by
  let p : (partialFlagVariety G {i}).points :=
    Variety.mapPoints (partialFlagMorphism G {i}) (baseFlagPoint G)
  have hr : Set.range ((baseFlagPoint G).val ≫ (partialFlagMorphism G {i}).left) =
      {(partialFlagVariety G {i}).pointMap p} := point_range _ p
  apply closed_eq_of_points (flagVariety G)
  · rw [hr]
    exact ((partialFlagVariety G {i}).pointsEquivClosedPoints p).property.preimage
      (partialFlagMorphism G {i}).left.continuous
  · exact (schubertInclusion G
      (RootPairing.weylGroup.ofIdx G.rootSystem i.val)).left.isClosedMap.isClosed_range
  · rw [hr, ← Variety.range_mapPoints]
    ext q
    change (partialFlagMorphism G {i}).left ((flagVariety G).pointMap q) =
      (partialFlagVariety G {i}).pointMap p ↔ _
    rw [← Variety.pointMap_mapPoints,
      (partialFlagVariety G {i}).pointMap_injective.eq_iff]
    exact (simple_point_fibre G i q).symm

private def reducedRangeIso {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z)
    [IsPreimmersion f] [IsPreimmersion g] [IsReduced X] [IsReduced Y]
    (h : Set.range f = Set.range g) : X ≅ Y where
  hom := liftPreimmersion g f h.le
  inv := liftPreimmersion f g h.ge
  hom_inv_id := (cancel_mono f).mp (by
    simp only [Category.assoc, liftPreimmersion_fac, Category.id_comp])
  inv_hom_id := (cancel_mono g).mp (by
    simp only [Category.assoc, liftPreimmersion_fac, Category.id_comp])

/-- A simple Schubert variety is the base fibre of its standard partial flag projection. -/
theorem simpleSchubert_fibre (i : G.rootBase.support) :
    ∃ e : (schubertVariety G (RootPairing.weylGroup.ofIdx G.rootSystem i.val)).scheme ≅
        pullback (partialFlagMorphism G {i}).left
          ((baseFlagPoint G).val ≫ (partialFlagMorphism G {i}).left),
      e.hom ≫ pullback.fst (partialFlagMorphism G {i}).left
        ((baseFlagPoint G).val ≫ (partialFlagMorphism G {i}).left) =
          (schubertInclusion G (RootPairing.weylGroup.ofIdx G.rootSystem i.val)).left := by
  let p : (flagVariety G).scheme ⟶ (partialFlagVariety G {i}).scheme :=
    (partialFlagMorphism G {i}).left
  let b : Spec (CommRingCat.of K) ⟶ (partialFlagVariety G {i}).scheme :=
    (baseFlagPoint G).val ≫ p
  let f : (schubertVariety G
      (RootPairing.weylGroup.ofIdx G.rootSystem i.val)).scheme ⟶ (flagVariety G).scheme :=
    (schubertInclusion G (RootPairing.weylGroup.ofIdx G.rootSystem i.val)).left
  have : Smooth p := partialFlagMorphism_smooth G {i}
  have hb : b ≫ (partialFlagVariety G {i}).toSpec = 𝟙 _ := by
    have hp : p ≫ (partialFlagVariety G {i}).toSpec = (flagVariety G).toSpec :=
      (partialFlagMorphism G {i}).w
    change ((baseFlagPoint G).val ≫ p) ≫ _ = _
    rw [Category.assoc, hp, (baseFlagPoint G).property]
  have : IsClosedImmersion b :=
    isClosedImmersion_of_comp_eq_id (partialFlagVariety G {i}).toSpec b hb
  have : IsReduced (pullback p b) := inferInstance
  have hr : Set.range f = Set.range (pullback.fst p b) :=
    (simple_scheme_fibre G i).symm.trans (Scheme.Pullback.range_fst p b).symm
  refine ⟨reducedRangeIso f (pullback.fst p b) hr, ?_⟩
  exact liftPreimmersion_fac (pullback.fst p b) f hr.le

end SchubertGeometry
